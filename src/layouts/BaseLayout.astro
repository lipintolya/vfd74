---
import '../styles/global.css'
import Header from '../components/layout/Header.vue'
import Footer from '../components/layout/Footer.vue'
import YandexMetrika from '../components/analytics/YandexMetrika.astro'
import BackToTop from '../components/ui/BackToTop.astro'

interface Props {
  title?:         string
  description?:   string
  ogImage?:       string
  noIndex?:       boolean
  canonical?:     string
  structuredData?: Record<string, unknown> | Record<string, unknown>[]
  preloadHero?:   boolean
  preloadImage?:  string
}

const {
  title        = 'Двери ВФД на Кашириных — Салон дверей в Челябинске',
  description  = 'Фирменный салон дверей и алюминиевых перегородок на Братьев Кашириных 131Б. Работаем с 2014 года.',
  ogImage      = 'https://storage.yandexcloud.net/catalog-vfd/renders/hero-cover.webp',
  noIndex      = false,
  canonical,
  structuredData,
  preloadHero  = false,
  preloadImage,
} = Astro.props

const effectiveCanonical = canonical ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined)
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : null
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    {noIndex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}

    <meta property="og:title"        content={title} />
    <meta property="og:description"  content={description} />
    <meta property="og:image"        content={ogImage} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type"         content="website" />
    <meta property="og:locale"       content="ru_RU" />
    <meta property="og:site_name"    content="Салон дверей ВФД" />
    <meta name="theme-color"         content="#f8f9fa" />

    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    {effectiveCanonical && <meta property="og:url" content={effectiveCanonical} />}
    {effectiveCanonical && <link rel="canonical" href={effectiveCanonical} />}

    <title>{title}</title>

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon"  href="/favicons/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180"    href="/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/favicons/site.webmanifest" />
    <meta name="theme-color" content="#212124" />

    <!-- Имя сайта для системных поверхностей (шаринг, «Добавить на экран/в Dock»,
         закреплённые вкладки) — без этих тегов iOS/macOS/Windows показывают
         голый домен вместо бренда. -->
    <meta name="apple-mobile-web-app-title" content="ВФД на Кашириных" />
    <meta name="application-name"           content="ВФД на Кашириных" />

    <YandexMetrika />

    <link rel="preconnect" href="https://storage.yandexcloud.net" />
    <link rel="dns-prefetch" href="https://storage.yandexcloud.net" />

    <link rel="preload" as="font" type="font/woff2" href="/fonts/onest-cyrillic-wght-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/onest-latin-wght-normal.woff2" crossorigin />

    {preloadHero && (
      <link
        rel="preload" as="image"
        href="https://storage.yandexcloud.net/catalog-vfd/renders/hero-cover.webp"
        fetchpriority="high"
      />
    )}
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}
    {structuredDataJson && (
      <script type="application/ld+json" is:inline set:html={structuredDataJson} />
    )}
  </head>

  <body class="min-h-screen flex flex-col">

    <!-- Header: только клиент, без hydration mismatch -->
    <Header client:only="vue" />

    <main
      id="main-content"
      class="flex-1 relative overflow-x-hidden"
      style="padding-top: var(--header-height, 88px)"
    >
      <slot />
    </main>

    <!-- Footer: модальное окно требует Vue -->
    <Footer client:only="vue" />

    <BackToTop />

    <!-- Баннер согласия с обработкой данных (ФЗ-152) -->
    <div id="cookie-banner" style="display:none;position:fixed;bottom:1rem;left:1rem;right:1rem;z-index:9999;max-width:26rem;">
      <div style="background:#ffffff;border:1px solid #e2e8f0;border-radius:1.125rem;padding:1rem 1.125rem;display:flex;align-items:center;gap:0.875rem;box-shadow:0 12px 32px rgba(15,23,42,0.12),0 2px 8px rgba(15,23,42,0.06);flex-wrap:wrap;">
        <!-- иконка -->
        <div style="flex-shrink:0;width:2.25rem;height:2.25rem;background:#f0fdfa;border-radius:0.625rem;display:flex;align-items:center;justify-content:center;font-size:1.125rem;">
          🍪
        </div>
        <!-- текст -->
        <p style="margin:0;color:#64748b;font-size:0.8125rem;line-height:1.5;flex:1;min-width:140px;">
          Используем cookie для удобной работы сайта. <a href="/privacy/" style="color:#0d9488;text-decoration:none;font-weight:600;">Подробнее</a>
        </p>
        <!-- кнопка -->
        <button id="cookie-accept" style="flex-shrink:0;padding:0.5rem 1.25rem;background:#14b8a6;color:#fff;border:none;border-radius:9999px;font-size:0.8125rem;font-weight:600;cursor:pointer;white-space:nowrap;transition:background .15s;">
          Хорошо
        </button>
      </div>
    </div>

    <script is:inline>
      (function() {
        var banner = document.getElementById('cookie-banner');
        if (!localStorage.getItem('cookie-consent') && banner) {
          banner.style.display = 'block';
        }
        var btn = document.getElementById('cookie-accept');
        if (btn) {
          btn.addEventListener('click', function() {
            localStorage.setItem('cookie-consent', '1');
            var banner = document.getElementById('cookie-banner');
            if (banner) {
              banner.style.transition = 'opacity .25s, transform .25s';
              banner.style.opacity = '0';
              banner.style.transform = 'translateY(1rem)';
              setTimeout(function() { banner.style.display = 'none'; }, 260);
            }
          });
          btn.addEventListener('mouseenter', function() { btn.style.background = '#0d9488'; });
          btn.addEventListener('mouseleave', function() { btn.style.background = '#14b8a6'; });
        }
      })();
    </script>

  </body>
</html>
