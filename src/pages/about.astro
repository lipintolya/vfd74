---
import BaseLayout from '../layouts/BaseLayout.astro'
import AboutSection from '../components/about/AboutSection.vue'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
import { companyLegalInfo } from '../lib/contacts-data'

const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'О нас' },
]


const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'Store',  
  name: 'Салон дверей ВФД',
  description:
    'Фирменный салон входных и межкомнатных дверей, алюминиевых перегородок в Челябинске. Работаем с 2014 года. Официальный дилер одного из ведущих производителей дверей в России.',
  url: 'https://vfd74.ru',
  telephone: ['+79000297888', '+79630807888'],
  email: 'vfddoors74@mail.ru',
  
  
  sameAs: [
    'https://vk.com/vfddoors74',        
    'https://t.me/vfddoors74',
    'https://max.ru/id452402308842_biz',         
    'https://2gis.ru/chelyabinsk/firm/70000001093506304',
    'https://yandex.ru/maps/-/CPwenX08',
  ],
  
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'ул. Братьев Кашириных, 131Б',
    addressLocality: 'Челябинск',
    postalCode: '454128',
    addressCountry: 'RU',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 55.172825,   
    longitude: 61.306669,
  },
  openingHoursSpecification: companyLegalInfo.schemaOrgHours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    ...h,
  })),
  foundingDate: '2014',
  priceRange: '₽₽',
  

  acceptsPaymentMethod: ['Cash', 'CreditCard', 'DebitCard'],
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, Astro.site!).href } : {}),
  })),
}
---

<BaseLayout
  title="О нас — Салон дверей ВФД в Челябинске"
  description="Салон дверей ВФД работает в Челябинске с 2014 года. Официальный дилер межкомнатных и входных дверей. Адрес: ул. Братьев Кашириных, 131Б. Реквизиты, оплата, руководство."
  structuredData={[localBusinessSchema, breadcrumbSchema]}
>
  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>
  <AboutSection client:visible />
</BaseLayout>