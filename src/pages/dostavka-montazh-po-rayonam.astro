---
/**
 * src/pages/dostavka-montazh-po-rayonam.astro
 * Гео-SEO лендинг: замер/доставка/монтаж дверей по районам Челябинска.
 * Одна страница на все 7 районов (не отдельный лендинг на район) —
 * реальные портфолио-кейсы у нас пока только в 3 из 7 (Калининский,
 * Курчатовский, Центральный), плодить тонкие страницы без содержания
 * под остальные 4 — риск для SEO, а не польза. Единая страница честно
 * закрывает гео-запросы («двери с установкой <район> Челябинск») и
 * показывает кейсы там, где они реально есть.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
import SectionHeading from '../components/partitions/SectionHeading.astro'
import { companyLegalInfo } from '../lib/contacts-data'
import { PORTFOLIO_WORKS } from '../data/portfolio-works'

const title       = 'Двери с замером и монтажом по районам Челябинска | ВФД'
const description = 'Продажа, доставка и монтаж межкомнатных дверей ВФД во всех районах Челябинска — Калининский, Курчатовский, Центральный, Советский, Ленинский, Тракторозаводский, Металлургический. Бесплатный замер, монтаж своей бригадой.'
const canonicalUrl = Astro.site ? new URL('/dostavka-montazh-po-rayonam/', Astro.site).href : undefined

const phones = companyLegalInfo.contacts.phone
const hours  = companyLegalInfo.workingHours

const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'Доставка и монтаж по районам' },
]

/* Реальные районы Челябинска — все 7, салон обслуживает весь город.
   caseCount берётся из PORTFOLIO_WORKS ниже (не хардкод), чтобы не
   разъехаться с реальными данными при добавлении новых работ. */
const DISTRICTS = [
  { name: 'Калининский',      note: 'Здесь расположен наш салон (мкр. Академ Ривер Сайд) — минимальное время выезда на замер.' },
  { name: 'Курчатовский',     note: '' },
  { name: 'Центральный',      note: '' },
  { name: 'Советский',        note: '' },
  { name: 'Ленинский',        note: '' },
  { name: 'Тракторозаводский', note: '' },
  { name: 'Металлургический', note: '' },
] as const

const caseworks = PORTFOLIO_WORKS
  .filter(w => DISTRICTS.some(d => w.location.toLowerCase().includes(`${d.name.toLowerCase()} район`)))
  .slice(0, 6)

const structuredData = canonicalUrl ? [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href ? new URL(item.href, canonicalUrl).href : canonicalUrl,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Замер, доставка и монтаж межкомнатных дверей',
    provider: { '@type': 'Organization', name: 'Салон дверей ВФД' },
    areaServed: DISTRICTS.map(d => ({ '@type': 'AdministrativeArea', name: `${d.name} район, Челябинск` })),
  },
] : undefined
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  structuredData={structuredData}
>

  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <!-- HERO -->
  <section class="section bg-white">
    <div class="container">
      <p class="t-eyebrow block mb-3">Замер · Доставка · Монтаж</p>
      <h1 class="t-h1 mb-5 max-w-3xl">Двери с монтажом во всех районах Челябинска</h1>
      <p class="m-0 mb-6 max-w-2xl t-lead text-slate-600">
        Выезжаем на бесплатный замер и монтируем двери собственной бригадой в любом районе
        Челябинска — от Калининского, где расположен наш салон, до Тракторозаводского и
        Металлургического на другом конце города. Доставка по городу — фиксированная
        стоимость {companyLegalInfo.additional.free_measurement ? '1000 ₽' : ''}, за город — по километражу.
      </p>
      <div class="flex gap-2.5 flex-wrap">
        <a href="/contacts/" class="btn btn-primary">Записаться на бесплатный замер</a>
        <a href="/catalog/" class="btn btn-outline">Смотреть каталог дверей</a>
      </div>
    </div>
  </section>

  <!-- РАЙОНЫ -->
  <section class="section bg-slate-50">
    <div class="container">
      <SectionHeading eyebrow="География" title="Работаем во всех районах города" />
      <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
        {DISTRICTS.map(d => (
          <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <h3 class="mb-1.5 text-base font-semibold text-ink">{d.name} район</h3>
            <p class="m-0 text-sm leading-relaxed text-slate-600">
              {d.note || 'Замер, доставка и монтаж дверей ВФД — как и в остальном городе.'}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- УСЛОВИЯ -->
  <section class="section bg-white">
    <div class="container">
      <SectionHeading
        eyebrow="Условия"
        title="Сколько стоит доставка и сколько занимает монтаж"
        subtitle="Изготовление и доставка двери с завода занимает 6–8 недель — это срок работы самой фабрики, не наш. Монтаж бригада проводит за 1 день на стандартный объём заказа."
      />
      <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-3">
        <div class="rounded-2xl bg-graphite p-[clamp(1.5rem,3vw,2rem)] text-white">
          <span class="block text-3xl font-medium leading-none sm:text-4xl">1000 ₽</span>
          <span class="mt-2 block text-sm font-semibold leading-snug">Доставка по Челябинску</span>
          <span class="mt-1 block text-xs leading-snug text-white/65">Фиксированная стоимость в любой район города</span>
        </div>
        <div class="rounded-2xl bg-graphite p-[clamp(1.5rem,3vw,2rem)] text-white">
          <span class="block text-3xl font-medium leading-none sm:text-4xl">+45 ₽/км</span>
          <span class="mt-2 block text-sm font-semibold leading-snug">За город</span>
          <span class="mt-1 block text-xs leading-snug text-white/65">1000 ₽ + 45 ₽ за каждый км за пределами Челябинска</span>
        </div>
        <div class="rounded-2xl bg-graphite p-[clamp(1.5rem,3vw,2rem)] text-white">
          <span class="block text-3xl font-medium leading-none sm:text-4xl">6–8 нед.</span>
          <span class="mt-2 block text-sm font-semibold leading-snug">Изготовление и доставка</span>
          <span class="mt-1 block text-xs leading-snug text-white/65">С завода до нашего склада в Челябинске</span>
        </div>
      </div>
    </div>
  </section>

  <!-- КЕЙСЫ ПО РАЙОНАМ -->
  {caseworks.length > 0 && (
    <section class="section bg-slate-50">
      <div class="container">
        <SectionHeading eyebrow="Наши работы" title="Реальные проекты в разных районах города" />
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {caseworks.map(w => (
            <a
              href={`/portfolio/${w.id}/`}
              class="group overflow-hidden rounded-2xl border border-slate-200 bg-white transition-shadow duration-300 hover:shadow-lg hover:shadow-slate-200/60"
            >
              <div class="aspect-4/3 w-full overflow-hidden bg-slate-100">
                <img
                  src={w.images[0]}
                  alt={w.title}
                  loading="lazy"
                  decoding="async"
                  width="480"
                  height="360"
                  class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                />
              </div>
              <div class="p-4">
                <p class="m-0 mb-1 text-xs font-semibold text-teal-600">{w.location.replace('Челябинск, ', '')}</p>
                <h3 class="m-0 text-sm font-semibold leading-snug text-ink">{w.title}</h3>
              </div>
            </a>
          ))}
        </div>
        <div class="mt-6 text-center">
          <a href="/portfolio/" class="inline-flex items-center gap-1 text-sm font-semibold text-teal-600 hover:text-teal-700">
            Все работы
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- КОНТАКТЫ / CTA -->
  <section class="section bg-white">
    <div class="container">
      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-[clamp(1.5rem,4vw,3rem)]">
        <p class="t-eyebrow block mb-3">Салон в Челябинске</p>
        <h2 class="t-h2 mb-3">Приезжайте в салон или вызовите замерщика на дом</h2>
        <p class="m-0 mb-6 max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base">
          Салон расположен в Калининском районе, но замерщик выезжает в любую точку Челябинска
          и области.
        </p>

        <div class="mb-6 flex flex-col gap-2 text-sm text-slate-600 sm:text-base">
          <p class="m-0"><strong class="font-medium text-ink">Адрес:</strong> {companyLegalInfo.address.legal}</p>
          <p class="m-0">
            <strong class="font-medium text-ink">Телефон:</strong>{' '}
            {phones.map((p, i) => (
              <>
                {i > 0 && ', '}
                <a href={`tel:${p.raw}`} class="text-teal-700 hover:text-teal-800">{p.label}</a>
              </>
            ))}
          </p>
          <p class="m-0"><strong class="font-medium text-ink">Часы работы:</strong> {hours.weekdays.label}, Сб–Вс: {hours.saturday.opens}–{hours.saturday.closes}</p>
        </div>

        <div class="flex gap-2.5 flex-wrap">
          <a href="https://yandex.ru/maps/-/CPTwZPi-" target="_blank" rel="noopener noreferrer" class="btn btn-outline">Построить маршрут</a>
          <a href="/contacts/" class="btn btn-primary">Записаться на бесплатный замер</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
