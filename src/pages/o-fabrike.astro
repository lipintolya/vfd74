---
/**
 * src/pages/o-fabrike.astro
 * Имиджевый SEO-лендинг про завод-производитель (Владимирская фабрика
 * дверей) — не путать с /about/ (про салон ВФД в Челябинске: адрес,
 * реквизиты, руководство). Факты о заводе (год основания, площадь,
 * штат, сеть дилеров) — с официального сайта vfd.ru/about. Страница
 * говорит о фабрике в третьем лице ("фабрика", "завод"), а не "мы" —
 * vfd74.ru является официальным дилером, не самим производителем.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
import SectionHeading from '../components/partitions/SectionHeading.astro'
import FaqAccordion from '../components/ui/FaqAccordion.astro'

const title       = 'О фабрике ВФД — производитель межкомнатных дверей | Челябинск'
const description = 'Владимирская фабрика дверей — один из крупнейших производителей межкомнатных дверей в России: 32 000 м² производства, 850 сотрудников, 1200+ моделей. Официальный дилер в Челябинске — салон на Братьев Кашириных.'
const canonicalUrl = Astro.site ? new URL('/o-fabrike/', Astro.site).href : undefined

const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'О фабрике' },
]

const factoryStats = [
  { val: '2002',   lbl: 'год основания',        desc: 'Начинали с небольшого столярного производства' },
  { val: '32 000', lbl: 'м² производства',       desc: 'Собственные производственные площади' },
  { val: '850+',   lbl: 'сотрудников',           desc: 'Специалисты деревообработки и контроля качества' },
  { val: '1200+',  lbl: 'моделей в каталоге',    desc: 'Постоянно обновляемый модельный ряд' },
]

const scaleStats = [
  { val: '2000+', lbl: 'точек продаж', desc: 'Дилерская сеть по всей России' },
  { val: '10',    lbl: 'региональных складов', desc: 'Быстрая логистика в удалённые регионы' },
  { val: '10',    lbl: 'стран поставки', desc: 'Продукция фабрики представлена и за пределами России' },
]

const productionFeatures = [
  {
    title: 'Автоматизированное оборудование',
    text: 'Производственные линии на современном оборудовании немецких и итальянских брендов — точность геометрии полотна и стабильное качество от партии к партии.',
  },
  {
    title: 'Собственное стекольное производство',
    text: 'Фабрика самостоятельно обрабатывает стекло для остеклённых моделей — это независимость от внешних поставщиков и больше свободы в дизайне дверей со стеклом.',
  },
  {
    title: 'Контроль качества на каждом этапе',
    text: 'Отдельная команда следит за соответствием материалов и готовых полотен стандартам фабрики — от входного контроля сырья до финальной проверки перед отгрузкой.',
  },
  {
    title: 'Постоянная разработка новых покрытий',
    text: 'Собственный R&D-отдел тестирует новые материалы и текстуры — так в модельном ряду появляются актуальные покрытия вроде Эмалекс и Протач.',
  },
]

const faq = [
  {
    q: 'ВФД в Челябинске — это сам завод или дилер?',
    a: 'Салон на Братьев Кашириных, 131Б — официальный дилер Владимирской фабрики дверей в Челябинске, не производственная площадка. Само производство находится во Владимире; в Челябинске работает шоурум с выставочными образцами, консультацией, замером и монтажом.',
  },
  {
    q: 'Где производятся двери ВФД?',
    a: 'На собственных производственных мощностях Владимирской фабрики дверей — предприятие работает с 2002 года и занимает около 32 000 м².',
  },
  {
    q: 'Почему у фабрики такой большой модельный ряд?',
    a: 'Фабрика с 2002 года постоянно расширяет линейку — сейчас в каталоге более 1200 моделей разных серий, покрытий и ценовых сегментов, от бюджетных до премиальных.',
  },
  {
    q: 'Можно ли посмотреть двери фабрики вживую в Челябинске?',
    a: 'Да, в салоне на Братьев Кашириных, 131Б выставлены реальные образцы моделей и покрытий — приезжайте сравнить материалы и оттенки вживую, без заказа наугад по фото.',
  },
  {
    q: 'Чем отличается покупка у дилера от покупки напрямую с завода?',
    a: 'Дилер в Челябинске — это возможность увидеть и потрогать двери перед покупкой, получить консультацию, бесплатный замер и монтаж на месте, без необходимости взаимодействовать с заводом напрямую или ждать доставку из другого региона дольше обычного.',
  },
]

const structuredData = canonicalUrl ? [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href ? new URL(item.href, canonicalUrl).href : canonicalUrl,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Владимирская фабрика дверей',
    foundingDate: '2002',
    description: 'Производитель межкомнатных дверей — 32 000 м² производственных площадей, более 1200 моделей, дилерская сеть свыше 2000 точек продаж в России и за рубежом.',
  },
] : undefined
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  structuredData={structuredData}
>

  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       HERO
  ══════════════════════════════════════════════ -->
  <section class="section bg-white">
    <div class="container">
      <div class="max-w-3xl">
        <p class="t-eyebrow block mb-3">Производитель · Владимирская фабрика дверей</p>
        <h1 class="t-h1 mb-4">Фабрика, которая делает двери ВФД</h1>
        <p class="mb-6 t-lead text-slate-600">
          Владимирская фабрика дверей работает с 2002 года и выросла из небольшого столярного
          производства в одного из крупнейших изготовителей межкомнатных дверей в России и СНГ.
          В Челябинске продукцию фабрики представляет официальный дилер — салон на Братьев Кашириных.
        </p>
        <div class="flex gap-2.5 flex-wrap">
          <a href="/catalog/" class="btn btn-primary">Смотреть каталог дверей</a>
          <a href="/contacts/" class="btn btn-outline">Адрес салона в Челябинске</a>
        </div>
      </div>

      <div class="mt-12 lg:mt-16 grid grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-6 lg:gap-x-12">
        {factoryStats.map((s, i) => (
          <div class:list={['flex flex-col', i > 0 && 'border-t sm:border-t lg:border-t-0 lg:border-l border-slate-200 pt-6 sm:pt-6 lg:pt-0 lg:pl-8']}>
            <span class="t-stat block">{s.val}</span>
            <span class="block text-sm font-semibold text-ink mt-1.5 leading-snug">{s.lbl}</span>
            <span class="block text-xs text-slate-500 leading-snug mt-1">{s.desc}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       ПРОИЗВОДСТВО
  ══════════════════════════════════════════════ -->
  <section class="section bg-slate-50">
    <div class="container">
      <SectionHeading
        eyebrow="Производство"
        title="Как фабрика делает двери"
        subtitle="Полный цикл — от обработки материала до готового полотна — на собственных производственных мощностях."
      />
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 lg:gap-5">
        {productionFeatures.map(f => (
          <article class="rounded-2xl border border-slate-200 bg-white p-[clamp(1.25rem,2.5vw,1.75rem)]">
            <h3 class="mb-2 text-step-2 font-medium text-ink">{f.title}</h3>
            <p class="m-0 text-sm leading-relaxed text-slate-600">{f.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       МАСШТАБ
  ══════════════════════════════════════════════ -->
  <section class="section bg-white">
    <div class="container">
      <SectionHeading
        eyebrow="Масштаб"
        title="От небольшого цеха до федеральной сети"
        subtitle="Фабрика поставляет двери дилерам по всей России и за её пределами."
      />
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 lg:gap-5">
        {scaleStats.map(s => (
          <div class="rounded-2xl bg-graphite p-[clamp(1.5rem,3vw,2rem)] text-white">
            <span class="block text-3xl font-medium leading-none sm:text-4xl">{s.val}</span>
            <span class="mt-2 block text-sm font-semibold leading-snug">{s.lbl}</span>
            <span class="mt-1 block text-xs leading-snug text-white/65">{s.desc}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       МОСТИК К ДИЛЕРУ В ЧЕЛЯБИНСКЕ
  ══════════════════════════════════════════════ -->
  <section class="section bg-slate-50">
    <div class="container">
      <div class="rounded-3xl border border-slate-200 bg-white p-[clamp(1.5rem,4vw,3rem)]">
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-6 lg:gap-10 items-center">
          <div>
            <p class="t-eyebrow block mb-3">В Челябинске</p>
            <h2 class="t-h2 mb-3">Официальный дилер фабрики — салон на Братьев Кашириных</h2>
            <p class="m-0 text-sm leading-relaxed text-slate-600 sm:text-base">
              Смотрите модели и покрытия фабрики вживую, получите бесплатный замер и монтаж
              собственной бригадой — без необходимости заказывать напрямую с завода.
            </p>
          </div>
          <div class="flex gap-2.5 flex-wrap lg:flex-nowrap">
            <a href="/catalog/" class="btn btn-primary shrink-0">Смотреть каталог</a>
            <a href="/contacts/" class="btn btn-outline shrink-0">Контакты и адрес</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bg-white">
    <div class="container">
      <FaqAccordion items={faq} />
    </div>
  </section>

</BaseLayout>
