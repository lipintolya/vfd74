---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PortfolioGrid from '../../components/portfolio/PortfolioGrid.vue'
import { PORTFOLIO_WORKS } from '../../data/portfolio-works'

const works = [...PORTFOLIO_WORKS].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
)

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://vfd74.ru' },
    { '@type': 'ListItem', position: 2, name: 'Наши работы', item: 'https://vfd74.ru/portfolio/' },
  ],
}
---

<BaseLayout
  title="Наши работы — фотоотчёты монтажей дверей | ВФД Челябинск"
  description="Фотоотчёты установки межкомнатных, скрытых, входных дверей и алюминиевых перегородок — реальные объекты салона ВФД по Челябинску и области."
  structuredData={[breadcrumbSchema]}
>
  <section class="section">
    <div class="container">

      <nav aria-label="Хлебные крошки" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-slate-500">
          <li><a href="/" class="hover:text-teal-600 transition-colors">Главная</a></li>
          <li aria-hidden="true" class="text-slate-300">/</li>
          <li class="text-slate-700 font-medium">Наши работы</li>
        </ol>
      </nav>

      <header class="max-w-3xl mb-10 md:mb-12">
        <p class="t-eyebrow mb-3">
          Портфолио
        </p>
        <h1 class="text-3xl font-medium leading-tight tracking-tight text-slate-900 md:text-5xl">
          Наши работы — фотоотчёты с объектов
        </h1>
        <p class="mt-4 text-base leading-relaxed text-slate-600 md:text-lg">
          Реальные объекты наших клиентов — монтаж дверей и перегородок по Челябинску и области
        </p>
      </header>

      <PortfolioGrid works={works} client:visible />

      <!-- CTA — перелинковка на каталог по категориям, тот же ink-стиль,
           что на странице отдельной работы (portfolio/[slug].astro). -->
      <div class="mt-14 overflow-hidden rounded-2xl bg-ink p-6 sm:p-8 md:mt-16">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-lg font-semibold text-white">Понравился результат?</p>
            <p class="mt-1 max-w-md text-sm leading-relaxed text-white/60">
              Все модели, которые видите на фото, в наличии в шоуруме — выбирайте по каталогу или приезжайте посмотреть вживую.
            </p>
          </div>
          <a
            href="/catalog/"
            class="inline-flex flex-none items-center justify-center gap-2 rounded-full bg-teal-500 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-teal-400"
          >
            Смотреть каталог
            <svg viewBox="0 0 16 16" fill="none" class="h-3.5 w-3.5" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

        <ul class="mt-6 grid grid-cols-2 gap-3 border-t border-white/10 pt-6 sm:grid-cols-4" role="list">
          <li>
            <a href="/catalog/" class="flex items-center gap-2 rounded-xl px-3 py-2.5 text-sm font-medium text-white/80 transition-colors hover:bg-white/10 hover:text-white">
              <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-[oklch(50.5%_0.213_27.518)]" aria-hidden="true" />
              Межкомнатные
            </a>
          </li>
          <li>
            <a href="/catalog/skrytye-dveri/" class="flex items-center gap-2 rounded-xl px-3 py-2.5 text-sm font-medium text-white/80 transition-colors hover:bg-white/10 hover:text-white">
              <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-teal-500" aria-hidden="true" />
              Скрытые двери
            </a>
          </li>
          <li>
            <a href="/partitions/" class="flex items-center gap-2 rounded-xl px-3 py-2.5 text-sm font-medium text-white/80 transition-colors hover:bg-white/10 hover:text-white">
              <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-indigo-500" aria-hidden="true" />
              Перегородки
            </a>
          </li>
          <li>
            <a href="/vhodnye-dveri/" class="flex items-center gap-2 rounded-xl px-3 py-2.5 text-sm font-medium text-white/80 transition-colors hover:bg-white/10 hover:text-white">
              <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500" aria-hidden="true" />
              Входные двери
            </a>
          </li>
        </ul>
      </div>

    </div>
  </section>
</BaseLayout>
