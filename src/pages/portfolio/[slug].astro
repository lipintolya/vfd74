---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ProjectSlider from '../../components/portfolio/ProjectSlider.vue'
import { PORTFOLIO_WORKS, CATEGORY_LABELS, CATEGORY_BADGE_COLORS, OBJECT_TYPE_LABELS } from '../../data/portfolio-works'
import { companyLegalInfo } from '../../lib/contacts-data'

export async function getStaticPaths() {
  return PORTFOLIO_WORKS.map((work) => ({
    params: { slug: work.id },
    props:  { work },
  }))
}

const { work } = Astro.props
const canonicalUrl = `https://vfd74.ru/portfolio/${work.id}/`
const phone = companyLegalInfo.contacts.phone[0]!

const doorWord = (n: number) =>
  n === 1 ? 'дверь' : n < 5 ? 'двери' : 'дверей'

const imageGallerySchema = {
  '@context':      'https://schema.org',
  '@type':         'ImageGallery',
  name:            work.title,
  description:     work.description,
  dateCreated:     work.date,
  image:           work.images,
  contentLocation: { '@type': 'Place', name: work.location },
  author: {
    '@type': 'Organization',
    name:    'ВФД — Салон дверей в Челябинске',
    url:     'https://vfd74.ru',
  },
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type':    'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная',     item: 'https://vfd74.ru' },
    { '@type': 'ListItem', position: 2, name: 'Наши работы', item: 'https://vfd74.ru/portfolio/' },
    { '@type': 'ListItem', position: 3, name: work.title,    item: canonicalUrl },
  ],
}
---

<BaseLayout
  title={`${work.title} — ВФД Челябинск`}
  description={work.description}
  ogImage={work.images[0]}
  structuredData={[imageGallerySchema, breadcrumbSchema]}
>
  <article class="section">
    <div class="container">

      <!-- Breadcrumb -->
      <nav aria-label="Хлебные крошки" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-slate-500 flex-wrap">
          <li><a href="/" class="hover:text-teal-600 transition-colors">Главная</a></li>
          <li aria-hidden="true" class="text-slate-300">/</li>
          <li><a href="/portfolio/" class="hover:text-teal-600 transition-colors">Наши работы</a></li>
          <li aria-hidden="true" class="text-slate-300">/</li>
          <li class="text-slate-700 font-medium truncate max-w-64">{work.title}</li>
        </ol>
      </nav>

      <div class="lg:grid lg:grid-cols-[1.5fr_1fr] lg:items-start lg:gap-10 xl:gap-14">

        <!-- Photo slider -->
        <div class="lg:sticky lg:top-24">
          <ProjectSlider images={work.images} client:load />
        </div>

        <div>
          <!-- Header -->
          <header class="mt-8 mb-6 lg:mt-0">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 mb-3 text-xs font-semibold uppercase tracking-wide text-slate-400">
              <span class="inline-flex items-center gap-1.5">
                <span class:list={['h-1.5 w-1.5 rounded-full', CATEGORY_BADGE_COLORS[work.category]]} aria-hidden="true" />
                {CATEGORY_LABELS[work.category]}
              </span>
              <span class="text-slate-300" aria-hidden="true">·</span>
              <span class="normal-case tracking-normal">{OBJECT_TYPE_LABELS[work.objectType]}</span>
              <span class="text-slate-300" aria-hidden="true">·</span>
              <time datetime={work.date} class="tabular-nums normal-case tracking-normal">{work.label}</time>
            </div>
            <h1 class="text-2xl font-medium leading-tight tracking-tight text-slate-900 md:text-3xl">
              {work.title}
            </h1>
            <p class="mt-2 flex items-center gap-1.5 text-sm text-slate-500">
              <svg viewBox="0 0 24 24" fill="none" class="h-3.5 w-3.5 shrink-0" aria-hidden="true">
                <path d="M12 21s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="1.8"/>
              </svg>
              {work.location}{work.doorCount ? ` · ${work.doorCount} ${doorWord(work.doorCount)}` : ''}
            </p>
          </header>

          <!-- Story -->
          {work.story && (
            <p class="text-base leading-relaxed text-slate-700 mb-7">{work.story}</p>
          )}

          <!-- Спецификация — строки с разделителями, как в паспорте изделия,
               не суп из одинаковых серых чипов. -->
          {(work.model || (work.features && work.features.length > 0)) && (
            <ul class="pw-specs" role="list">
              {work.model && (
                <li class="pw-specs__row pw-specs__row--model">
                  <span class="pw-specs__label">Модель / серия</span>
                  <span class="pw-specs__value">{work.model}</span>
                </li>
              )}
              {work.features?.map(f => (
                <li class="pw-specs__row">{f}</li>
              ))}
            </ul>
          )}
        </div>
      </div>

        <!-- CTA — сплошная плашка ink, не пастельный градиент: акцент только
             на кнопке. -->
        <div class="mt-12 overflow-hidden rounded-2xl bg-ink p-6 sm:p-8">
          <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="text-lg font-semibold text-white">Хотите такой же результат?</p>
              <p class="mt-1 text-sm leading-relaxed text-white/60 max-w-md">
                Бесплатно приедем на замер, точно рассчитаем стоимость и подберём модель под ваш интерьер.
              </p>
            </div>
            <div class="flex flex-col gap-3 sm:flex-none sm:flex-row">
              <a
                href={`tel:${phone.raw}`}
                class="inline-flex items-center justify-center gap-2 rounded-full bg-teal-500 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-teal-400"
              >
                {phone.label}
              </a>
              <a
                href="https://t.me/vfddoors74"
                target="_blank"
                rel="noopener"
                class="inline-flex items-center justify-center gap-2 rounded-full border-[1.5px] border-white/20 px-6 py-3 text-sm font-semibold text-white transition-colors hover:border-white/50"
              >
                Написать в Telegram
              </a>
            </div>
          </div>
          <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 border-t border-white/10 pt-5 text-xs font-semibold text-white/70">
            <span class="inline-flex items-center gap-1.5">
              <svg viewBox="0 0 16 16" fill="none" class="h-3.5 w-3.5 text-teal-400" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Бесплатный выезд замерщика
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg viewBox="0 0 16 16" fill="none" class="h-3.5 w-3.5 text-teal-400" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Гарантия на монтаж
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg viewBox="0 0 16 16" fill="none" class="h-3.5 w-3.5 text-teal-400" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Работаем по Челябинску и области
            </span>
          </div>
        </div>

        <!-- Back link -->
        <div class="mt-8">
          <a href="/portfolio/" class="inline-flex items-center gap-2 text-sm font-semibold text-teal-600 hover:text-teal-700 transition-colors">
            <svg viewBox="0 0 16 16" fill="none" class="w-4 h-4" aria-hidden="true">
              <path d="M13 8H3M7 4l-4 4 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Все работы
          </a>
        </div>

    </div>
  </article>
</BaseLayout>

<style>
  .pw-specs {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }
  .pw-specs__row {
    padding: 0.75rem 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-body);
    border-bottom: 1px solid var(--color-border);
  }
  .pw-specs__row--model {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .pw-specs__label {
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-fg-subtle);
  }
  .pw-specs__value {
    font-weight: 600;
    color: var(--color-ink);
    text-align: right;
  }
</style>
