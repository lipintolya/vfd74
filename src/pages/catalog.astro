---
/**
 * src/pages/catalog.astro
 * Данные грузятся на сервере — полный JOIN через Supabase (src/lib/catalog-data.ts).
 * Фильтрация — клиентская (Vue island), без перезагрузки страницы.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
import SectionNav from '../components/partitions/SectionNav.astro'
import CatalogClient from '../components/catalog/CatalogClient.vue'
import SeriesCard from '../components/catalog/SeriesCard.astro'
import FaqAccordion from '../components/ui/FaqAccordion.astro'
import { getCatalogCards, getSeriesCardsData } from '../lib/catalog-data'
import { getSeriesSpec, coatingGroupCopy } from '../data/series-descriptions'
import { DOOR_CATEGORIES } from '../data/door-categories'
import { COLOR_CATEGORIES } from '../data/color-categories'
import { STYLE_CATEGORIES } from '../data/style-categories'

const { cards, error } = await getCatalogCards()
const seriesCardsData = getSeriesCardsData(cards)

/* ── Превью серий сверху каталога — группировка по покрытию, как в
   фильтре ниже: Эмалекс / Эмаль / Протач / ПЭТ. Порядок фиксирован для
   известных покрытий, всё остальное — следом по алфавиту, чтобы новая
   группа (напр. будущее покрытие) не потерялась молча. ── */
const COATING_ORDER = ['emalex', 'emal', 'protach', 'pet']

/* coatingSlug → слаг SEO-лендинга покрытия (/catalog/<slug>), см.
   src/data/door-categories.ts — единый источник, не дублируем маппинг. */
const COATING_LANDING_SLUG = Object.fromEntries(
  DOOR_CATEGORIES.map(c => [c.coatingSlug, c.slug])
) as Record<string, string>


/* Мягкий цветовой акцент группы по покрытию — та же логика, что и бейджи
   цвета серии на карточках товара (CatalogProductCard.vue): каждое
   покрытие получает свой оттенок, чтобы группы отличались с первого
   взгляда, а не только текстом заголовка. */
const COATING_ACCENT: Record<string, { panel: string; card: string; label: string; dot: string; price: string }> = {
  emalex:  { panel: 'border-blue-200 bg-blue-50/50',       card: 'border-blue-200 bg-blue-100/70',       label: 'text-blue-700',    dot: 'bg-blue-500',    price: 'text-blue-900/70' },
  pet:     { panel: 'border-rose-200 bg-rose-50/50',       card: 'border-rose-200 bg-rose-100/70',       label: 'text-rose-700',    dot: 'bg-rose-500',    price: 'text-rose-900/70' },
  protach: { panel: 'border-violet-200 bg-violet-50/50',   card: 'border-violet-200 bg-violet-100/70',   label: 'text-violet-700',  dot: 'bg-violet-500',  price: 'text-violet-900/70' },
  emal:    { panel: 'border-slate-400 bg-slate-200/60',    card: 'border-slate-500 bg-slate-300/80',     label: 'text-slate-800',   dot: 'bg-slate-700',   price: 'text-slate-900' },
}
const DEFAULT_ACCENT = { panel: 'border-slate-200 bg-slate-50/60', card: 'border-slate-200 bg-white', label: 'text-slate-400', dot: 'bg-slate-400', price: 'text-slate-500' }

const seriesCoatingGroups = [...new Map(
  seriesCardsData.map(s => [s.coatingSlug, { slug: s.coatingSlug, name: s.coatingName }])
).values()]
  .sort((a, b) => {
    const ai = COATING_ORDER.indexOf(a.slug)
    const bi = COATING_ORDER.indexOf(b.slug)
    if (ai === -1 && bi === -1) return a.name.localeCompare(b.name, 'ru')
    if (ai === -1) return 1
    if (bi === -1) return -1
    return ai - bi
  })
  .map(coating => {
    const series = seriesCardsData.filter(s => s.coatingSlug === coating.slug)
    /* Копирайтинг покрытия одинаковый для всех серий внутри группы (coating/
       material в SeriesSpec завязаны на coatingSlug, не на серию) — берём
       у первой серии группы, не плодим повторный запрос/текст. Если для
       покрытия ещё нет полного текста (tagline/benefits/closing) — падаем
       на короткое derived-описание (coating+material), без остальных полей. */
    const spec = getSeriesSpec(series[0]!.slug, coating.slug)
    const copy = coatingGroupCopy[coating.slug]
    const description = copy?.description
      ?? [spec.coating, spec.material].filter(Boolean).join(' ')
    const prices = series.map(s => s.minPrice).filter((p): p is number => p != null)
    const minPrice = prices.length ? Math.min(...prices) : null
    return { ...coating, series, description, tagline: copy?.tagline ?? '', benefits: copy?.benefits ?? [], closing: copy?.closing ?? '', minPrice }
  })

const fmt = (n: number) => n.toLocaleString('ru-RU') + ' ₽'

/* ── Уникальные опции для фильтров ── */
const allSeries = [...new Map(
  cards
    .filter(c => c.seriesSlug)
    .map(c => [c.seriesSlug, { label: c.series, value: c.seriesSlug }])
).values()]

const allCoatings = [...new Map(
  cards
    .filter(c => c.coatingSlug)
    .map(c => [c.coatingSlug, { label: c.coating, value: c.coatingSlug }])
).values()]

/* Из colorSwatches (полный набор цветов на модель, не только первого) —
   свотчи уже содержат все цвета каждой модели, так что колонка не теряет
   цвета, которые ни у одной модели не оказались «первыми». available:false
   (цвет покрытия без фото под конкретную модель) сюда не попадает —
   фильтр по нему дал бы пустую выдачу. */
const allColors = [...new Map(
  cards
    .flatMap(c => c.colorSwatches.filter(s => s.available).map(s => [s.name, { label: s.name, value: s.name, color: s.hex }] as const))
).values()]

/* ── Начальные фильтры из URL ── */
const urlSeries  = Astro.url.searchParams.get('series')  ?? ''
const urlCoating = Astro.url.searchParams.get('coating') ?? ''
const urlColor   = Astro.url.searchParams.get('color')   ?? ''

const canonicalUrl = Astro.site ? new URL('/catalog/', Astro.site).href : undefined
const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'Каталог' },
]

const catalogFaq = [
  {
    q: 'Сколько стоит межкомнатная дверь с установкой?',
    a: 'Итоговая цена складывается из полотна, погонажа (короб, наличники, добор), фурнитуры и монтажа — и зависит от серии и покрытия. Цены на полотна каждой модели указаны в каталоге, а полный комплект удобно посчитать в калькуляторе на странице модели. Точный расчёт под ваш проём — бесплатно после замера.',
  },
  {
    q: 'Какое покрытие выбрать — эмаль, ПЭТ, Эмалекс или Протач?',
    a: 'Эмаль — гладкая окрашенная поверхность и широкая палитра, классика. ПЭТ — самое стойкое к царапинам и отпечаткам, выбор для семей с детьми и животными. Эмалекс — гладкое полимерное покрытие, устойчивое к влаге и царапинам, по виду близко к эмали, но практичнее по цене. Протач — плотное покрытие с текстурой, стойкое к износу. Образцы всех покрытий можно посмотреть вживую в салоне на Братьев Кашириных.',
  },
  {
    q: 'Есть ли двери в наличии в Челябинске?',
    a: 'Да, часть популярных моделей держим на складе в Челябинске — их можно забрать без ожидания производства. Наличие конкретной модели и цвета уточняйте у менеджера, актуальные складские акции публикуем на главной странице.',
  },
  {
    q: 'Вы делаете замер и установку?',
    a: 'Да. Замер по Челябинску — бесплатный при заказе дверей. Монтаж выполняет наша бригада с гарантией на работы: те же специалисты, что помогают с подбором, ведут заказ до установленной двери.',
  },
  {
    q: 'Можно ли заказать дверь нестандартного размера?',
    a: 'Да, полотна изготавливаются под заказ по нестандартной высоте и ширине. Доплаты за ширину 900 мм у ВФД нет. Возможные размеры и сроки для конкретной серии подскажет менеджер при расчёте.',
  },
  {
    q: 'Как посчитать полную стоимость комплекта?',
    a: 'На странице каждой модели есть калькулятор: выбираете цвет, короб, наличники, доборы, тип петель и замок — и сразу видите итоговую сумму комплекта. Это ориентир до замера; финальную смету составляем после бесплатного замера проёмов.',
  },
]

const structuredData = canonicalUrl ? [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href ? new URL(item.href, canonicalUrl).href : canonicalUrl,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Каталог дверей ВФД на Кашириных',
    description: 'Каталог межкомнатных и входных дверей с ценами, сериями, покрытиями и цветами.',
    url: canonicalUrl,
    numberOfItems: cards.length,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: catalogFaq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
] : undefined
---

<BaseLayout
  title="Купить межкомнатные двери в Челябинске — каталог и цены | ВФД"
  description="Межкомнатные двери в Челябинске от официального дилера ВФД: каталог с ценами, покрытия эмаль, ПЭТ, Эмалекс, Протач. Бесплатный замер, монтаж, салон на Братьев Кашириных."
  canonical={canonicalUrl}
  structuredData={structuredData}
>
  {error && (
    <div class="container pt-8">
      <div class="rounded-2xl bg-red-50 border border-red-100 px-5 py-4 text-red-700 text-sm">
        Ошибка загрузки каталога: {error}
      </div>
    </div>
  )}

  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <SectionNav items={[
    { id: 'series-title',  label: 'Серии' },
    { id: 'catalog-title', label: 'Каталог' },
  ]} />

  {seriesCoatingGroups.length > 0 && (
    <div id="series" class="section bg-white" style="padding-bottom: 0; scroll-margin-top: 5.5rem">
      <div class="container">
        <header id="series-title" class="max-w-2xl mb-8 md:mb-10" style="scroll-margin-top: 7.5rem">
          <p class="t-eyebrow mb-3">Каталог дверей ВФД</p>
          <h1 class="text-3xl font-medium leading-tight tracking-tight text-slate-900 md:text-5xl">Серии</h1>
          <p class="mt-4 text-base leading-relaxed text-slate-600 md:text-lg">
            {seriesCardsData.length} серий межкомнатных дверей, сгруппированных по покрытию — выберите материал или сразу переходите к полному каталогу моделей ниже.
          </p>
        </header>
        {seriesCoatingGroups.map((group, groupIndex) => {
          const accent = COATING_ACCENT[group.slug] ?? DEFAULT_ACCENT
          return (
          /* Вся группа (карточки + преимущества + вывод) — в едином панельном
             контейнере с рамкой/фоном: без него нижний ряд карточек серий
             визуально сливался со след. группой, а блок преимуществ читался
             как отдельная, не связанная с группой секция. Цвет панели —
             мягкий акцент по покрытию (та же палитра, что у бейджей серии
             на карточках товара), чтобы группы отличались с первого взгляда. */
          <div class={`mb-10 rounded-3xl border ${accent.panel} p-4 sm:p-6 last:mb-0`}>
            {/* Единая wrap-сетка, одинаковая колонность для всех групп — карточки
               одного размера везде. Первая ячейка — инфо-карточка покрытия
               (название/описание/цена от/CTA), дальше карточки серий — по
               референсу (коллекция слева, товары справа в одной ленте). */}
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-5">
              <div class={`col-span-2 flex h-full flex-col justify-between gap-6 rounded-2xl border p-5 sm:col-span-1 sm:p-7 ${accent.card}`}>
                <div>
                  <p class={`m-0 mb-2 flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide ${accent.label}`}>
                    <span class={`h-1.5 w-1.5 rounded-full ${accent.dot}`} aria-hidden="true"></span>
                    Покрытие
                  </p>
                  <h2 class="m-0 mb-3 text-2xl font-medium text-ink sm:text-3xl">{group.name}</h2>
                  {group.tagline && (
                    <p class="m-0 mb-2 text-sm font-semibold text-ink">{group.tagline}</p>
                  )}
                  {group.description && (
                    <p class="m-0 text-sm leading-relaxed text-slate-700">{group.description}</p>
                  )}
                </div>
                <div class="flex flex-col gap-3">
                  <p class={`m-0 text-lg font-medium sm:text-xl ${accent.price}`}>
                    {group.minPrice ? `от ${fmt(group.minPrice)}` : `${group.series.length} ${group.series.length === 1 ? 'серия' : 'серий'}`}
                    {group.minPrice && <span class="ml-1 text-xs font-semibold opacity-70">за полотно</span>}
                  </p>
                  <a
                    href={COATING_LANDING_SLUG[group.slug] ? `/catalog/${COATING_LANDING_SLUG[group.slug]}/` : `/catalog/?coating=${group.slug}#catalog-title`}
                    class="btn btn-primary w-fit"
                  >
                    Смотреть модели
                  </a>
                </div>
              </div>
              {group.series.map((s, i) => <SeriesCard series={s} priority={groupIndex === 0 && i < 2} />)}
            </div>

            {group.benefits.length > 0 && (
              <div class={`mt-6 border-t pt-6 ${accent.panel.split(' ')[0]}`}>
                <p class={`m-0 mb-4 text-xs font-semibold uppercase tracking-wide ${accent.label}`}>Почему выбирают {group.name}</p>
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-3 sm:gap-5">
                  {group.benefits.map(b => (
                    <div class="rounded-xl border border-slate-200 bg-white p-5">
                      <p class="m-0 mb-1.5 text-sm font-semibold text-ink">{b.title}</p>
                      <p class="m-0 text-sm leading-relaxed text-slate-600">{b.text}</p>
                    </div>
                  ))}
                </div>
              </div>
            )}
            {group.closing && (
              <p class="m-0 mt-5 text-sm font-medium leading-relaxed text-slate-700">{group.closing}</p>
            )}
          </div>
          )
        })}

        <div class="mt-2 mb-8 md:mb-10">
          <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-400">Двери по цвету</p>
          <ul class="flex flex-wrap gap-2.5" role="list">
            {COLOR_CATEGORIES.map(c => (
              <li>
                <a
                  href={`/catalog/${c.slug}/`}
                  class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-teal-400 hover:text-teal-700"
                >
                  {c.h1.replace(' в Челябинске', '')}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-2 mb-8 md:mb-10">
          <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-400">Двери по стилю</p>
          <ul class="flex flex-wrap gap-2.5" role="list">
            {STYLE_CATEGORIES.map(c => (
              <li>
                <a
                  href={`/catalog/${c.slug}/`}
                  class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-teal-400 hover:text-teal-700"
                >
                  {c.h1.replace(' в Челябинске', '')}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  )}

  <div class="section bg-white">
    <div class="container">
      <CatalogClient
        client:idle
        cards={cards}
        series={allSeries}
        coatings={allCoatings}
        colors={allColors}
        initialSeries={urlSeries}
        initialCoating={urlCoating}
        initialColor={urlColor}
      />
    </div>
  </div>

  <!-- FAQ (SEO — FAQPage schema + аккордеон) -->
  <section class="section">
    <div class="container">
      <FaqAccordion items={catalogFaq} />
    </div>
  </section>
</BaseLayout>
