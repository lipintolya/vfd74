---
/**
 * /catalog/ — каталог межкомнатных дверей. Сверху H1 и одна фраза с числом
 * моделей и ценой «от», сразу под ними — каталог: карточки покрытий,
 * фильтры, сетка (CatalogClient — фильтрация в браузере, без перезагрузки).
 * Ниже: другие разделы (фото-плитки, как «Каталог» на главной), покрытия
 * и серии строками, подборки, вопросы.
 *
 * Раньше над каталогом стояли раскрывающиеся панели покрытий — до первой
 * двери было ~1800 px прокрутки. Описание покрытий теперь под сеткой.
 *
 * Данные — Supabase на сборке (src/lib/catalog-data.ts), порядок покрытий —
 * COATING_ORDER (src/lib/catalog-filter.ts).
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
import SectionHeader from '../components/home/SectionHeader.astro'
import CatalogClient from '../components/catalog/CatalogClient.vue'
import PhotoTiles, { type PhotoTile } from '../components/ui/PhotoTiles.astro'
import RelatedLinks from '../components/ui/RelatedLinks.astro'
import FaqAccordion from '../components/ui/FaqAccordion.astro'
import { getCatalogCards, getSeriesCardsData } from '../lib/catalog-data'
import { sortCards, coatingRank } from '../lib/catalog-filter'
import { popularRank } from '../lib/popular-series'
import { getSeriesSpec, coatingGroupCopy } from '../data/series-descriptions'
import { DOOR_CATEGORIES } from '../data/door-categories'
import { COLOR_LINKS, STYLE_LINKS } from '../lib/site-links'
import { ENTRANCE_DOOR_MODELS, minPriceOf } from '../data/entrance-doors'
import { SECRET_MIN_BLADE_PRICE } from '../data/skrytye-dveri-products'
import { rub } from '../data/services'
import { pluralRu } from '../lib/plural'
import { typograph } from '../lib/typograph'
import { inStockCards } from '../lib/in-stock'

const { cards, error } = await getCatalogCards()
const seriesCardsData = getSeriesCardsData(cards)
const inStockCount = inStockCards(cards).length

const prices = cards.map((c) => c.price).filter((p): p is number => p != null)
const minPrice = prices.length ? Math.min(...prices) : null
const modelsCount = `${cards.length} ${pluralRu(cards.length, ['модель', 'модели', 'моделей'])}`

/* ── Покрытия и серии: группы по покрытию в порядке COATING_ORDER ── */
const firstSentence = (text: string) => text.match(/^.+?[.!?](?=\s|$)/)?.[0] ?? text
const LANDING_BY_COATING = new Map(DOOR_CATEGORIES.map((c) => [c.coatingSlug, c]))

const coatingGroups = [...new Map(seriesCardsData.map((s) => [s.coatingSlug, s.coatingName])).entries()]
  .sort(([a, an], [b, bn]) => coatingRank(a) - coatingRank(b) || an.localeCompare(bn, 'ru'))
  .map(([slug, name]) => {
    /* Серии — в порядке каталога: ведущие (Урбан, Эмалексы) первыми, дальше по цене */
    const series = seriesCardsData
      .filter((s) => s.coatingSlug === slug)
      .sort((a, b) => popularRank(a.slug) - popularRank(b.slug) || (a.minPrice ?? Infinity) - (b.minPrice ?? Infinity))
    /* Текст покрытия общий для его серий; нет полного — короткий из характеристик */
    const spec = getSeriesSpec(series[0]!.slug, slug)
    const copy = coatingGroupCopy[slug]
    const seriesPrices = series.map((s) => s.minPrice).filter((p): p is number => p != null)
    const landing = LANDING_BY_COATING.get(slug)
    return {
      slug,
      name,
      series,
      tagline: copy?.tagline ?? '',
      /* Первое предложение — полный текст на странице покрытия */
      description: firstSentence(copy?.description ?? [spec.coating, spec.material].filter(Boolean).join(' ')),
      minPrice: seriesPrices.length ? Math.min(...seriesPrices) : null,
      /* Карточка покрытия над каталогом — обложка первой серии по алфавиту
         базы, как и раньше; фото в «О покрытиях» — ведущей серии, и если она
         совпадает с карточкой, следующей: одно фото дважды на странице ни к чему */
      cover: seriesCardsData.find((s) => s.coatingSlug === slug && s.cover)?.cover ?? '',
      feature: (() => {
        const first = seriesCardsData.find((s) => s.coatingSlug === slug && s.cover)?.cover
        const pick = series.find((s) => s.cover && s.cover !== first) ?? series.find((s) => s.cover)
        return pick ? { src: pick.cover, alt: `Межкомнатная дверь серии ${pick.name} в интерьере` } : null
      })(),
      link: landing
        ? { href: `/catalog/${landing.slug}/`, label: `Все двери ${name}` }
        : { href: `/catalog/?coating=${slug}`, label: `Все двери ${name}` },
    }
  })

/* ── Варианты фильтров ── */
const uniqueBy = <T,>(items: T[], key: (item: T) => string) => [...new Map(items.map((i) => [key(i), i])).values()]
const allSeries = uniqueBy(cards.filter((c) => c.seriesSlug), (c) => c.seriesSlug).map((c) => ({ label: c.series, value: c.seriesSlug }))
const allCoatings = uniqueBy(cards.filter((c) => c.coatingSlug), (c) => c.coatingSlug).map((c) => ({ label: c.coating, value: c.coatingSlug }))
/* Карточки покрытий над каталогом: фото серии в интерьере и цена «от» */
const coatingCards = coatingGroups.map((g) => ({ value: g.slug, label: g.name, cover: g.cover, minPrice: g.minPrice }))

/* ── Другие разделы — те же фото-плитки, что «Каталог» на главной ── */
const entranceMinPrice = Math.min(...ENTRANCE_DOOR_MODELS.map(minPriceOf))
const otherSections: PhotoTile[] = [
  {
    title: 'Скрытые двери',
    fact:  `от ${rub(SECRET_MIN_BLADE_PRICE)} за полотно, заподлицо со стеной`,
    href:  '/catalog/skrytye-dveri/',
    img: {
      src:    '/renders/home/secret-cover-960.webp',
      srcset: '/renders/home/secret-cover-640.webp 640w, /renders/home/secret-cover-960.webp 960w',
      alt:    'Скрытая дверь в цвет бордовой стены гостиной',
      width: 960, height: 540,
    },
  },
  {
    title: 'Входные двери',
    fact:  `от ${rub(entranceMinPrice)} с накладкой изнутри`,
    href:  '/vhodnye-dveri/',
    img: {
      src:    '/renders/home/cat-entrance-960.webp',
      srcset: '/renders/home/cat-entrance-640.webp 640w, /renders/home/cat-entrance-960.webp 960w',
      alt:    'Стальная входная дверь «Оптима» в тёмно-сером цвете',
      width: 960, height: 1200,
    },
  },
  {
    title: 'Алюминиевые перегородки',
    fact:  'Изготовление до 45 рабочих дней',
    href:  '/partitions/',
    img: {
      src:    '/renders/home/cat-partitions-960.webp',
      srcset: '/renders/home/cat-partitions-640.webp 640w, /renders/home/cat-partitions-960.webp 960w',
      alt:    'Реечная перегородка из чёрного алюминиевого профиля в гостиной',
      width: 960, height: 1196,
    },
  },
]

/* ── Вопросы ── */
const catalogFaq = [
  {
    q: 'Сколько стоит межкомнатная дверь с установкой?',
    a: 'Итоговая цена складывается из полотна, погонажа (короб, наличники, добор), фурнитуры и монтажа — и зависит от серии и покрытия. Цены на полотна каждой модели указаны в каталоге, а полный комплект удобно посчитать в калькуляторе на странице модели. Точный расчёт под ваш проём — бесплатно после замера.',
  },
  {
    q: 'Какое покрытие выбрать — эмаль, ПЭТ, Эмалекс или Протач?',
    a: 'Эмаль — гладкая окрашенная поверхность и широкая палитра, классика. ПЭТ — самое стойкое к царапинам и отпечаткам, выбор для семей с детьми и животными. Эмалекс — гладкое полимерное покрытие, устойчивое к влаге и царапинам, по виду близко к эмали, но практичнее по цене. Протач — плотное покрытие с текстурой, стойкое к износу. Образцы всех покрытий можно посмотреть вживую в салоне на Братьев Кашириных.',
  },
  {
    q: 'Есть ли двери в наличии в Челябинске?',
    a: `Да, ${inStockCount} ${pluralRu(inStockCount, ['модель', 'модели', 'моделей'])} лежат на складе в Челябинске — доставка 3–5 рабочих дней, без ожидания фабрики. Список — в разделе «Двери в наличии» (меню «Каталог»), в каталоге такие двери отмечены плашкой «В наличии». Остаток нужного цвета уточните у менеджера.`,
  },
  {
    q: 'Вы делаете замер и установку?',
    a: 'Да. Замер по Челябинску — бесплатный при заказе дверей. Монтаж выполняет наша бригада с гарантией на работы: те же специалисты, что помогают с подбором, ведут заказ до установленной двери.',
  },
  {
    q: 'Можно ли заказать дверь нестандартного размера?',
    a: 'Да, полотна изготавливаются под заказ по нестандартной высоте и ширине. Доплаты за ширину 900 мм у ВФД нет. Возможные размеры и сроки для конкретной серии подскажет менеджер при расчёте.',
  },
  {
    q: 'Как посчитать полную стоимость комплекта?',
    a: 'На странице каждой модели есть калькулятор: выбираете цвет, короб, наличники, доборы, тип петель и замок — и сразу видите итоговую сумму комплекта. Это ориентир до замера; финальную смету составляем после бесплатного замера проёмов.',
  },
]

/* ── Для поисковиков ── */
const canonicalUrl = Astro.site ? new URL('/catalog/', Astro.site).href : undefined
/* Первая страница каталога в порядке по умолчанию — то, что видно сразу */
const firstPage = sortCards(cards, 'popular').slice(0, 24)

const structuredData = canonicalUrl ? [
  /* BreadcrumbList в JSON-LD отдаёт сам Breadcrumbs.astro — здесь не дублируем. */
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Каталог дверей ВФД на Кашириных',
    description: 'Каталог межкомнатных и входных дверей с ценами, сериями, покрытиями и цветами.',
    url: canonicalUrl,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: cards.length,
      itemListElement: firstPage.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: new URL(`/models/${c.slug}/`, Astro.site).href,
        name: c.name,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: catalogFaq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
] : undefined

const lead = minPrice
  ? `${modelsCount} фабрики ВФД, от ${rub(minPrice)} за полотно. Образцы всех покрытий — в салоне на Братьев Кашириных: цвета и фактуры можно сравнить вживую.`
  : `${modelsCount} фабрики ВФД. Образцы всех покрытий — в салоне на Братьев Кашириных.`
---

<BaseLayout
  title="Купить межкомнатные двери в Челябинске — каталог и цены | ВФД"
  description="Межкомнатные двери в Челябинске от официального дилера ВФД: каталог с ценами, покрытия эмаль, ПЭТ, Эмалекс, Протач. Бесплатный замер по Челябинску при заказе, монтаж, салон на Братьев Кашириных."
  canonical={canonicalUrl}
  structuredData={structuredData}
>
  {error && (
    <div class="container pt-8">
      <div class="rounded-2xl bg-red-50 border border-red-100 px-5 py-4 text-red-700 text-sm">
        Ошибка загрузки каталога: {error}
      </div>
    </div>
  )}

  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Каталог' }]} />
    </div>
  </div>

  <section class="section bg-white" aria-labelledby="ct-title">
    <div class="container">
      <SectionHeader id="ct-title" tag="h1" title="Межкомнатные двери в Челябинске" lead={lead} />

      <CatalogClient
        client:idle
        cards={cards}
        series={allSeries}
        coatings={allCoatings}
        coatingCards={coatingCards}
        hideTitle
      />
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="sections-title">
    <div class="container">
      <SectionHeader id="sections-title" title="Другие разделы" />
      <PhotoTiles items={otherSections} />
    </div>
  </section>

  <!-- Не .section: правило .section + .section снимает верхний отступ у
       соседа, а у серой полосы и белых блоков вокруг он нужен -->
  <section id="coatings" class="co-band bg-slate-50" aria-labelledby="coatings-title">
    <div class="container">
      <SectionHeader
        id="coatings-title"
        title="О покрытиях и сериях"
        lead="Покрытие — как дверь выглядит, ощущается рукой и переносит влажную уборку. Серия — рисунок полотна и конструкция."
      >
        <a slot="actions" href="/catalog/series/" class="btn btn-outline co-all">
          Все серии с фото
          <svg class="btn-arrow-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </SectionHeader>

      <ul class="co-list" role="list">
        {coatingGroups.map((g) => (
          <li class="co" id={`coating-${g.slug}`}>
            {g.feature && (
              <div class="co__media">
                <img src={g.feature.src} alt={g.feature.alt} width="900" height="900" loading="lazy" decoding="async" />
              </div>
            )}
            <div class="co__text">
              <h3 class="t-h3 co__name">{g.name}</h3>
              <p class="co__facts">
                {g.minPrice && <><span class="co__price">от&nbsp;{rub(g.minPrice)}</span> за&nbsp;полотно · </>}
                {g.series.length}&nbsp;{pluralRu(g.series.length, ['серия', 'серии', 'серий'])}
              </p>
              {g.tagline && <p class="co__tagline">{typograph(g.tagline)}</p>}
              {g.description && <p class="co__desc">{typograph(g.description)}</p>}
              <a href={g.link.href} class="co__link">
                {g.link.label}
                <svg class="btn-arrow-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>
            <ul class="co__series" role="list" aria-label={`Серии покрытия ${g.name}`}>
              {g.series.map((s) => (
                <li>
                  <a href={`/catalog/series/${s.slug}/`} class="co__serie">
                    {s.thumb && <img class="co__thumb" src={s.thumb} alt="" width="160" height="200" loading="lazy" decoding="async" />}
                    <span class="co__serie-main">
                      <span class="co__serie-name">{s.name}</span>
                      <span class="co__serie-count">{s.modelCount}&nbsp;{pluralRu(s.modelCount, ['модель', 'модели', 'моделей'])}</span>
                    </span>
                    {s.minPrice && <span class="co__serie-price">от&nbsp;{rub(s.minPrice)}</span>}
                    <svg class="co__serie-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <RelatedLinks
    heading="Подборки"
    groups={[
      { title: 'По цвету', links: COLOR_LINKS },
      { title: 'По стилю', links: STYLE_LINKS },
    ]}
  />

  <section class="section">
    <div class="container">
      <FaqAccordion items={catalogFaq} />
    </div>
  </section>
</BaseLayout>

<style>
  .co-band { padding-block: clamp(3rem, 6vw, 5rem); }
  .co-all { min-height: 2.75rem; padding-inline: 1.25rem; font-size: var(--text-step-0); }

  /* ── Покрытия: строки под линейками. Компьютер — три колонки: фото
     ведущей серии, текст покрытия, серии с превью. Телефон и планшет —
     текст и серии, без крупного фото (покрытия с фото уже над каталогом). ── */
  .co-list { margin: 0; padding: 0; list-style: none; }
  .co {
    display: grid;
    gap: 1.75rem 2rem;
    padding-block: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid #e2e8f0;
    scroll-margin-top: calc(var(--header-height) + 1rem);
  }
  .co:last-child { padding-bottom: 0; }
  .co__media { display: none; }
  @media (width >= 64rem) {
    .co { grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: start; }
    .co__media {
      display: block;
      grid-column: 1 / span 3;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      background: #e4e4e7;
    }
    .co__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
    .co__text { grid-column: 4 / span 4; }
    .co__series { grid-column: 8 / span 5; }
  }

  .co__name { margin: 0; }
  .co__facts {
    margin: 0.625rem 0 0;
    font-size: var(--text-step-1);
    line-height: 1.4;
    color: #64748b;
    font-variant-numeric: tabular-nums;
  }
  /* Цена «от» — крупно, тёмным: это главная цифра строки */
  .co__price {
    font-size: var(--text-step-3);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    white-space: nowrap;
  }
  .co__tagline {
    margin: 1.5rem 0 0;
    font-size: var(--text-step-1);
    font-weight: 600;
    line-height: 1.45;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .co__desc {
    margin: 0.375rem 0 0;
    max-width: 34rem;
    font-size: var(--text-step-1);
    line-height: 1.6;
    color: #475569;
    text-wrap: pretty;
  }
  .co__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    margin-top: 1rem;
    font-size: var(--text-step-1);
    font-weight: 600;
    color: #0f766e;
    text-decoration: none;
  }
  .co__link:hover { color: #115e59; }
  @media (hover: hover) {
    .co__link:hover .btn-arrow-icon { transform: translateX(3px); }
  }

  /* Серии: превью, название и число моделей, цена «от» справа */
  .co__series { margin: 0; padding: 0; list-style: none; border-top: 1px solid #e2e8f0; }
  .co__serie {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) auto 1rem;
    align-items: center;
    gap: 1rem;
    padding: 0.625rem 0.75rem 0.625rem 0;
    border-bottom: 1px solid #e2e8f0;
    color: var(--color-ink);
    text-decoration: none;
    transition: background-color 180ms var(--ease-out), padding 180ms var(--ease-out);
  }
  .co__thumb {
    display: block;
    width: 2.75rem;
    height: 3.4375rem;
    object-fit: cover;
    background: #e4e4e7;
  }
  .co__serie-main { display: flex; flex-direction: column; gap: 0.125rem; min-width: 0; }
  .co__serie-name { font-size: var(--text-step-1); font-weight: 600; line-height: 1.3; }
  .co__serie-count { font-size: var(--text-step-0); color: #64748b; font-variant-numeric: tabular-nums; }
  .co__serie-price {
    font-size: var(--text-step-1);
    font-weight: 600;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .co__serie-arrow {
    width: 1rem;
    height: 1rem;
    color: #94a3b8;
    transition: transform 180ms var(--ease-out), color 180ms var(--ease-out);
  }
  /* Наведение: строка подсвечивается белым и чуть сдвигается, стрелка уходит вправо */
  @media (hover: hover) {
    .co__serie:hover { background: #fff; padding-left: 0.75rem; }
    .co__serie:hover .co__serie-name { color: #0f766e; }
    .co__serie:hover .co__serie-arrow { color: #0f766e; transform: translateX(3px); }
  }
  .co__serie:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }

  @media (prefers-reduced-motion: reduce) {
    .co__serie, .co__serie-arrow { transition: none; }
  }
</style>
