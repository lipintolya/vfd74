---
/**
 * src/pages/index.astro — Главная страница
 * Header больше не нужен здесь — он подключён в BaseLayout.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import { reviews } from '../data/reviews'
import HeroSlider from '../components/home/HeroSlider.vue'
import { HERO_COVER_IMAGE, HERO_COVER_IMAGE_SRCSET } from '../data/hero-image'
import PromoStripBanner from '../components/home/PromoStripBanner.astro'
import Novelties from '../components/home/Novelties.astro'
import ProductFeature from '../components/home/ProductFeature.astro'
import CatalogCategories from '../components/home/CatalogCategories.astro'
import Promo from '../components/home/Promo.astro'
import Reviews from '../components/home/Reviews.astro'
import LatestArticles from '../components/home/LatestArticles.astro'
import PortfolioPreview from '../components/portfolio/PortfolioPreview.astro'
import FaqAccordion from '../components/ui/FaqAccordion.astro'
import { faqs } from '../components/home/faq-data'
import HowWeWork from '../components/home/HowWeWork.astro'
import { howToSchema } from '../data/how-it-works'
import { getHomePromos } from '../lib/home-promos'
import { companyLegalInfo } from '../lib/contacts-data'

const faqItems = faqs.map(f => ({ q: f.question, a: f.answer }))

/* Новинки и скрытые двери из наличия — данные и живые цены в lib/home-promos.ts */
const { novelties, inStock, interiorMinPrice } = await getHomePromos()

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
}

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://vfd74.ru/#localbusiness',
  name: 'Салон дверей ВФД на Кашириных',
  /* Разговорное имя, которым пользователи фактически ищут салон в поиске
     ("вфд челябинск") — честный алиас, не выдумка: это реальное название
     бренда + город, под которым бизнес и так известен. Помогает Google/
     Яндексу связать сущность с этим запросом (Knowledge Graph), не подменяет
     основное юридическое/витринное имя. */
  /* Массив, а не строка — латинское "VFD" встречается в поиске наравне
     с кириллическим (бренд сам пишется латиницей на логотипе/фасаде),
     оба варианта честно относятся к этому же салону. */
  alternateName: ['ВФД Челябинск', 'VFD Челябинск', 'ВФД', 'VFD', 'Салон Владимирской фабрики дверей'],
  description: 'Фирменный салон входных и межкомнатных дверей, алюминиевых перегородок в Челябинске. Работаем с 2014 года.',
  url: 'https://vfd74.ru',
  telephone: ['+79000297888', '+79630807888'],
  email: 'vfddoors74@mail.ru',
  image: '/media/promo_main/main_render_innova.webp',
  /* logo — отдельно от image: Google берёт его для бренд-логотипа в Knowledge
     Panel/поиске, PNG-растр (см. logo-schema.png — тот же файл, что у
     BlogPosting.publisher.logo на статьях, единый источник бренд-лого). */
  logo: 'https://vfd74.ru/logo-schema.png',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'ул. Братьев Кашириных, 131Б',
    addressLocality: 'Челябинск',
    addressRegion: 'Челябинская область',
    postalCode: '454128',
    addressCountry: 'RU',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 55.172868,
    longitude: 61.306572,
  },
  openingHoursSpecification: companyLegalInfo.schemaOrgHours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    ...h,
  })),
  foundingDate: '2014',
  priceRange: '₽₽',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    reviewCount: String(reviews.length),
    bestRating: '5',
  },
  sameAs: [
    'https://vk.com/vfddoors74',
    'https://t.me/vfddoors74',
    'https://max.ru/id452402308842_biz',
    'https://2gis.ru/chelyabinsk/firm/70000001093506304',
    'https://yandex.ru/maps/-/CPwenX08',
  ],
}
---

<BaseLayout
  title="ВФД Челябинск — салон Владимирской фабрики дверей, каталог и цены"
  description="ВФД Челябинск — фирменный салон на Братьев Кашириных, 131Б: входные и межкомнатные двери, алюминиевые перегородки. Каталог и цены, бесплатный замер межкомнатных дверей при заказе, установка."
  structuredData={[faqSchema, localBusinessSchema, howToSchema]}
  preloadImage={HERO_COVER_IMAGE}
  preloadImageSrcset={HERO_COVER_IMAGE_SRCSET}
  ogImage={HERO_COVER_IMAGE}
>
  <HeroSlider client:load />
  <HowWeWork />
  <Novelties items={novelties} />
  <PromoStripBanner />
  <!-- «Секрет» не новинка — отдельным блоком под замером, фото справа
       (у «Новинок» слева) -->
  <section class="section bg-white" aria-labelledby="in-stock-heading">
    <div class="container">
      <ProductFeature item={inStock} headingTag="h2" headingId="in-stock-heading" reverse />
    </div>
  </section>
  <CatalogCategories interiorMinPrice={interiorMinPrice} />
  <Reviews limit={4} />
  <PortfolioPreview />
  <Promo />
  <LatestArticles />

  <!-- padding-top у смежных .section обычно зануляется (см. global.css),
       но LatestArticles перед этой секцией — сплошной bg-graphite, а не
       карточка на белом: без своего отступа сверху белый фон FAQ упирался
       прямо в чёрный край без миллиметра воздуха. Тот же фикс, что и в
       LatestArticles.astro. -->
  <section class="section bg-white pt-[clamp(2.5rem,4vw,3.5rem)]!">
    <div class="container">
      <FaqAccordion items={faqItems} />

      <div class="mt-12 flex flex-col items-start gap-6 rounded-2xl bg-fg p-[clamp(2.5rem,5vw,4rem)] text-white sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h3 class="m-0 mb-2 text-2xl font-medium tracking-tight">Остались вопросы?</h3>
          <p class="m-0 text-step-1 text-white/60">Свяжитесь с нами — поможем с выбором и проконсультируем.</p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-2.5">
          <a href="https://t.me/vfddoors74" target="_blank" rel="noopener" class="btn btn-ghost">Написать в Telegram</a>
          <a href="tel:+79000297888" class="btn btn-ghost">Позвонить</a>
          <a href="https://vk.com/vfddoors74" target="_blank" rel="noopener" class="btn btn-ghost btn-icon" aria-label="Написать в VK">
            <img src="/icons/w_vk.webp" alt="" width="18" height="18" />
          </a>
          <a href="https://max.ru/id452402308842_biz" target="_blank" rel="noopener" class="btn btn-ghost btn-icon" aria-label="Написать в MAX">
            <img src="/icons/w_max.webp" alt="" width="18" height="18" />
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>