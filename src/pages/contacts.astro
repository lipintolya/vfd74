---
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
import FaqAccordion from '../components/ui/FaqAccordion.astro'
import ContactsSection from '../components/contacts/ContactsSection.astro'
import { companyLegalInfo } from '../lib/contacts-data'
import { FACADE_IMAGE } from '../lib/facade-image'

const title = 'Контакты салона дверей ВФД в Челябинске — адрес, телефон, часы работы'
const description =
  'Контакты фирменного салона дверей ВФД на Братьев Кашириных, 131Б. Телефон, email, часы работы, реквизиты согласно РФ. Консультации по дверям и перегородкам.'

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'HomeGoodsStore',  // подтип LocalBusiness → Store: «магазин дверей», а не просто организация
  '@id': 'https://vfd74.ru/#localbusiness',  // та же сущность, что на главной и «О салоне»
  name: 'Салон ВФД (Владимирская фабрика дверей)',
  image: ['https://vfd74.ru/logo-schema.png', '/media/about_page/vfd_out.webp'],
  description: companyLegalInfo.activity.description,
  telephone: companyLegalInfo.contacts.phone.map((p) => p.raw),
  email: companyLegalInfo.contacts.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'ул. Братьев Кашириных, 131Б',
    addressLocality: 'Челябинск',
    addressRegion: 'Челябинская область',
    postalCode: '454128',
    addressCountry: 'RU',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: companyLegalInfo.address.coordinates.lat,
    longitude: companyLegalInfo.address.coordinates.lng,
  },
  openingHoursSpecification: companyLegalInfo.schemaOrgHours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    ...h,
  })),
  url: 'https://vfd74.ru/contacts/',
  foundingDate: '2014',
  priceRange: '₽₽',
  areaServed: [
    { '@type': 'City', name: 'Челябинск' },
    { '@type': 'AdministrativeArea', name: 'Челябинская область' },
  ],
  acceptsPaymentMethod: ['Cash', 'CreditCard', 'DebitCard'],
  sameAs: [
    'https://t.me/vfddoors74',
    'https://vk.com/vfddoors74',
    'https://max.ru/id452402308842_biz',
  ],
}

const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'Контакты' },
]


const faq = [
  {
    q: 'Нужно ли записываться заранее, чтобы приехать в салон?',
    a: 'Нет, предварительная запись не обязательна — заходите в рабочие часы. Если хотите, чтобы вас проконсультировал конкретный специалист или показал образцы под ваш проект, удобнее предупредить заранее в Telegram.',
  },
  {
    q: 'Работаете ли вы в выходные?',
    a: 'Да, салон работает без выходных: суббота и воскресенье — с 10:00 до 18:00.',
  },
  {
    q: 'Есть ли парковка у салона?',
    a: 'Да, у здания на Братьев Кашириных, 131Б есть места для парковки. Вход в салон — со стороны улицы Чичерина.',
  },
  {
    q: 'Выезжаете ли вы на замер за пределы Челябинска?',
    a: 'Да, выезжаем и в Челябинскую область — стоимость выезда зависит от адреса, её уточнит менеджер. По Челябинску замер бесплатный при оформлении заказа (для входных дверей — 500 ₽).',
  },
  {
    q: 'Как быстрее всего получить консультацию?',
    a: 'Быстрее всего — написать в Telegram или позвонить по основному номеру. Отвечаем в мессенджере в течение рабочего дня.',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}

const structuredData = [localBusinessSchema, faqSchema]
---

<BaseLayout
  title={title}
  description={description}
  structuredData={structuredData}
  ogImage="/media/about_page/vfd_out.webp"
  preloadImage={FACADE_IMAGE.src}
  preloadImageSrcset={FACADE_IMAGE.srcset}
  preloadImageSizes={FACADE_IMAGE.sizes}
>
  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <ContactsSection />

  <section class="section pt-0">
    <div class="container">
      <FaqAccordion items={faq} />
    </div>
  </section>
</BaseLayout>
