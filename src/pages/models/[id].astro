---
import { supabase } from '../../lib/supabase'
import { buildModelSlugMap } from '../../lib/slugify'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro'
import ProductColorPicker from '../../components/catalog/ProductColorPicker.vue'
import type { ColorVariant } from '../../components/catalog/ProductColorPicker.vue'
import PlinthSection from '../../components/catalog/PlinthSection.astro'
import { getSeriesSpec } from '../../data/series-descriptions'
import { adjustPrice } from '../../lib/price-adjustments'
import { isNewModel } from '../../lib/new-models'
import { accessoriesByCoating, CATEGORY_LABELS, CATEGORY_NOTES, PRICE_LIST_UPDATED } from '../../data/accessories'
import type { AccessoryCategory, CoatingSlug } from '../../data/accessories'

export async function getStaticPaths() {
  const { data, error } = await supabase
    .from('model_colors')
    .select(`
      price_rrp,
      photo_url,
      model_id,
      color_id,
      colors ( id, name, hex_preview, coatings ( id, name, slug ) ),
      models ( id, name, has_glass, trim, series ( id, name, slug, coatings ( id, name, slug ) ) )
    `)
    .order('price_rrp', { ascending: true })

  if (error || !data) {
    console.error('getStaticPaths error:', error?.message)
    return []
  }

  const normalizeHex = (v: string | null | undefined) => {
    const s = (v ?? '').trim().replaceAll('С', 'C').replaceAll('с', 'c')
    return /^#[0-9a-fA-F]{3,6}$/.test(s) ? s : '#cccccc'
  }

  type ModelEntry = {
    model:       { id: string; name: string; hasGlass: boolean; trim: string | null; isNew: boolean }
    slug:        string
    seriesName:  string
    seriesSlug:  string
    coatingName: string
    coatingSlug: string
    colors:      ColorVariant[]
    minPrice:    number | null
  }

  const modelMap = new Map<string, ModelEntry>()

  for (const row of data) {
    const model  = row.models  as any
    const color  = row.colors  as any
    if (!model || !color) continue

    const series        = model.series   as any
    const seriesCoating = series?.coatings as any
    const colorCoating  = color.coatings  as any
    const coating       = seriesCoating ?? colorCoating

    if (!modelMap.has(model.id)) {
      modelMap.set(model.id, {
        model: {
          id:       model.id,
          name:     model.name,
          hasGlass: model.has_glass ?? false,
          trim:     model.trim ?? null,
          isNew:    isNewModel(model.id),
        },
        slug:        '',
        seriesName:  series?.name     ?? '',
        seriesSlug:  series?.slug     ?? '',
        coatingName: coating?.name    ?? '',
        coatingSlug: coating?.slug    ?? '',
        colors:      [],
        minPrice:    null,
      })
    }

    const entry = modelMap.get(model.id)!

    const adjustedPrice = adjustPrice(series?.slug ?? '', row.price_rrp ?? null)

    if (!entry.colors.some(c => c.id === color.id)) {
      entry.colors.push({
        id:          color.id,
        name:        color.name,
        hex:         normalizeHex(color.hex_preview),
        photo:       row.photo_url  ?? '',
        price:       adjustedPrice,
        coatingSlug: coating?.slug  ?? '',
      })
    }

    if (adjustedPrice && (!entry.minPrice || adjustedPrice < entry.minPrice)) {
      entry.minPrice = adjustedPrice
    }
  }

  /* Показываем только реально сфотканные цвета — свотч без фото сбивает
     покупателя с толку (выглядит как рабочий вариант, а на деле «по запросу»). */
  for (const entry of modelMap.values()) {
    entry.colors = entry.colors.filter(c => Boolean(c.photo))
  }

  /* ── Читаемые слаги вместо UUID: имя модели + серия, с защитой от коллизий ── */
  const slugMap = buildModelSlugMap(
    [...modelMap.values()].map(entry => ({
      id:         entry.model.id,
      name:       entry.model.name,
      seriesSlug: entry.seriesSlug,
    })),
  )
  for (const entry of modelMap.values()) {
    entry.slug = slugMap.get(entry.model.id)!
  }

  /* ── Каждая модель доступна по двум путям: новому слагу (канонический)
     и старому UUID (чтобы не 404'ить уже проиндексированные Яндексом ссылки) ── */
  const entries = [...modelMap.values()]
  return [
    ...entries.map(entry => ({ params: { id: entry.slug },     props: entry })),
    ...entries.map(entry => ({ params: { id: entry.model.id }, props: entry })),
  ]
}

const { model, slug, colors, minPrice, seriesName, seriesSlug, coatingName, coatingSlug } = Astro.props

const spec        = getSeriesSpec(seriesSlug, coatingSlug)
const accessories = accessoriesByCoating[coatingSlug as CoatingSlug] ?? []
const hasPlinth   = accessories.some(item => item.category === 'plinth')

const CATEGORY_ORDER: AccessoryCategory[] = ['kit', 'box', 'nalichnik', 'kapitel', 'dobor', 'plinth', 'decorative']

const accessoryGroups: [AccessoryCategory, typeof accessories][] = Object.entries(
  accessories.reduce<Record<string, typeof accessories>>((acc, item) => {
    ;(acc[item.category] ??= []).push(item)
    return acc
  }, {})
)
  .sort(([a], [b]) => CATEGORY_ORDER.indexOf(a as AccessoryCategory) - CATEGORY_ORDER.indexOf(b as AccessoryCategory))
  .map(([category, items]) => [category as AccessoryCategory, items])

const canonicalUrl  = Astro.site ? new URL(`/models/${slug}/`, Astro.site).href : undefined
const priceStr      = minPrice ? `${minPrice.toLocaleString('ru-RU')} ₽` : ''
const seriesPart    = seriesName ? `серия ${seriesName}` : ''
const coatingPart   = coatingName

const pageTitle     = [model.name, seriesPart, coatingPart].filter(Boolean).join(' — ') + ' | ВФД Челябинск'
const pageDesc      = spec.description ||
  `Дверь ${model.name}${seriesName ? ` серии ${seriesName}` : ''}${coatingName ? `, ${coatingName}` : ''}${priceStr ? `. Цена ${priceStr}` : ''}. Купить в салоне ВФД в Челябинске.`

const breadcrumbs = [
  { label: 'Главная',  href: '/' },
  { label: 'Каталог',  href: '/catalog/' },
  ...(seriesName ? [{ label: seriesName, href: `/catalog/series/${seriesSlug}/` }] : []),
  { label: model.name },
]

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, Astro.site!).href } : {}),
  })),
}

const productImages = [...new Set(colors.map(c => c.photo).filter(Boolean))]

const structuredData = [breadcrumbSchema, {
  '@context': 'https://schema.org',
  '@type':    'Product',
  name:        model.name,
  description: pageDesc,
  url:         canonicalUrl,
  image:       productImages,
  brand:       { '@type': 'Brand', name: 'ВФД' },
  offers: {
    '@type':        'Offer',
    priceCurrency:  'RUB',
    availability:   'https://schema.org/InStoreOnly',
    seller:         { '@type': 'Organization', name: 'Салон дверей ВФД' },
    ...(minPrice
      ? {
          price:            minPrice,
          priceValidUntil:  new Date(Date.now() + 90 * 24 * 60 * 60 * 1000).toISOString().split('T')[0],
        }
      : {}),
  },
}]
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonical={canonicalUrl}
  ogImage={colors[0]?.photo || undefined}
  structuredData={structuredData}
>
  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />
    </div>
  </div>

  <div class="section product-page">
    <div class="container">
      <div class="product-layout">

        <!-- ── Фото + выбор цвета (Vue island) ── -->
        <ProductColorPicker
          client:load
          colors={colors}
          modelName={model.name}
          seriesSlug={seriesSlug}
        />

        <!-- ── Характеристики (статический HTML для SEO) ── -->
        <div class="product-info">
          <div class="product-badges">
            {model.isNew && <span class="product-badge product-badge--new">Новинка</span>}
            {seriesName && <span class="product-badge">{seriesName}</span>}
            {coatingName && <span class="product-badge product-badge--muted">{coatingName}</span>}
          </div>

          <h1 class="product-title">{model.name}</h1>

          {spec.description && (
            <details class="product-description">
              <summary class="product-description__toggle">Смотреть описание</summary>
              <p class="product-description__text">{spec.description}</p>
            </details>
          )}

          {(model.trim || spec.features.length > 0 || spec.coating || spec.material || spec.edge || spec.thickness) && (
            <dl class="product-specs">
              {model.trim && (
                <div class="product-specs__row">
                  <dt>Исполнение</dt>
                  <dd>{model.trim}</dd>
                </div>
              )}
              {spec.features.length > 0 && (
                <div class="product-specs__row">
                  <dt>Особенности</dt>
                  <dd>{spec.features.join('; ')}</dd>
                </div>
              )}
              {spec.coating && (
                <div class="product-specs__row">
                  <dt>Покрытие / Отделка</dt>
                  <dd>{spec.coating}</dd>
                </div>
              )}
              {spec.material && (
                <div class="product-specs__row">
                  <dt>Материал / Конструктив</dt>
                  <dd>{spec.material}</dd>
                </div>
              )}
              {spec.edge && (
                <div class="product-specs__row">
                  <dt>Кромка</dt>
                  <dd>{spec.edge}</dd>
                </div>
              )}
              {spec.thickness && (
                <div class="product-specs__row">
                  <dt>Толщина</dt>
                  <dd>{spec.thickness} мм</dd>
                </div>
              )}
            </dl>
          )}

          <!-- Быстрый ориентир по цене (статика, всегда виден до гидратации) -->
          {minPrice && (
            <p class="product-price-hint">
              Цена: <strong>{minPrice.toLocaleString('ru-RU')} ₽</strong> за полотно
            </p>
          )}

          <div class="product-contact">
            <p class="product-contact__note">
              Уточните наличие нужного цвета и размера у менеджера салона
            </p>
            <div class="product-contact__cta">
              <a href="https://t.me/vfddoors74" target="_blank" rel="noopener" class="btn btn-primary">
                Написать в Telegram
              </a>
              <a href="/contacts/" class="btn btn-outline">Контакты</a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- ── Плинтус к дверям (только для покрытий, где он есть — Эмаль/Эмалекс) ── -->
  {hasPlinth && <PlinthSection title="Плинтус к дверям" />}

  <!-- ── Погонажные изделия ── -->
  {accessories.length > 0 && (
    <section class="accessories-section">
      <div class="container">
        <div class="accessories-header">
          <h2 class="accessories-title">Погонажные изделия</h2>
          <p class="accessories-note">
            Цены актуальны на момент публикации от {PRICE_LIST_UPDATED} — актуальный прайс уточняйте
            у менеджера в фирменном салоне ВФД на Кашириных
          </p>
        </div>
        <div class="accessories-groups">
          {accessoryGroups.map(([category, items]) => (
            <details class:list={['accessories-group', category === 'kit' && 'accessories-group--kit']}>
              <summary class="accessories-group__label">
                {CATEGORY_LABELS[category] ?? category}
              </summary>
              <ul class="accessories-list">
                {items.map(item => (
                  <li class="accessories-item">
                    <span class="accessories-item__name">{item.name}</span>
                    <span class="accessories-item__price">
                      {item.price ? `${item.price.toLocaleString('ru-RU')} ₽ / ${item.unit}` : 'Цена уточняется'}
                    </span>
                  </li>
                ))}
              </ul>
              {CATEGORY_NOTES[category] && (
                <p class="accessories-note accessories-note--group">{CATEGORY_NOTES[category]}</p>
              )}
            </details>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
/* ── Product layout ── */
.product-page {
  padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
}

.product-layout {
  display: grid;
  grid-template-columns: 34rem 1fr;
  gap: 3.5rem;
  margin-top: 1.75rem;
  align-items: start;
}

@media (max-width: 900px) {
  .product-layout {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
}

/* ── Info panel ── */
.product-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 1rem;
}

.product-badge {
  display: inline-flex;
  align-items: center;
  padding: 0.3rem 0.875rem;
  border-radius: 9999px;
  background: #f0fdfa;
  border: 1px solid #ccfbf1;
  color: #0f766e;
  font-size: 0.8rem;
  font-weight: 600;
}

.product-badge--muted {
  background: #f8fafc;
  border-color: #e2e8f0;
  color: #475569;
}

.product-badge--new {
  background: oklch(57.7% 0.245 27.325);
  border-color: oklch(57.7% 0.245 27.325);
  color: #fff;
}

.product-title {
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  font-weight: 500;
  line-height: 1.08;
  letter-spacing: -0.03em;
  color: #0f172a;
  margin: 0 0 1rem;
}

.product-description {
  margin: 0 0 1.5rem;
}

.product-description__toggle {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  font-size: 0.9375rem;
  font-weight: 600;
  color: #0d9488;
  cursor: pointer;
  user-select: none;
  list-style: none;
}
.product-description__toggle:hover { color: #0f766e; }

.product-description__toggle::-webkit-details-marker {
  display: none;
}

.product-description__toggle::after {
  content: '';
  flex-shrink: 0;
  width: 0.5rem;
  height: 0.5rem;
  border-right: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  transform: rotate(45deg);
  transition: transform 200ms ease;
}

.product-description[open] > .product-description__toggle::after {
  transform: rotate(-135deg);
}

.product-description__text {
  margin: 0.75rem 0 0;
  font-size: 1rem;
  color: #475569;
  line-height: 1.65;
}

/* ── Specs table ── */
.product-specs {
  margin: 0 0 1.75rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.product-specs__row {
  display: grid;
  grid-template-columns: 160px 1fr;
}

.product-specs__row + .product-specs__row {
  border-top: 1px solid var(--color-border);
}

.product-specs__row dt {
  padding: 0.75rem 1rem;
  font-size: 0.8125rem;
  font-weight: 600;
  color: #64748b;
  background: #f8fafc;
}

.product-specs__row dd {
  padding: 0.75rem 1rem;
  font-size: 0.875rem;
  color: #0f172a;
  margin: 0;
  line-height: 1.55;
}

@media (max-width: 480px) {
  .product-specs__row {
    grid-template-columns: 1fr;
  }
  .product-specs__row dt {
    padding-bottom: 0.25rem;
  }
}

/* ── Price hint + contacts ── */
.product-price-hint {
  font-size: 0.9375rem;
  color: #475569;
  margin: 0 0 1.25rem;
}

.product-price-hint strong {
  color: #0f172a;
  font-weight: 600;
}

.product-contact {
  background: #f8fafc;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-card);
  padding: 1.25rem 1.5rem;
}

.product-contact__note {
  font-size: 0.875rem;
  color: #64748b;
  margin: 0 0 1rem;
  line-height: 1.5;
}

.product-contact__cta {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

/* ── Accessories ── */
.accessories-section {
  padding: clamp(2.5rem, 4vw, 4rem) 0;
}

.accessories-header {
  margin-bottom: 2rem;
}

.accessories-title {
  font-size: clamp(1.5rem, 3vw, 2rem);
  font-weight: 500;
  color: #0f172a;
  margin: 0 0 0.375rem;
}

.accessories-note {
  font-size: 0.9rem;
  color: #64748b;
  margin: 0;
}

.accessories-note--group {
  font-size: 0.8125rem;
  line-height: 1.5;
  padding: 1rem 1.5rem 1.375rem;
  margin: 0;
  border-top: 1px dashed #e2e8f0;
}

.accessories-groups {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.accessories-group {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 1.5rem;
  overflow: hidden;
}

.accessories-group__label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  font-size: 1.0625rem;
  font-weight: 500;
  color: #0f172a;
  padding: 1.25rem 1.5rem;
  cursor: pointer;
  user-select: none;
  list-style: none;
}

.accessories-group__label::-webkit-details-marker {
  display: none;
}

.accessories-group__label::after {
  content: '';
  flex-shrink: 0;
  width: 0.5625rem;
  height: 0.5625rem;
  border-right: 2px solid #94a3b8;
  border-bottom: 2px solid #94a3b8;
  transform: rotate(45deg);
  transition: transform 200ms ease;
}

.accessories-group[open] > .accessories-group__label::after {
  transform: rotate(-135deg);
}

.accessories-list {
  list-style: none;
  padding: 0 1.5rem 1.25rem;
  margin: 0;
  border-top: 1px solid #e2e8f0;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.accessories-list > .accessories-item:first-child {
  padding-top: 1rem;
}

.accessories-item {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  font-size: 0.875rem;
  line-height: 1.4;
  padding: 0.6rem 0;
  border-bottom: 1px solid #e2e8f0;
}

.accessories-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.accessories-item__name {
  color: #64748b;
}

.accessories-item__price {
  font-weight: 600;
  color: #0f172a;
}

.accessories-group--kit {
  background: #f0fdfa;
  border-color: #99f6e4;
}

.accessories-group--kit .accessories-group__label {
  color: #0f766e;
}
</style>
