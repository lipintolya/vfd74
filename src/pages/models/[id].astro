---
import { getPublishedArticles } from '../../lib/articles'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro'
import ProductColorPicker from '../../components/catalog/ProductColorPicker.vue'
import PlinthSection from '../../components/catalog/PlinthSection.astro'
import { getSeriesSpec } from '../../data/series-descriptions'
import { accessoriesByCoating, CATEGORY_LABELS, CATEGORY_NOTES, PRICE_LIST_UPDATED } from '../../data/accessories'
import type { AccessoryCategory, CoatingSlug } from '../../data/accessories'
import InfoImageViewer from '../../components/catalog/InfoImageViewer.vue'
import { describeTrim } from '../../lib/trim-labels'
import { merchantPolicy } from '../../lib/contacts-data'
import { getModelEntries } from '../../lib/model-entries'
import { relatedModels } from '../../lib/related-models'
import RelatedModels from '../../components/catalog/RelatedModels.astro'
import { DOOR_CATEGORIES } from '../../data/door-categories'
import type { ModelEntry } from '../../lib/model-entries'
import {
  DOOR_TYPE, BRAND, cleanModelName,
  productName, productTitle, productMetaDescription, productDescription,
} from '../../lib/product-text'

export async function getStaticPaths() {
  /* Данные моделей — в lib/model-entries.ts: их же берёт товарный фид
     /feed/yandex.xml, цена и фото в фиде обязаны совпадать со страницей. */
  const entries = await getModelEntries()

  /* ── Каждая модель доступна по двум путям: новому слагу (канонический)
     и старому UUID (чтобы не 404'ить уже проиндексированные Яндексом ссылки) ── */
  return [
    ...entries.map(entry => ({ params: { id: entry.slug },     props: entry })),
    ...entries.map(entry => ({ params: { id: entry.model.id }, props: entry })),
  ]
}

const entry = Astro.props as ModelEntry
const { model, slug, colors, minPrice, seriesName, seriesSlug, coatingName, coatingSlug, extraColors } = entry

const spec        = getSeriesSpec(seriesSlug, coatingSlug)
const accessories = accessoriesByCoating[coatingSlug as CoatingSlug] ?? []
const hasPlinth   = accessories.some(item => item.category === 'plinth')

/* Статья по теме — перелинковка каталог → блог (раньше была только в одну
   сторону: статьи ссылались на каталог, карточки моделей — никогда обратно
   на блог). Ищем первую статью, у которой seriesSlug модели указан
   в relatedSeriesSlugs. */
const allArticles = await getPublishedArticles()
const relatedArticle = allArticles.find(a => a.data.relatedSeriesSlugs?.includes(seriesSlug))

const CATEGORY_ORDER: AccessoryCategory[] = ['kit', 'box', 'nalichnik', 'kapitel', 'dobor', 'plinth', 'decorative']

const accessoryGroups: [AccessoryCategory, typeof accessories][] = Object.entries(
  accessories.reduce<Record<string, typeof accessories>>((acc, item) => {
    ;(acc[item.category] ??= []).push(item)
    return acc
  }, {})
)
  .sort(([a], [b]) => CATEGORY_ORDER.indexOf(a as AccessoryCategory) - CATEGORY_ORDER.indexOf(b as AccessoryCategory))
  .map(([category, items]) => [category as AccessoryCategory, items])

/* Цена в заголовке группы — видно, не раскрывая: одна позиция — её цена,
   несколько — «от» минимальной. Мелкий крепёж (клипсы плинтуса по 50 ₽,
   соединители доборов) в «от» не считаем — иначе «Плинтус от 50 ₽». */
const FITTING_RE = /^(Клипс|Соединитель)/i
const groupPriceLabel = (items: typeof accessories) => {
  const prices = items
    .filter(i => !FITTING_RE.test(i.name))
    .map(i => i.price)
    .filter((p): p is number => !!p)
  if (!prices.length) return ''
  const min = Math.min(...prices).toLocaleString('ru-RU')
  return items.length === 1 ? `${min} ₽` : `от ${min} ₽`
}

const canonicalUrl  = Astro.site ? new URL(`/models/${slug}/`, Astro.site).href : undefined
/* UUID-маршрут — тот же контент, что и на slug-странице (см. комментарий
   у getStaticPaths: оставлен, чтобы не 404'ить старые проиндексированные
   ссылки). canonical выше уже указывает на slug-версию, но Яндекс.Вебмастер
   всё равно считает title/description дублями по факту краулинга — noIndex
   явно говорит роботу не индексировать и не учитывать эту версию отдельной
   страницей, ссылка при этом продолжает открываться. */
const isUuidRoute   = Astro.params.id !== slug

/* «Другие модели серии» — только на канонической странице: UUID-копия закрыта
   от индексации и ссылок раздавать не должна. getModelEntries() кэшируется на
   сборку — повторных запросов к Supabase нет. */
const related = isUuidRoute ? null : relatedModels(entry, await getModelEntries())
/* Имя модели для показа: без лишних пробелов и латинских букв-двойников
   внутри кириллических слов (см. cleanModelName). */
const displayName = cleanModelName(model.name)

/* Кромка/остекление — у некоторых моделей это единственное отличие между
   SKU (4 «Урбан 1» — золото/серебро/чёрная). describeTrim() убирает мусорные
   коды поставщика и битые записи ("true") и отличает остекление серии Некст,
   которое в базе лежит в том же поле, от кромки. */
const trim = describeTrim(model.trim)

/* Перелинковка карточка → SEO-лендинг покрытия (/catalog/dveri-emal/ и т.п.).
   Раньше с карточки вела только ссылка на серию, а лендинги под главные
   запросы («двери эмаль челябинск») не получали ни одной ссылки из сотен
   карточек. Анкор — H1 лендинга, т.е. сам целевой запрос. */
const coatingLanding = DOOR_CATEGORIES.find(c => c.coatingSlug === coatingSlug)

/* Короткие факты под кнопками — только то, что отличает эту модель и
   помещается в два-три слова. Длинные тексты серии (описание, особенности,
   конструкция) живут на странице серии — туда ведёт ссылка «Серия». */
const facts: { label: string; value: string; href?: string }[] = [
  ...(seriesName ? [{ label: 'Серия', value: seriesName, href: `/catalog/series/${seriesSlug}/` }] : []),
  ...(coatingName ? [{ label: 'Покрытие', value: coatingName }] : []),
  ...(trim ? [{ label: trim.kind === 'glass' ? 'Остекление' : 'Кромка', value: trim.label }] : []),
  ...(spec.thickness ? [{ label: 'Толщина', value: `${spec.thickness} мм` }] : []),
]

/* Title/description/название в schema — из lib/product-text.ts, те же
   формулировки, что в товарном фиде. Тип товара («Межкомнатная дверь»)
   первым словом: по нему ищут, а в имени модели («Иннова 02СТ», «ЕР1»)
   его нет. Meta description — уникальная по модели (не spec.description:
   это текст серии, общий на десятки моделей). */
const pageTitle = productTitle(entry)
const pageDesc  = productMetaDescription(entry)

/* BreadcrumbList в JSON-LD отдаёт сам Breadcrumbs.astro — здесь не дублируем. */
const breadcrumbs = [
  { label: 'Главная',  href: '/' },
  { label: 'Каталог',  href: '/catalog/' },
  ...(seriesName ? [{ label: seriesName, href: `/catalog/series/${seriesSlug}/` }] : []),
  { label: displayName },
]

const productImages = [...new Set(colors.map(c => c.photo).filter(Boolean))]

const structuredData = [{
  '@context': 'https://schema.org',
  '@type':    'Product',
  name:        productName(entry),
  description: productDescription(entry),
  url:         canonicalUrl,
  image:       productImages,
  brand:       { '@type': 'Brand', name: BRAND },
  /* Offer требует price+priceCurrency вместе — без цены (price_rrp пуст
     в Supabase) Google считает Offer невалидным и не даёт rich snippet
     вообще. Без цены честнее не публиковать offers, чем отдавать
     заведомо неполную/невалидную схему. */
  ...(minPrice
    ? {
        offers: {
          '@type':                  'Offer',
          priceCurrency:            'RUB',
          availability:             'https://schema.org/InStoreOnly',
          seller:                   { '@type': 'Organization', name: 'Салон дверей ВФД' },
          price:                    minPrice,
          priceValidUntil:          new Date(Date.now() + 90 * 24 * 60 * 60 * 1000).toISOString().split('T')[0],
          hasMerchantReturnPolicy:  merchantPolicy.returnPolicy,
          shippingDetails:          merchantPolicy.shipping,
        },
      }
    : {}),
}]
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonical={canonicalUrl}
  ogImage={colors[0]?.photo || undefined}
  structuredData={structuredData}
  noIndex={isUuidRoute}
>
  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />
    </div>
  </div>

  <div class="section product-page">
    <div class="container">
      <!-- Фото + покупка — один Vue-остров (фото и цена зависят от цвета).
           Заголовок и факты — статический HTML страницы, отдаются слотами. -->
      <ProductColorPicker
        client:load
        colors={colors}
        extraColors={extraColors}
        modelName={displayName}
        modelId={model.id}
        seriesSlug={seriesSlug}
        isNew={model.isNew}
      >
        <h1 slot="head" class="product-title">
          <span class="product-title__type">{DOOR_TYPE}</span>
          {' '}<span class="product-title__name">{displayName}</span>
          {coatingName && <span class="product-title__coating">{` в покрытии ${coatingName}`}</span>}
        </h1>

        <div slot="details" class="product-details">
          {facts.length > 0 && (
            <dl class="product-facts">
              {facts.map(fact => (
                <div class="product-facts__item">
                  <dt>{fact.label}</dt>
                  <dd>{fact.href ? <a href={fact.href}>{fact.value}</a> : fact.value}</dd>
                </div>
              ))}
            </dl>
          )}

          {coatingLanding && (
            <a href={`/catalog/${coatingLanding.slug}/`} class="product-coating-link">
              Все {coatingLanding.h1.charAt(0).toLowerCase() + coatingLanding.h1.slice(1)}
            </a>
          )}
        </div>
      </ProductColorPicker>
    </div>
  </div>

  <!-- ── Плинтус к дверям (только для покрытий, где он есть — Эмаль/Эмалекс) ── -->
  {hasPlinth && <PlinthSection title="Плинтус к дверям" />}

  <!-- ── Погонажные изделия ── -->
  {accessories.length > 0 && (
    <section class="accessories-section" aria-labelledby="accessories-title">
      <div class="container">
        <div class="accessories-header">
          <h2 id="accessories-title" class="t-h2">Погонажные изделия</h2>
          <p class="accessories-note">Цены на {PRICE_LIST_UPDATED}, точную сумму назовёт менеджер салона.</p>
        </div>
        <div class="accessories-groups">
          {accessoryGroups.map(([category, items]) => (
            <details class="accessories-group">
              <summary class="accessories-group__label">
                <span class="accessories-group__name">{CATEGORY_LABELS[category] ?? category}</span>
                {groupPriceLabel(items) && <span class="accessories-group__from">{groupPriceLabel(items)}</span>}
              </summary>
              <ul class="accessories-list">
                {items.map(item => (
                  <li class="accessories-item">
                    <span class="accessories-item__name">{item.name}</span>
                    <span class="accessories-item__price">
                      {item.price
                        ? <>{`${item.price.toLocaleString('ru-RU')} ₽`}<span class="accessories-item__unit">{` / ${item.unit}`}</span></>
                        : <span class="accessories-item__unit">Цена уточняется</span>}
                    </span>
                    {(item.image || item.scheme) && (
                      <div class="accessories-item__media">
                        <InfoImageViewer
                          client:visible
                          variant="wide"
                          aspectRatio={item.mediaAspect ?? '2 / 1'}
                          images={[
                            ...(item.image  ? [{ src: item.image,  caption: 'Фото',  alt: `Фото: ${item.name}` }]  : []),
                            ...(item.scheme ? [{ src: item.scheme, caption: 'Схема', alt: `Схема с размерами: ${item.name}` }] : []),
                          ]}
                        />
                      </div>
                    )}
                  </li>
                ))}
              </ul>
              {CATEGORY_NOTES[category] && (
                <p class="accessories-group__note">{CATEGORY_NOTES[category]}</p>
              )}
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  {related && (
    <RelatedModels
      models={related.models}
      seriesName={seriesName}
      seriesSlug={seriesSlug}
      seriesTotal={related.seriesTotal}
    />
  )}

  {relatedArticle && (
    <section class="section">
      <div class="container">
        <a href={`/articles/${relatedArticle.id}/`} class="related-article-card">
          <span class="related-article-card__title">{relatedArticle.data.title}</span>
          <span class="related-article-card__cta">
            Читать
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      </div>
    </section>
  )}
</BaseLayout>

<style>
/* ── Первый экран ── */
.product-page {
  padding-bottom: clamp(3rem, 5vw, 4rem);
}

/* H1 в DOM: «Межкомнатная дверь Урбан 3Т в покрытии Эмалекс» — тип товара
   и покрытие в заголовке нужны поиску (так и ищут: «эмалекс р1»).
   Визуально — название модели крупно, тип и покрытие тихой строкой ПОД ним
   (не надпись над заголовком). */
.product-title {
  display: flex;
  flex-wrap: wrap;
  column-gap: 0.3em;
  margin: 0;
  font-size: 1rem;
  font-weight: 400;
  line-height: 1.45;
  color: var(--color-fg-muted);
}
.product-title__name {
  order: -1;
  flex-basis: 100%;
  margin-bottom: 0.625rem;
  font-size: clamp(2rem, 3.6vw, 2.75rem);
  font-weight: 500;
  line-height: 1.05;
  letter-spacing: -0.03em;
  color: var(--color-ink);
}

/* ── Короткие факты: значение крупно, подпись под ним ── */
.product-details {
  margin-top: 2.5rem;
}
.product-facts {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
  gap: 1.25rem 1.5rem;
  margin: 0;
  padding-top: 1.5rem;
  border-top: 1px solid var(--color-border);
}
.product-facts__item {
  display: flex;
  flex-direction: column-reverse;
  gap: 0.25rem;
  min-width: 0;
}
.product-facts__item dt {
  font-size: 0.8125rem;
  color: var(--color-fg-muted);
}
.product-facts__item dd {
  margin: 0;
  font-size: 1rem;
  font-weight: 600;
  line-height: 1.3;
  color: var(--color-ink);
}
.product-facts__item dd a {
  color: inherit;
  text-decoration: underline;
  text-decoration-color: var(--color-border);
  text-underline-offset: 0.3em;
  transition: color 150ms var(--ease-out), text-decoration-color 150ms var(--ease-out);
}
.product-facts__item dd a:hover {
  color: var(--color-accent-hover);
  text-decoration-color: currentColor;
}

.product-coating-link {
  display: inline-block;
  margin-top: 1.75rem;
  font-size: 0.9375rem;
  font-weight: 500;
  color: var(--color-ink);
  text-decoration: underline;
  text-decoration-color: var(--color-border);
  text-underline-offset: 0.3em;
  transition: color 150ms var(--ease-out), text-decoration-color 150ms var(--ease-out);
}
.product-coating-link:hover {
  color: var(--color-accent-hover);
  text-decoration-color: currentColor;
}

/* ── Погонаж: открытые строки на линейках, без коробок ── */
.accessories-section {
  padding: clamp(2.5rem, 4vw, 4rem) 0;
}
.accessories-header {
  margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
}
.accessories-note {
  margin: 0.625rem 0 0;
  font-size: 0.9375rem;
  color: var(--color-fg-muted);
}

.accessories-groups {
  border-bottom: 1px solid var(--color-border);
}
.accessories-group {
  border-top: 1px solid var(--color-border);
}

.accessories-group__label {
  display: flex;
  align-items: baseline;
  gap: 1rem;
  padding: 1.25rem 0;
  cursor: pointer;
  user-select: none;
  list-style: none;
}
.accessories-group__label::-webkit-details-marker { display: none; }
.accessories-group__name {
  flex: 1;
  font-size: 1.125rem;
  font-weight: 500;
  color: var(--color-ink);
  transition: color 150ms var(--ease-out);
}
.accessories-group__label:hover .accessories-group__name { color: var(--color-accent-hover); }
.accessories-group__from {
  font-size: 0.9375rem;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--color-ink);
  white-space: nowrap;
}
.accessories-group__label::after {
  content: '';
  flex-shrink: 0;
  align-self: center;
  width: 0.5rem;
  height: 0.5rem;
  margin: 0 0.25rem 0.25rem 0.5rem;
  border-right: 1.5px solid currentColor;
  border-bottom: 1.5px solid currentColor;
  color: var(--color-fg-muted);
  transform: rotate(45deg);
  transition: transform 200ms var(--ease-out);
}
.accessories-group[open] > .accessories-group__label::after {
  transform: rotate(-135deg);
  margin-bottom: -0.25rem;
}

.accessories-list {
  list-style: none;
  margin: 0;
  padding: 0 0 1.25rem;
}
.accessories-item {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 0.25rem 1.5rem;
  align-items: baseline;
  padding: 0.75rem 0;
  font-size: 0.9375rem;
  line-height: 1.45;
}
.accessories-item + .accessories-item {
  border-top: 1px dashed var(--color-border);
}
.accessories-item__name {
  color: var(--color-body);
}
.accessories-item__price {
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--color-ink);
  white-space: nowrap;
  text-align: right;
}
.accessories-item__unit {
  font-weight: 400;
  color: var(--color-fg-muted);
}
.accessories-item__media {
  grid-column: 1 / -1;
  margin-top: 0.5rem;
  max-width: 26rem;
}
@media (max-width: 480px) {
  .accessories-item { grid-template-columns: 1fr; }
  .accessories-item__price { text-align: left; }
}

.accessories-group__note {
  margin: 0;
  padding: 0 0 1.5rem;
  max-width: 48rem;
  font-size: 0.875rem;
  line-height: 1.55;
  color: var(--color-fg-muted);
}

/* ── Related article ── */
.related-article-card {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1.25rem 1.5rem;
  border-radius: 1rem;
  border: 1px solid #e2e8f0;
  background: #f8fafc;
  text-decoration: none;
  transition: border-color 200ms ease, background-color 200ms ease;
}
.related-article-card:hover {
  border-color: #99f6e4;
  background: #f0fdfa;
}
.related-article-card__title {
  font-size: 1rem;
  font-weight: 500;
  color: #0f172a;
}
.related-article-card__cta {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  flex-shrink: 0;
  font-size: 0.875rem;
  font-weight: 600;
  color: #0d9488;
}
.related-article-card__cta svg {
  width: 0.875rem;
  height: 0.875rem;
}
</style>
