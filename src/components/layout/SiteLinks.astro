---
/**
 * Блок «Разделы сайта» над подвалом — серверный (в отличие от Header/Footer,
 * которые клиентские Vue-острова и в статическом HTML отсутствуют). Даёт
 * каждой странице прямые, видимые поисковику ссылки на все разделы и SEO-
 * лендинги. Данные — src/lib/site-links.ts.
 */
import { SITE_LINK_GROUPS } from '../../lib/site-links'
import { getPublishedArticles, newestFirst } from '../../lib/articles'

/* Свежие статьи в блоке — новая публикация получает ссылку с каждой страницы
   сайта в день выхода, не дожидаясь, пока её найдут через /articles/. */
const latest = newestFirst(await getPublishedArticles()).slice(0, 4)
---

<nav class="site-links" aria-label="Разделы сайта">
  <div class="container">
    <p class="site-links__title">Разделы сайта</p>
    <div class="site-links__grid">
      {SITE_LINK_GROUPS.map(group => (
        <div class="site-links__group">
          <p class="site-links__group-title">{group.title}</p>
          <ul class="site-links__list" role="list">
            {group.links.map(link => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
      {latest.length > 0 && (
        <div class="site-links__group">
          <p class="site-links__group-title">Новое в блоге</p>
          <ul class="site-links__list" role="list">
            {latest.map(article => (
              <li><a href={`/articles/${article.id}/`}>{article.data.seoTitle ?? article.data.title}</a></li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
</nav>

<style>
.site-links {
  border-top: 1px solid #e5e7eb;
  background: #f8fafc;
  padding-block: 2.5rem;
}
.site-links__title {
  margin: 0 0 1.5rem;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #475569;
}
.site-links__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1.75rem 1.5rem;
}
@media (min-width: 768px) {
  .site-links__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
@media (min-width: 1100px) {
  .site-links__grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
}
.site-links__group-title {
  margin: 0 0 0.625rem;
  font-size: 0.8125rem;
  font-weight: 600;
  color: #0f172a;
}
.site-links__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.125rem;
}
.site-links__list a {
  display: inline-block;
  padding-block: 0.1875rem;
  font-size: 0.8125rem;
  line-height: 1.45;
  color: #475569;
  text-decoration: none;
  transition: color 200ms ease;
}
.site-links__list a:hover { color: #0d9488; }
.site-links__list a:focus-visible {
  outline: 2px solid #14b8a6;
  outline-offset: 2px;
  border-radius: 2px;
}
</style>
