---
/**
 * src/components/layout/AnnouncementBanner.astro
 *
 * Разовое информационное объявление на весь сайт (сейчас: закрытие салона
 * 30-31 августа по техническим причинам). Сидит первым потомком <main> в
 * BaseLayout.astro — под фиксированной шапкой, в обычном потоке, без
 * координации с её position:fixed/--header-height.
 *
 * Скрывается сама по дате (ANNOUNCEMENT_END в скрипте ниже) — не показывается
 * даже на старой, не пересобранной после 1 сентября сборке. Когда
 * актуальность пройдёт: либо удали <AnnouncementBanner /> из BaseLayout.astro,
 * либо, если появится новое объявление, поменяй текст ниже + ANNOUNCEMENT_END
 * + STORAGE_KEY (ключ должен смениться, иначе у тех, кто закрыл старое
 * объявление, новое не покажется).
 */

const CONTACTS = [
  { name: 'ВКонтакте', url: 'https://vk.com/vfddoors74',              icon: '/svg/w_vk.svg' },
  { name: 'Telegram',  url: 'https://t.me/vfddoors74',                icon: '/svg/w_tg_logo.svg' },
  { name: 'Max',       url: 'https://max.ru/id452402308842_biz',      icon: '/svg/w_max.svg' },
]
---

<div id="announcement-banner" style="display:none">
  <div class="announcement-banner__inner">
    <span class="announcement-banner__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" width="18" height="18">
        <path d="M12 9v4M12 16.5h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
      </svg>
    </span>

    <p class="announcement-banner__text">
      <strong>30 и 31 августа салон не работает</strong> по техническим причинам.
      С 1 сентября — снова по обычному графику: Пн–Пт 10:00–20:00, Сб–Вс 10:00–18:00.
    </p>

    <span class="announcement-banner__contacts">
      <span class="announcement-banner__contacts-label">Онлайн-консультация:</span>
      <span class="announcement-banner__contacts-icons">
        {CONTACTS.map(c => (
          <a href={c.url} target="_blank" rel="noopener" aria-label={c.name} class="announcement-banner__contact">
            <img src={c.icon} alt="" width="16" height="16" loading="lazy" decoding="async" />
          </a>
        ))}
      </span>
    </span>

    <button type="button" id="announcement-banner-close" class="announcement-banner__close" aria-label="Закрыть объявление">
      <svg viewBox="0 0 16 16" fill="none" width="14" height="14" aria-hidden="true">
        <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
      </svg>
    </button>
  </div>
</div>

<style>
  .announcement-banner__inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    row-gap: 0.5rem;
    column-gap: 0.875rem;
    padding: 0.75rem clamp(1rem, 4vw, 2rem);
    background: #18181b;
    color: #fff;
  }
  .announcement-banner__icon {
    flex-shrink: 0;
    display: flex;
    color: var(--color-accent);
  }
  .announcement-banner__text {
    margin: 0;
    flex: 1;
    min-width: 15rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.75);
  }
  .announcement-banner__text strong {
    font-weight: 700;
    color: #fff;
  }

  .announcement-banner__contacts {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .announcement-banner__contacts-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.5);
    white-space: nowrap;
  }
  .announcement-banner__contacts-icons {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .announcement-banner__contact {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.08);
    transition: background-color 150ms ease;
  }
  .announcement-banner__contact:hover {
    background: var(--color-accent);
  }
  .announcement-banner__contact img {
    width: 1rem;
    height: 1rem;
  }

  .announcement-banner__close {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 9999px;
    border: none;
    background: transparent;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease;
  }
  .announcement-banner__close:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  @media (max-width: 640px) {
    .announcement-banner__text {
      font-size: 0.8125rem;
      min-width: 100%;
      order: 1;
    }
    .announcement-banner__icon {
      order: 0;
    }
    .announcement-banner__close {
      order: 2;
      margin-left: auto;
    }
    .announcement-banner__contacts {
      order: 3;
      width: 100%;
      padding-left: 1.75rem;
    }
  }
</style>

<script is:inline>
  (function () {
    var ANNOUNCEMENT_END = new Date('2026-09-01T00:00:00+05:00').getTime()
    var STORAGE_KEY = 'vfd-announcement-2026-08-30-dismissed'

    if (Date.now() >= ANNOUNCEMENT_END) return
    if (localStorage.getItem(STORAGE_KEY) === '1') return

    var banner = document.getElementById('announcement-banner')
    if (banner) banner.style.display = 'block'

    var closeBtn = document.getElementById('announcement-banner-close')
    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        localStorage.setItem(STORAGE_KEY, '1')
        if (banner) banner.style.display = 'none'
      })
    }
  })()
</script>
