---
/**
 * Карточка «Статья по теме» на странице каталога/раздела — перелинковка
 * раздел → блог (тот же вид, что на моделях и SEO-лендингах покрытий).
 * Статья ищется по слагу и показывается, только когда она опубликована
 * (src/lib/articles.ts): страница заранее ссылается на запланированную
 * статью, и карточка появится сама в день её выхода.
 *
 * asSection — обернуть в блоки .section/.container (отступы раздела); без
 * опубликованной статьи не выводится ничего, в том числе и отступов.
 */
import { getPublishedArticles } from '../../lib/articles'

interface Props {
  /** Слаги статей по порядку показа; не опубликованные пропускаются. */
  slugs: string[]
  eyebrow?: string
  asSection?: boolean
}

const { slugs, eyebrow = 'Статья по теме', asSection = false } = Astro.props
const published = await getPublishedArticles()
const articles = slugs
  .map(slug => published.find(a => a.id === slug))
  .filter((a): a is NonNullable<typeof a> => a !== undefined)
---

{articles.length > 0 && (
  <div class:list={[asSection && 'section']}>
    <div class:list={[asSection && 'container', 'related-article-list']}>
      {articles.map(article => (
        <a href={`/articles/${article.id}/`} class="related-article-card">
          <span class="related-article-card__eyebrow">{eyebrow}</span>
          <span class="related-article-card__title">{article.data.title}</span>
          <span class="related-article-card__cta">
            Читать
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
)}

<style>
.related-article-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.related-article-card {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1.25rem 1.5rem;
  border-radius: 1rem;
  border: 1px solid #e2e8f0;
  background: #f8fafc;
  text-decoration: none;
  transition: border-color 200ms ease, background-color 200ms ease;
}
.related-article-card:hover {
  border-color: #99f6e4;
  background: #f0fdfa;
}
.related-article-card__eyebrow {
  flex-basis: 100%;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.01em;
  color: #64748b;
}
.related-article-card__title {
  font-size: 1rem;
  font-weight: 500;
  color: #0f172a;
}
.related-article-card__cta {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  flex-shrink: 0;
  font-size: 0.875rem;
  font-weight: 600;
  color: #0d9488;
}
.related-article-card__cta svg {
  width: 0.875rem;
  height: 0.875rem;
}
</style>
