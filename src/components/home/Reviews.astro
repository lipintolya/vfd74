---
/**
 * «Отзывы клиентов» — лента отзывов с Яндекс Карт и 2ГИС. Данные —
 * src/data/reviews.ts. Используется на главной (h2) и на /reviews/ (h1).
 *
 * Лента, стрелки и последняя карточка — общие с «Фотоотчётами»: .rail
 * (global.css), RailControls, RailEndCard.
 *
 * Карточки одной высоты (по ряду ленты), без пустого низа: текст сверху,
 * автор с площадкой и датой прижат к низу — подпись под цитатой. Размер
 * текста зависит от длины: короткий отзыв — крупно, обычный — как текст,
 * длинный — обрезан по строкам, «Читать полностью» открывает весь текст
 * в нативном <dialog>. Без JS текст не обрезается и кнопка не видна.
 *
 * Статичный HTML (текст виден сразу), микроразметка Review сохранена.
 */
import SectionHeader from './SectionHeader.astro'
import RailControls from '../ui/RailControls.astro'
import RailEndCard from '../ui/RailEndCard.astro'
import { reviews, type ReviewPlatform } from '../../data/reviews'
import { pluralRu } from '../../lib/product-text'
import { typograph } from '../../lib/typograph'

interface Props {
  /** На /reviews/ заголовок страницы — h1, на главной — h2 */
  headingTag?: 'h1' | 'h2'
}
const { headingTag = 'h2' } = Astro.props

const PLATFORM: Record<ReviewPlatform, string> = {
  yandex: 'Яндекс Карты',
  '2gis': '2ГИС',
}

/* Пороги по длине текста (знаков): до SHORT — крупная цитата, после LONG —
   обрезка с «Читать полностью». Подобраны по данным: так карточки ряда
   выходят близкой высоты. */
const SHORT = 110
const LONG = 260
const sizeOf = (text: string) => (text.length <= SHORT ? 's' : text.length <= LONG ? 'm' : 'l')

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })

const sorted = [...reviews].sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''))
const total = reviews.length
const totalWord = pluralRu(total, ['отзыв', 'отзыва', 'отзывов'])

const lead = `${total} ${totalWord} с Яндекс Карт и 2ГИС — публикуем только верифицированные, с датами.`

const LINKS = [
  { label: '2ГИС', href: 'https://2gis.ru/chelyabinsk/search/ВФД%20Владимирская%20фабрика%20дверей%20Братьев%20Кашириных%20131Б' },
  { label: 'Яндекс Карты', href: 'https://yandex.ru/maps/?text=ВФД%20Владимирская%20фабрика%20дверей%20Челябинск%20Братьев%20Кашириных%20131Б' },
]
---

<section
  class="section bg-white rail-scope"
  aria-labelledby="reviews-heading"
  data-rail-scope
  data-rv-section
>
  <div class="container">

    <SectionHeader id="reviews-heading" title="Репутация, подтверждённая фактами" lead={lead} tag={headingTag}>
      <Fragment slot="actions">
        <RailControls
          prevLabel="Предыдущие отзывы"
          nextLabel="Следующие отзывы"
          allHref={headingTag === 'h1' ? undefined : '/reviews/'}
          allLabel="Все отзывы"
        />
      </Fragment>
    </SectionHeader>

    <ul
      class="rail rv-rail"
      role="list"
      aria-label="Отзывы клиентов"
      data-rail
      itemscope
      itemtype="https://schema.org/ItemList"
    >
      {sorted.map((r) => {
        const size = sizeOf(r.text)
        const meta = [PLATFORM[r.platform], r.date && fmtDate(r.date)].filter(Boolean).join(' · ')
        return (
          <li
            class="rv-card"
            data-rv-card
            data-rv-meta={meta}
            itemprop="itemListElement"
            itemscope
            itemtype="https://schema.org/Review"
          >
            <p class:list={['rv-text', `rv-text--${size}`]} itemprop="reviewBody" data-rv-text>
              {typograph(r.text)}
            </p>
            {size === 'l' && (
              <button type="button" class="rv-more" data-rv-more hidden>Читать полностью</button>
            )}

            <div class="rv-by">
              <p class="rv-name" itemprop="author" itemscope itemtype="https://schema.org/Person" data-rv-name>
                <span itemprop="name">{r.name}</span>
              </p>
              <p class="rv-src">
                {PLATFORM[r.platform]}
                {r.date && (
                  <>
                    <span class="rv-sep" aria-hidden="true">·</span>
                    <time datetime={r.date} itemprop="datePublished">{fmtDate(r.date)}</time>
                  </>
                )}
              </p>
            </div>

            <span class="rv-hidden" itemprop="itemReviewed" itemscope itemtype="https://schema.org/LocalBusiness">
              <meta itemprop="name" content="ВФД (Фирменный салон Владимирской фабрики дверей)" />
            </span>
            <span class="rv-hidden" itemprop="reviewRating" itemscope itemtype="https://schema.org/Rating">
              <meta itemprop="ratingValue" content="5" />
              <meta itemprop="bestRating" content="5" />
            </span>
          </li>
        )
      })}

      <li>
        <RailEndCard value={total} text={`${totalWord} на Яндекс Картах и 2ГИС — читайте все и оставляйте свои`} fit="row">
          {LINKS.map((l) => (
            <a href={l.href} target="_blank" rel="noopener">
              {l.label}
              <svg class="btn-arrow-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          ))}
        </RailEndCard>
      </li>
    </ul>

    <!-- Полный текст длинного отзыва — один диалог на секцию -->
    <dialog class="rv-dialog" data-rv-dialog aria-labelledby="rv-dialog-name">
      <p class="rv-dlg-text" data-rv-dlg-text></p>
      <div class="rv-by rv-dlg-by">
        <p class="rv-name" id="rv-dialog-name" data-rv-dlg-name></p>
        <p class="rv-src" data-rv-dlg-src></p>
      </div>
      <button type="button" class="btn btn-outline rv-dlg-close" data-rv-close>Закрыть</button>
    </dialog>

  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-rv-section]').forEach((section) => {
    const dlg = section.querySelector<HTMLDialogElement>('[data-rv-dialog]')
    const text = section.querySelector<HTMLElement>('[data-rv-dlg-text]')
    const name = section.querySelector<HTMLElement>('[data-rv-dlg-name]')
    const src = section.querySelector<HTMLElement>('[data-rv-dlg-src]')
    const close = section.querySelector<HTMLButtonElement>('[data-rv-close]')
    if (!dlg || !text || !name || !src || !close) return

    /* С JS длинные тексты обрезаются по строкам (стиль [data-rv-clamp]),
       а кнопка «Читать полностью» становится видна */
    section.dataset.rvClamp = ''
    section.querySelectorAll<HTMLButtonElement>('[data-rv-more]').forEach((btn) => {
      btn.hidden = false
      btn.addEventListener('click', () => {
        const card = btn.closest('[data-rv-card]')
        text.textContent = card?.querySelector('[data-rv-text]')?.textContent?.trim() ?? ''
        name.textContent = card?.querySelector('[data-rv-name]')?.textContent?.trim() ?? ''
        src.textContent = card instanceof HTMLElement ? card.dataset.rvMeta ?? '' : ''
        dlg.showModal()
      })
    })

    close.addEventListener('click', () => dlg.close())
    /* Клик по затемнению вокруг окна — закрыть */
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close() })
  })
</script>

<style>
  /* Колонки ленты .rail (global.css) */
  .rv-rail {
    --rail-col: 84%;
    --rail-col-md: 20rem;
    --rail-col-lg: 22rem;
  }

  /* ── Карточка: светлая плашка во всю высоту ряда; автор прижат к низу ── */
  .rv-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    height: 100%;
    padding: clamp(1.25rem, 2.2vw, 1.75rem);
    border-radius: 1.5rem;
    background: #f4f4f5;  /* zinc-100 */
  }

  .rv-text {
    margin: 0;
    color: #27272a;  /* zinc-800 */
    text-wrap: pretty;
  }
  /* Короткий отзыв — крупная цитата: заполняет карточку, а не тонет в ней */
  .rv-text--s {
    font-size: var(--text-step-4);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
  .rv-text--m,
  .rv-text--l {
    font-size: var(--text-step-2);
    line-height: 1.6;
  }
  /* Длинный — обрезка по строкам, только когда есть JS и кнопка */
  [data-rv-clamp] .rv-text--l {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 7;
    overflow: hidden;
  }

  .rv-more {
    align-self: flex-start;
    margin-top: -0.75rem;  /* ближе к тексту, чем gap карточки */
    padding: 0.25rem 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: var(--text-step-1);
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .rv-more:hover { color: #0f766e; }  /* teal-700 */
  .rv-more:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; border-radius: 2px; }

  /* Автор — внизу карточки, под тонкой линией; gap карточки держит
     минимальный отступ от текста, auto прижимает к низу */
  .rv-card .rv-by {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid #e4e4e7;  /* zinc-200 */
  }
  .rv-name {
    margin: 0;
    font-size: var(--text-step-1);
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-ink);
  }
  .rv-src {
    margin: 0.125rem 0 0;
    font-size: var(--text-step-0);
    line-height: 1.4;
    color: #52525b;  /* zinc-600 — на zinc-100 ≥ 6:1 */
  }
  .rv-sep { margin: 0 0.4em; color: #a1a1aa; }
  .rv-hidden { display: none; }

  /* ── Диалог «Читать полностью» ── */
  .rv-dialog {
    width: min(36rem, calc(100% - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border: 0;
    border-radius: 1.5rem;
    background: #fff;
    color: var(--color-ink);
    overflow-y: auto;
  }
  .rv-dialog::backdrop { background: rgb(9 9 11 / 0.6); }
  .rv-dlg-text {
    margin: 0;
    font-size: var(--text-step-2);
    line-height: 1.65;
    color: #27272a;
    white-space: pre-line;
  }
  .rv-dlg-by {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid #e4e4e7;
  }
  .rv-dlg-close {
    margin-top: 1.5rem;
    padding: 0.75rem 1.25rem;
    font-size: var(--text-step-1);
  }
</style>
