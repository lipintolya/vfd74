---
/**
 * «Отзывы клиентов» — лента отзывов с Яндекс Карт и 2ГИС. Данные —
 * src/data/reviews.ts. Используется на главной (h2) и на /reviews/ (h1).
 *
 * Лента и стрелки — общие с «Фотоотчётами»: .rail и RailControls.
 * Ссылки на площадки доступны под лентой без горизонтальной прокрутки.
 *
 * Карточки одной высоты (по ряду ленты), без пустого низа: текст сверху,
 * автор с датой прижат к низу — подпись под цитатой. Площадка — сверху.
 * Длинный отзыв обрезан по строкам, «Читать полностью» открывает весь текст
 * в нативном <dialog>. Без JS текст не обрезается и кнопка не видна.
 *
 * Статичный HTML (текст виден сразу), микроразметка Review сохранена.
 */
import SectionHeader from './SectionHeader.astro'
import Action from '../ui/Action.astro'
import RailControls from '../ui/RailControls.astro'
import { reviews, type ReviewPlatform } from '../../data/reviews'
import { pluralRu } from '../../lib/product-text'
import { typograph } from '../../lib/typograph'

interface Props {
  /** На /reviews/ заголовок страницы — h1, на главной — h2 */
  headingTag?: 'h1' | 'h2'
  /** Сколько отзывов показать (главная — 4, /reviews/ — все) */
  limit?: number
}
const { headingTag = 'h2', limit } = Astro.props

const PLATFORM: Record<ReviewPlatform, { label: string; logo: string; href: string }> = {
  yandex: {
    label: 'Яндекс Карты',
    logo: '/media/info/reviews/yandex_logo.svg',
    href: 'https://yandex.ru/maps/?text=ВФД%20Владимирская%20фабрика%20дверей%20Челябинск%20Братьев%20Кашириных%20131Б',
  },
  '2gis': {
    label: '2ГИС',
    logo: '/media/info/reviews/2gis_logo.svg',
    href: 'https://2gis.ru/chelyabinsk/search/ВФД%20Владимирская%20фабрика%20дверей%20Братьев%20Кашириных%20131Б',
  },
}

/* После LONG текст сокращается с доступом к полному отзыву в диалоге. */
const SHORT = 110
const LONG = 260
const sizeOf = (text: string) => (text.length <= SHORT ? 's' : text.length <= LONG ? 'm' : 'l')

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })

const sorted = [...reviews].sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''))
const shown = limit ? sorted.slice(0, limit) : sorted
const total = reviews.length
const totalWord = pluralRu(total, ['отзыв', 'отзыва', 'отзывов'])

const lead = 'О выборе дверей, работе салона и монтаже — словами наших клиентов.'

const LINKS = [PLATFORM['2gis'], PLATFORM.yandex]
---

<section
  class="section bg-white rail-scope"
  aria-labelledby="reviews-heading"
  data-rail-scope
  data-rv-section
>
  <div class="container">

    <SectionHeader id="reviews-heading" title="Репутация, подтверждённая фактами" lead={lead} tag={headingTag}>
      <Fragment slot="actions">
        <div class="rv-count"><strong>{total}</strong><span>{totalWord}<br />с Яндекс Карт и 2ГИС</span></div>
      </Fragment>
    </SectionHeader>

    <ul
      class="rail rv-rail"
      role="list"
      aria-label="Отзывы клиентов"
      data-rail
      itemscope
      itemtype="https://schema.org/ItemList"
    >
      {shown.map((r, index) => {
        const size = sizeOf(r.text)
        const meta = [PLATFORM[r.platform].label, r.date && fmtDate(r.date)].filter(Boolean).join(' · ')
        return (
          <li
            class:list={['rv-card', { 'rv-card--featured': index === 0 }]}
            data-rv-card
            data-rv-meta={meta}
            itemprop="itemListElement"
            itemscope
            itemtype="https://schema.org/Review"
          >
            <div class="rv-card-top">
              <span class="rv-quote" aria-hidden="true">“</span>
              <span class="rv-platform">
                <img class="rv-platform-logo" src={PLATFORM[r.platform].logo} width="24" height="24" alt="" loading="lazy" decoding="async" />
                {PLATFORM[r.platform].label}
              </span>
            </div>
            <p class:list={['rv-text', `rv-text--${size}`]} itemprop="reviewBody" data-rv-text>
              {typograph(r.text)}
            </p>
            {size === 'l' && (
              <Action variant={index === 0 ? 'text-inverse' : 'text'} class="rv-more" data-rv-more aria-label={`Читать полностью отзыв: ${r.name}`} aria-haspopup="dialog" hidden>Читать полностью</Action>
            )}

            <div class="rv-by">
              <span class="rv-avatar" aria-hidden="true">{r.name.trim().charAt(0)}</span>
              <div class="rv-author">
                <p class="rv-name" itemprop="author" itemscope itemtype="https://schema.org/Person" data-rv-name>
                  <span itemprop="name">{r.name}</span>
                </p>
                <p class="rv-src">
                  {r.date && (
                    <time datetime={r.date} itemprop="datePublished">{fmtDate(r.date)}</time>
                  )}
                </p>
              </div>
            </div>

            <span class="rv-hidden" itemprop="itemReviewed" itemscope itemtype="https://schema.org/LocalBusiness">
              <meta itemprop="name" content="ВФД (Фирменный салон Владимирской фабрики дверей)" />
            </span>
            <span class="rv-hidden" itemprop="reviewRating" itemscope itemtype="https://schema.org/Rating">
              <meta itemprop="ratingValue" content="5" />
              <meta itemprop="bestRating" content="5" />
            </span>
          </li>
        )
      })}

    </ul>

    <div class="rv-footer">
      <div class="rv-platforms">
        <p>Читайте на площадках и делитесь своим опытом</p>
        <div class="rv-platform-links">
          {LINKS.map((l) => (
            <Action href={l.href} variant="text" target="_blank" rel="noopener noreferrer">
              <img class="rv-platform-logo" src={l.logo} width="24" height="24" alt="" loading="lazy" decoding="async" />
              {l.label}
              <span class="sr-only"> (откроется в новой вкладке)</span>
            </Action>
          ))}
        </div>
      </div>
      <div class="rv-controls">
        <RailControls
          prevLabel="Предыдущие отзывы"
          nextLabel="Следующие отзывы"
          allHref={headingTag === 'h1' ? undefined : '/reviews/'}
          allLabel="Все отзывы"
        />
      </div>
    </div>

    <!-- Полный текст длинного отзыва — один диалог на секцию -->
    <dialog class="rv-dialog" data-rv-dialog aria-labelledby="rv-dialog-name">
      <p class="rv-dlg-text" data-rv-dlg-text></p>
      <div class="rv-by rv-dlg-by">
        <p class="rv-name" id="rv-dialog-name" data-rv-dlg-name></p>
        <p class="rv-src rv-dlg-source">
          <img class="rv-platform-logo" data-rv-dlg-logo width="24" height="24" alt="" hidden />
          <span data-rv-dlg-src></span>
        </p>
      </div>
      <button type="button" class="btn btn-outline rv-dlg-close" data-rv-close>Закрыть</button>
    </dialog>

  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-rv-section]').forEach((section) => {
    const dlg = section.querySelector<HTMLDialogElement>('[data-rv-dialog]')
    const text = section.querySelector<HTMLElement>('[data-rv-dlg-text]')
    const name = section.querySelector<HTMLElement>('[data-rv-dlg-name]')
    const src = section.querySelector<HTMLElement>('[data-rv-dlg-src]')
    const logo = section.querySelector<HTMLImageElement>('[data-rv-dlg-logo]')
    const close = section.querySelector<HTMLButtonElement>('[data-rv-close]')
    if (!dlg || !text || !name || !src || !close) return

    /* С JS длинные тексты обрезаются по строкам (стиль [data-rv-clamp]),
       а кнопка «Читать полностью» становится видна */
    section.dataset.rvClamp = ''
    section.querySelectorAll<HTMLButtonElement>('[data-rv-more]').forEach((btn) => {
      btn.hidden = false
      btn.addEventListener('click', () => {
        const card = btn.closest('[data-rv-card]')
        text.textContent = card?.querySelector('[data-rv-text]')?.textContent?.trim() ?? ''
        name.textContent = card?.querySelector('[data-rv-name]')?.textContent?.trim() ?? ''
        src.textContent = card instanceof HTMLElement ? card.dataset.rvMeta ?? '' : ''
        const cardLogo = card?.querySelector<HTMLImageElement>('.rv-platform-logo')
        if (logo && cardLogo) {
          logo.src = cardLogo.src
          logo.hidden = false
        }
        dlg.showModal()
      })
    })

    close.addEventListener('click', () => dlg.close())
    /* Закрываем только по клику за границами окна, не по его отступам. */
    dlg.addEventListener('click', (e) => {
      const rect = dlg.getBoundingClientRect()
      if (e.target === dlg && (e.clientX < rect.left || e.clientX > rect.right || e.clientY < rect.top || e.clientY > rect.bottom)) dlg.close()
    })
  })
</script>

<style>
  /* Колонки ленты .rail (global.css) */
  .rv-rail {
    --rail-col: 88%;
    --rail-col-md: 20rem;
    --rail-cols-lg: 2;
  }

  /* ── Карточка: светлая плашка во всю высоту ряда; автор прижат к низу ── */
  .rv-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    height: 100%;
    padding: clamp(1.25rem, 2.2vw, 1.75rem);
    border-radius: 1.5rem;
    background: #f4f4f5;
    border: 1px solid var(--color-border);
  }

  /* Один шрифт для всех отзывов: размер и вес не зависят от длины текста */
  .rv-text {
    margin: 0;
    font-size: var(--text-step-2);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-body);
    text-wrap: pretty;
  }
  /* Длинный — обрезка по строкам, только когда есть JS и кнопка */
  [data-rv-clamp] .rv-text--l {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 7;
    overflow: hidden;
  }

  .rv-more { align-self: flex-start; margin-top: -0.25rem; }

  /* Автор — внизу карточки, под тонкой линией; gap карточки держит
     минимальный отступ от текста, auto прижимает к низу */
  .rv-card .rv-by {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid #e4e4e7;  /* zinc-200 */
  }
  .rv-name {
    margin: 0;
    font-size: var(--text-step-1);
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-ink);
  }
  .rv-src {
    margin: 0.125rem 0 0;
    font-size: var(--text-step-0);
    line-height: 1.4;
    color: #52525b;  /* zinc-600 — на zinc-100 ≥ 6:1 */
  }
  .rv-count { display: flex; align-items: center; gap: 1rem; }
  .rv-count strong { font-size: var(--text-step-7); line-height: 1; font-weight: 500; letter-spacing: -0.04em; color: var(--color-ink); }
  .rv-count span { font-size: var(--text-step-1); line-height: 1.5; color: var(--color-body); }
  .rv-card-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .rv-quote { height: 2.5rem; font-family: Georgia, serif; font-size: 4.5rem; line-height: 1; color: var(--color-accent-hover); }
  .rv-platform { display: inline-flex; align-items: center; gap: 0.5rem; white-space: nowrap; padding: 0.375rem 0.75rem; border: 1px solid var(--color-border); border-radius: 999px; font-size: var(--text-step-0); font-weight: 600; color: var(--color-body); }
  .rv-platform-logo { display: block; width: 1.5rem; height: 1.5rem; flex-shrink: 0; object-fit: contain; border-radius: 0.5rem; }
  .rv-platform-logo[hidden] { display: none; }
  .rv-dlg-source { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem; }
  .rv-avatar { display: grid; place-items: center; flex: 0 0 2.75rem; height: 2.75rem; border-radius: 50%; background: var(--color-surface); color: var(--color-ink); font-weight: 600; }
  .rv-author { min-width: 0; overflow-wrap: anywhere; }
  .rv-card--featured { background: var(--color-graphite); border-color: var(--color-graphite); }
  .rv-card--featured .rv-text, .rv-card--featured .rv-name { color: #fff; }
  .rv-card--featured .rv-src { color: #d4d4d8; }
  .rv-card--featured .rv-quote { color: var(--color-accent); }
  .rv-card--featured .rv-platform { color: #fff; border-color: rgb(255 255 255 / 0.25); }
  .rv-card--featured .rv-by { border-color: rgb(255 255 255 / 0.2); }
  .rv-card--featured .rv-avatar { background: var(--color-graphite-card); color: var(--color-accent-light); }
  .rv-footer { display: flex; flex-direction: column; gap: 1.25rem; margin-top: 1.5rem; }
  .rv-platforms p { margin: 0; color: var(--color-body); font-size: var(--text-step-1); }
  .rv-platform-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .rv-controls { display: flex; align-items: center; flex-wrap: wrap; gap: 0.75rem; }
  @media (width >= 48rem) {
    .rv-footer { flex-direction: row; align-items: center; justify-content: space-between; gap: 2rem; }
  }
  @media (width >= 80rem) { .rv-rail { --rail-cols-lg: 4; } }
  .rv-hidden { display: none; }

  /* ── Диалог «Читать полностью» ── */
  .rv-dialog {
    margin: auto;
    width: min(36rem, calc(100% - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border: 0;
    border-radius: 1.5rem;
    background: #fff;
    color: var(--color-ink);
    overflow-y: auto;
  }
  .rv-dialog::backdrop { background: rgb(9 9 11 / 0.6); }
  .rv-dlg-text {
    margin: 0;
    font-size: var(--text-step-2);
    line-height: 1.65;
    color: #27272a;
    white-space: pre-line;
  }
  .rv-dlg-by {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid #e4e4e7;
  }
  .rv-dlg-close {
    margin-top: 1.5rem;
    padding: 0.75rem 1.25rem;
    font-size: var(--text-step-1);
  }
</style>
