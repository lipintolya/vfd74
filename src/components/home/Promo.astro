---
/**
 * Активные акции на главной. Данные и даты общие со страницей /akcii/.
 *
 * Секция использует системный графитовый фон. Одна актуальная акция
 * становится крупной промополосой; несколько акций собираются в спокойную
 * сетку. Истёкшие предложения отсекаются при сборке и повторно в браузере,
 * чтобы статическая страница не показывала их до следующего деплоя.
 */
import SectionHeader from './SectionHeader.astro'
import Action from '../ui/Action.astro'
import { PROMOS } from '../../data/promos'
import { isPromoActive, parseLocalDate } from '../../lib/promo-dates'
import { typograph } from '../../lib/typograph'

const SHOWN = 3
const active = PROMOS.filter((promo) => isPromoActive(promo.validUntil))

const minus = (text: string) => text.replace(/(^|\s)-(\d)/g, '$1−$2')
const until = (iso: string) =>
  parseLocalDate(iso).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long' })
---

{active.length > 0 && (
  <section
    id="promo"
    class="section promo-band bg-graphite"
    aria-labelledby="promo-heading"
    data-promo-section
  >
    <div class="container">
      <SectionHeader
        id="promo-heading"
        title="Акции и специальные предложения"
        lead="Действуют только в салоне ВФД на Кашириных."
        dark
      >
        <Fragment slot="actions">
          <Action href="/akcii/" variant="text-inverse">Смотреть все акции</Action>
        </Fragment>
      </SectionHeader>

      <ul
        class:list={['pm-list', { 'pm-list--single': active.length === 1 }]}
        role="list"
        aria-label="Действующие акции"
        data-promo-list
      >
        {active.map((promo, index) => (
          <li data-promo-until={promo.validUntil} hidden={index >= SHOWN}>
            <article class="pm-item">
              <div class="pm-photo">
                <img
                  src={promo.image}
                  srcset={promo.imageSrcset}
                  sizes={active.length === 1
                    ? '(min-width: 64rem) 56vw, 100vw'
                    : '(min-width: 64rem) 31vw, (min-width: 40rem) 46vw, 100vw'}
                  alt={promo.title}
                  width="800"
                  height="600"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="pm-content">
                <div class="pm-offer">
                  {promo.discount && <span class="pm-value">{minus(promo.discount)}</span>}
                  <time class="pm-until" datetime={promo.validUntil}>до {until(promo.validUntil)}</time>
                </div>
                <h3 class="t-h3 pm-title">{typograph(promo.title)}</h3>
                <p class="pm-text">
                  {typograph(minus(active.length === 1 ? promo.description : promo.subtitle))}
                </p>
                {promo.ctaText && (
                  <div class="pm-action">
                    <Action href={promo.ctaLink || '/akcii/'} variant="light">{promo.ctaText}</Action>
                  </div>
                )}
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<script>
  import { isPromoActive } from '../../lib/promo-dates'

  const SHOWN = 3
  document.querySelectorAll<HTMLElement>('[data-promo-section]').forEach((section) => {
    const list = section.querySelector<HTMLElement>('[data-promo-list]')
    const items = [...section.querySelectorAll<HTMLElement>('[data-promo-until]')]
    const alive = items.filter((item) => {
      const current = isPromoActive(item.dataset.promoUntil ?? '')
      if (!current) item.remove()
      return current
    })

    alive.forEach((item, index) => { item.hidden = index >= SHOWN })
    list?.classList.toggle('pm-list--single', alive.length === 1)
    if (!alive.length) section.hidden = true
  })
</script>

<style>
  .promo-band {
    padding-block: clamp(3rem, 5vw, 4.5rem);
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }

  .pm-list {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pm-item {
    display: grid;
    gap: 0;
    height: 100%;
    overflow: hidden;
    border-radius: 1.25rem;
    background: var(--color-graphite-card);
  }
  .pm-photo {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-graphite-card);
  }
  .pm-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }
  .pm-content {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.25rem;
  }
  .pm-offer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .pm-value {
    font-family: var(--font-display);
    font-size: var(--text-step-5);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }
  .pm-until {
    font-size: var(--text-step-1);
    color: rgb(255 255 255 / 0.62);
    white-space: nowrap;
  }
  .pm-title {
    margin: 1rem 0 0;
    color: #fff;
    text-wrap: balance;
  }
  .pm-text {
    max-width: 34rem;
    margin: 0.5rem 0 0;
    font-size: var(--text-step-1);
    line-height: 1.5;
    color: rgb(255 255 255 / 0.68);
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }
  .pm-action {
    display: flex;
    margin-top: 1.5rem;
  }

  /* Одна действующая акция — цельная кампанийная карточка, а не фото и
     текст, плавающие отдельно на большой тёмной секции. */
  .pm-list--single .pm-item {
    background: #ebe8e2;
  }
  .pm-list--single .pm-value,
  .pm-list--single .pm-title {
    color: var(--color-ink);
  }
  .pm-list--single .pm-until,
  .pm-list--single .pm-text {
    color: var(--color-body);
  }
  .pm-list--single .pm-action :global(.btn) {
    --btn-bg: var(--color-graphite);
    --btn-fg: #fff;
    --btn-line: var(--color-graphite);
    --btn-hover-bg: #3f3f46;
    --btn-hover-fg: #fff;
    --btn-disc: var(--color-accent-light);
    --btn-disc-fg: var(--color-graphite);
    --btn-focus: var(--color-accent-hover);
  }

  @media (width >= 40rem) {
    .pm-list:not(.pm-list--single) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pm-item { border-radius: 1.5rem; }
    .pm-content { padding: 1.75rem; }
    .pm-offer {
      flex-flow: row wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.75rem 1rem;
    }
  }
  @media (width >= 64rem) {
    .pm-list:not(.pm-list--single) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .pm-list--single .pm-item {
      grid-template-columns: minmax(20rem, 5fr) minmax(0, 7fr);
      min-height: 28rem;
    }
    .pm-list--single .pm-photo {
      grid-column: 2;
      grid-row: 1;
      min-height: 28rem;
      aspect-ratio: auto;
    }
    .pm-list--single .pm-content {
      grid-column: 1;
      grid-row: 1;
      justify-content: center;
      padding: clamp(2.5rem, 4vw, 4rem);
    }
    .pm-list--single .pm-action { margin-top: 2rem; }
  }

  @media (hover: hover) {
    .pm-item:hover .pm-photo img { transform: scale(1.025); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pm-photo img { transition: none; }
    .pm-item:hover .pm-photo img { transform: none; }
  }
</style>
