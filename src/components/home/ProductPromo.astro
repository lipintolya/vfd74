---
/**
 * Промо новинки на главной — один шаблон на все блоки (данные —
 * lib/home-promos.ts). Фото и текст рядом, без рамки-карточки: справа
 * статус, заголовок, одна-две фразы, короткие факты и цены крупно.
 *
 * Статичный HTML: текст виден сразу, без ожидания JS (раньше каждый блок
 * был целым Vue-островом и до гидрации стоял с opacity: 0). Островом
 * остаётся только слайдер фото — client:visible, первый кадр приходит
 * в серверной разметке.
 *
 * Читаемость: цифры — .t-price (Manrope 600, моноширинные цифры), подписи
 * над ними; факты — без разделителей-«таблицы»; контраст текста —
 * slate-600/800, не 400/500.
 */
import PhotoAutoplaySlider from '../ui/PhotoAutoplaySlider.vue'
import { rub } from '../../data/services'
import { typograph } from '../../lib/typograph'
import type { HomePromo } from '../../lib/home-promos'

type Props = HomePromo
const {
  id, status, title, lead, facts, stock, offer, prices, cta,
  images, alt, ratio = '4 / 3', reverse = false,
} = Astro.props

const headingId = `${id}-promo-heading`
/* Две колонки фактов — только для чётного числа коротких пунктов: иначе
   последний висит один или пункты рвутся на строки в узкой колонке */
const factCols = facts.length % 2 === 0 && facts.every((f) => f.length <= 24) ? 2 : 1
---

<section class="section bg-white" aria-labelledby={headingId}>
  <div class="container">
    <div class:list={['pp', { 'pp--reverse': reverse }]}>

      <div class="pp-media" style={`--pp-ratio:${ratio}`}>
        <PhotoAutoplaySlider
          client:visible
          images={images}
          alt={alt}
          responsive
          sizes="(max-width: 1023px) calc(100vw - 2rem), min(56vw, 44rem)"
        />
      </div>

      <div class="pp-body">
        <p class="t-eyebrow">{status}</p>
        <h2 id={headingId} class="t-h2 pp-title">{typograph(title)}</h2>
        <p class="pp-lead">{typograph(lead)}</p>

        {facts.length > 0 && (
          <ul class:list={['pp-facts', { 'pp-facts--2': factCols === 2 }]} role="list">
            {facts.map((f) => <li>{typograph(f)}</li>)}
          </ul>
        )}

        {(prices.length > 0 || stock || offer) && (
          <div class="pp-buy">
            {offer && <p class="pp-offer">{typograph(offer)}</p>}
            {stock && <p class="pp-stock">В наличии: {typograph(stock)}</p>}
            {prices.length > 0 && (
              <dl class="pp-prices">
                {prices.map((p) => (
                  <div>
                    <dt class="pp-price-label">
                      {p.label}
                      {p.old && <s class="pp-price-old">{rub(p.old)}</s>}
                    </dt>
                    <dd class="t-price pp-price">
                      {p.from && <span class="pp-from">от </span>}{rub(p.value)}
                    </dd>
                  </div>
                ))}
              </dl>
            )}
          </div>
        )}

        <a href={cta.href} class="btn btn-primary pp-cta">
          {cta.label}
          <svg class="btn-arrow-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .pp {
    display: grid;
    gap: 1.75rem;
  }

  /* Фото: на телефоне — пропорции кадра (у портретных моделей выше),
     с sm — общие 4:3, на десктопе — 5:4 рядом с текстом */
  .pp-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--pp-ratio);
    border-radius: 1.25rem;
    background: #f1f5f9;  /* slate-100 — место под кадр, пока он грузится */
  }
  @media (width >= 40rem) {
    .pp-media { aspect-ratio: 4 / 3; border-radius: 1.5rem; }
  }

  .pp-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .pp-title {
    margin: 0.625rem 0 0;
    text-wrap: balance;
  }
  .pp-lead {
    margin: 1rem 0 0;
    max-width: 34rem;
    font-size: var(--text-step-2);
    line-height: 1.6;
    color: #475569;  /* slate-600 — на белом 7.5:1 */
    text-wrap: pretty;
  }

  /* Факты — просто строки с коротким бирюзовым штрихом, без разделителей:
     линии между пунктами превращали блок в таблицу */
  .pp-facts {
    display: grid;
    gap: 0.625rem 2rem;
    width: 100%;
    max-width: 34rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (width >= 30rem) {
    .pp-facts--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .pp-facts li {
    display: flex;
    gap: 0.75rem;
    font-size: var(--text-step-1);
    line-height: 1.45;
    color: #1e293b;  /* slate-800 */
  }
  .pp-facts li::before {
    content: '';
    flex-shrink: 0;
    width: 0.75rem;
    height: 2px;
    margin-top: 0.66em;
    border-radius: 1px;
    background: var(--color-accent);
  }

  /* Покупка: что в наличии, цены крупно, подписи над цифрами */
  .pp-buy {
    width: 100%;
    max-width: 34rem;
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e2e8f0;  /* slate-200 */
  }
  .pp-offer,
  .pp-stock {
    margin: 0 0 1rem;
    font-size: var(--text-step-0);
    font-weight: 600;
    line-height: 1.4;
  }
  .pp-offer { color: #b91c1c; }  /* red-700 */
  .pp-stock { color: #0f766e; }  /* teal-700 — 13px на белом ≥ 4.5:1 */
  .pp-offer + .pp-stock { margin-top: -0.5rem; }

  .pp-prices {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem clamp(2rem, 4vw, 3rem);
    margin: 0;
  }
  .pp-price-label {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: var(--text-step-0);
    font-weight: 500;
    line-height: 1.3;
    color: #64748b;  /* slate-500 */
  }
  .pp-price-old {
    color: #94a3b8;
    font-variant-numeric: tabular-nums;
  }
  .pp-price { margin: 0.375rem 0 0; }
  .pp-from {
    font-size: 0.6em;
    font-weight: 500;
    letter-spacing: 0;
    color: #64748b;
  }

  /* Кнопка — системная .btn-primary, крупнее: главное действие блока.
     На телефоне во всю ширину — под большой палец. */
  .pp-cta {
    width: 100%;
    margin-top: 1.75rem;
    padding: 0.9375rem 1.5rem;
    font-size: var(--text-step-1);
    gap: 0.5rem;
  }
  .pp-cta:hover .btn-arrow-icon { transform: translateX(2px); }
  @media (width >= 30rem) {
    .pp-cta { width: auto; }
  }

  /* Десктоп: фото 7/12, текст 5/12 по центру высоты; блоки чередуют
     сторону фото — соседние промо не читаются копией друг друга */
  @media (width >= 64rem) {
    .pp {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2.5rem, 5vw, 4.5rem);
      align-items: center;
    }
    .pp-media { aspect-ratio: 5 / 4; }
    .pp--reverse { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .pp--reverse .pp-media { order: 2; }
  }
</style>
