---
/**
 * Промо новинки на главной — один шаблон на все блоки (данные —
 * lib/home-promos.ts). Фото и текст рядом, как в журнале: заголовок,
 * одна-две фразы живым текстом, цены, кнопка. Без надписей над заголовком,
 * без бейджей, без списка со штрихами и подписей над цифрами: статус и
 * свойства сказаны словами в тексте, у цены — «за полотно» той же строкой.
 *
 * Фото — острые углы (эксперимент: строгий, «архитектурный» край против
 * скруглённых карточек по сайту).
 *
 * Статичный HTML: текст виден сразу, без ожидания JS. Островом остаётся
 * только слайдер фото — client:visible, первый кадр приходит в серверной
 * разметке.
 */
import PhotoAutoplaySlider from '../ui/PhotoAutoplaySlider.vue'
import { rub } from '../../data/services'
import { typograph } from '../../lib/typograph'
import type { HomePromo } from '../../lib/home-promos'

type Props = HomePromo
const {
  id, title, text, stock, offer, prices, cta,
  images, alt, ratio = '4 / 3', reverse = false,
} = Astro.props

const headingId = `${id}-promo-heading`
---

<section class="section bg-white" aria-labelledby={headingId}>
  <div class="container">
    <div class:list={['pp', { 'pp--reverse': reverse }]}>

      <div class="pp-media" style={`--pp-ratio:${ratio}`}>
        <PhotoAutoplaySlider
          client:visible
          images={images}
          alt={alt}
          responsive
          sizes="(max-width: 1023px) calc(100vw - 2rem), min(56vw, 44rem)"
        />
      </div>

      <div class="pp-body">
        <h2 id={headingId} class="t-h2 pp-title">{typograph(title)}</h2>
        <p class="pp-text">{typograph(text)}</p>

        {offer && <p class="pp-offer">{typograph(offer)}</p>}

        {prices.length > 0 && (
          <ul class="pp-prices" role="list">
            {prices.map((p) => (
              <li class="pp-price">
                <span class="t-price">{p.from && 'от\u00a0'}{rub(p.value)}</span>
                {p.old && <s class="pp-old">{rub(p.old)}</s>}
                <span class="pp-per">{p.per}</span>
              </li>
            ))}
          </ul>
        )}

        {stock && <p class="pp-stock">{typograph(stock)}</p>}

        <a href={cta.href} class="btn btn-primary pp-cta">
          {cta.label}
          <svg class="btn-arrow-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .pp {
    display: grid;
    gap: 1.75rem;
  }

  /* Фото: на телефоне — пропорции кадра (у портретных моделей выше),
     с sm — 4:3, на десктопе — 5:4 рядом с текстом */
  .pp-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--pp-ratio);
    background: #f1f5f9;  /* slate-100 — место под кадр, пока он грузится */
  }
  @media (width >= 40rem) {
    .pp-media { aspect-ratio: 4 / 3; }
  }

  .pp-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .pp-title {
    margin: 0;
    text-wrap: balance;
  }
  .pp-text {
    margin: 1rem 0 0;
    max-width: 34rem;
    font-size: var(--text-step-2);
    line-height: 1.6;
    color: #475569;  /* slate-600 — на белом 7.5:1 */
    text-wrap: pretty;
  }

  .pp-offer {
    margin: 1.75rem 0 0;
    font-size: var(--text-step-1);
    font-weight: 600;
    color: #b91c1c;  /* red-700 */
  }

  /* Цена — цифра крупно и сразу за ней обычным текстом, что за эти
     деньги. Без подписи сверху: так читается как фраза, а не как поле
     формы. Цены всегда столбиком, как на ценнике: в строку две цены с «от»
     не влезали, и блоки выглядели по-разному. */
  .pp-prices {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .pp-offer + .pp-prices { margin-top: 0.75rem; }
  .pp-price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 0.5rem;
  }
  .pp-old {
    font-size: var(--text-step-1);
    font-variant-numeric: tabular-nums;
    color: #94a3b8;  /* slate-400 */
  }
  .pp-per {
    font-size: var(--text-step-1);
    color: #64748b;  /* slate-500 */
  }

  .pp-stock {
    margin: 0.75rem 0 0;
    font-size: var(--text-step-1);
    font-weight: 500;
    color: #0f766e;  /* teal-700 */
  }

  /* Кнопка — системная .btn-primary, крупнее: главное действие блока.
     На телефоне во всю ширину — под большой палец. */
  .pp-cta {
    width: 100%;
    margin-top: 2rem;
    padding: 0.9375rem 1.5rem;
    font-size: var(--text-step-1);
    gap: 0.5rem;
  }
  .pp-cta:hover .btn-arrow-icon { transform: translateX(2px); }
  @media (width >= 30rem) {
    .pp-cta { width: auto; }
  }

  /* Десктоп: фото 7/12, текст 5/12 по центру высоты; блоки чередуют
     сторону фото — соседние промо не читаются копией друг друга */
  @media (width >= 64rem) {
    .pp {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2.5rem, 5vw, 4.5rem);
      align-items: center;
    }
    .pp-media { aspect-ratio: 5 / 4; }
    .pp--reverse { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .pp--reverse .pp-media { order: 2; }
  }
</style>
