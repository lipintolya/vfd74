---
/**
 * Image-led feature for hidden doors on the home page.
 *
 * This section has one architectural scene and one action. Product facts and
 * prices still come from lib/home-promos.ts.
 */
import Action from '../ui/Action.astro'
import { rub } from '../../data/services'
import { typograph } from '../../lib/typograph'
import type { HomePromo, PromoPrice } from '../../lib/home-promos'

interface Props {
  item: HomePromo
}

const { item: p } = Astro.props

const money = (price: PromoPrice) => `${price.from ? 'от\u00a0' : ''}${rub(price.value)}`
/* The burgundy interior gives the section its own identity. The overlay is
   intentionally local and translucent so the room stays visible. */
const cover = p.image
const coverBase = cover?.startsWith('/renders/home/') ? cover.replace(/\.webp$/, '') : null
const coverSrcset = coverBase
  ? `${coverBase}-640.webp 640w, ${coverBase}-960.webp 960w, ${cover} 1300w`
  : undefined
const primaryPrice = p.kit ?? p.price
const leadSentences = typograph(p.text).split(/(?<=[.!?])\s+/)
const offerDetails = p.offer?.replace(/^Акция\s*/i, '')
---

{cover && (
  <section class="section hd-band" aria-labelledby="hidden-doors-heading">
    <div class="container">
      <div class="hd-stage">
        <img
          class="hd-image"
          src={cover}
          srcset={coverSrcset}
          sizes="(max-width: 1279px) calc(100vw - 2rem), 76rem"
          alt={p.alt}
          width="1300"
          height="732"
          loading="lazy"
          decoding="async"
        />
        <div class="hd-scrim" aria-hidden="true"></div>

        {p.offer && (
          <div class="hd-promo">
            <span class="hd-promo-title">Акция</span>
            {offerDetails && offerDetails !== p.offer && (
              <span class="hd-promo-details">{typograph(offerDetails)}</span>
            )}
          </div>
        )}

        <div class="hd-content">
          <div class="hd-copy">
            <h2 id="hidden-doors-heading" class="t-h2 hd-title">{typograph(p.title)}</h2>
            <p class="hd-lead">
              {leadSentences.map((sentence) => <span>{sentence}</span>)}
            </p>
          </div>

          <div class="hd-action-row">
            {primaryPrice && (
              <div class="hd-price-block">
                <p class="hd-price-label">
                  {p.kit ? `Комплект ${p.kit.includes}` : 'Полотно'}
                </p>
                <p class="hd-price">
                  <strong>{money(primaryPrice)}</strong>
                  {primaryPrice.old && <s>{rub(primaryPrice.old)}</s>}
                </p>
                {p.price && p.kit && (
                  <p class="hd-secondary-price">
                    Полотно {money(p.price)}
                    {p.price.old && <s>{rub(p.price.old)}</s>}
                  </p>
                )}
              </div>
            )}

            <Action href={p.cta.href} variant="light" class="hd-cta">
              {p.cta.label}
            </Action>
          </div>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .hd-stage {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: clamp(38rem, 72svh, 46rem);
    overflow: hidden;
    border-radius: 1.25rem;
    background: #4a2729;
    color: #fff;
    clip-path: inset(0 round 1.25rem);
  }
  .hd-image,
  .hd-scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hd-image {
    z-index: -2;
    object-fit: cover;
    object-position: 61% center;
    transition: transform 700ms var(--ease-out);
  }
  .hd-scrim {
    z-index: -1;
    background:
      linear-gradient(to top, rgb(9 9 11 / 0.76) 0%, rgb(9 9 11 / 0.36) 48%, rgb(9 9 11 / 0.02) 80%),
      linear-gradient(to right, rgb(9 9 11 / 0.16), transparent 76%);
  }
  .hd-content {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 100%;
    padding: clamp(1.25rem, 4vw, 3.5rem);
  }
  .hd-promo {
    position: absolute;
    inset-block-start: clamp(1.25rem, 3vw, 2.5rem);
    inset-inline-end: clamp(1.25rem, 3vw, 2.5rem);
    display: grid;
    justify-items: center;
    gap: 0.125rem;
    padding: 0.625rem 1.25rem;
    border-radius: 0;
    background: #fff;
  }
  .hd-promo-title {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    font-weight: 650;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #111;
  }
  .hd-promo-details {
    font-size: var(--text-step-0);
    font-weight: 600;
    line-height: 1.3;
    color: rgb(17 17 17 / 0.72);
  }
  .hd-copy {
    max-width: 42rem;
  }
  .hd-title {
    max-width: 13ch;
    margin: 0;
    color: #fff;
    text-wrap: balance;
  }
  .hd-lead {
    display: grid;
    max-width: 42rem;
    gap: 0.25rem;
    margin: 1rem 0 0;
    font-size: var(--text-step-2);
    line-height: 1.45;
    color: rgb(255 255 255 / 0.9);
    text-wrap: pretty;
  }
  .hd-lead span {
    display: block;
  }
  .hd-action-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    margin-top: clamp(1.5rem, 4vw, 2.25rem);
  }
  .hd-price-block {
    display: grid;
    gap: 0.375rem;
  }
  .hd-price-label,
  .hd-price,
  .hd-secondary-price {
    margin: 0;
  }
  .hd-price-label {
    font-size: var(--text-step-0);
    line-height: 1.4;
    color: rgb(255 255 255 / 0.66);
  }
  .hd-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
  }
  .hd-price strong {
    font-family: var(--font-display);
    font-size: var(--text-step-5);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.025em;
    font-variant-numeric: tabular-nums;
    color: #fff;
    white-space: nowrap;
  }
  .hd-price s,
  .hd-secondary-price s {
    color: rgb(255 255 255 / 0.5);
    font-variant-numeric: tabular-nums;
  }
  .hd-secondary-price {
    font-size: var(--text-step-0);
    line-height: 1.45;
    color: rgb(255 255 255 / 0.72);
  }
  .hd-secondary-price s {
    margin-inline-start: 0.375rem;
  }
  .hd-cta {
    width: 100%;
  }

  @media (width >= 40rem) {
    .hd-stage {
      min-height: clamp(38rem, 60vw, 44rem);
      border-radius: 1.5rem;
      clip-path: inset(0 round 1.5rem);
    }
    .hd-cta {
      width: auto;
    }
  }

  @media (width >= 64rem) {
    .hd-stage {
      min-height: clamp(38rem, 48vw, 43rem);
    }
    .hd-content {
      max-width: 56rem;
    }
    .hd-scrim {
      background:
        linear-gradient(to right, rgb(9 9 11 / 0.58) 0%, rgb(9 9 11 / 0.28) 44%, rgb(9 9 11 / 0.02) 72%),
        linear-gradient(to top, rgb(9 9 11 / 0.48) 0%, transparent 56%);
    }
  }

  @media (hover: hover) {
    .hd-stage:hover .hd-image,
    .hd-stage:focus-within .hd-image {
      transform: scale(1.025);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hd-image {
      transition: none;
    }
    .hd-stage:hover .hd-image,
    .hd-stage:focus-within .hd-image {
      transform: none;
    }
  }
</style>
