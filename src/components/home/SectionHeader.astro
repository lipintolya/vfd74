---
/**
 * Шапка секции главной: заголовок H2 слева, справа — одна фраза-лид (на
 * телефоне — под заголовком). Один вид у «Официального салона ВФД»,
 * «Каталога» и т. д.; «Как мы работаем» — тот же расклад на тёмной полосе.
 *
 * Слот `actions` (кнопки, стрелки ленты): тогда лид встаёт под заголовок
 * слева, а справа — действия.
 * Тексты проходят через typograph(): без висящих предлогов.
 * dark — шапка на тёмной полосе (белый заголовок, приглушённый лид).
 */
import { typograph } from '../../lib/typograph'

interface Props {
  /** id заголовка — для aria-labelledby секции */
  id:    string
  title: string
  lead?: string
  /** h1 — только когда секция на странице единственная главная (/reviews/) */
  tag?:  'h1' | 'h2'
  dark?: boolean
}
const { id, title, lead, tag = 'h2', dark = false } = Astro.props
const Heading = tag
const hasActions = Astro.slots.has('actions')
---

<header class:list={['sh', { 'sh--actions': hasActions, 'sh--dark': dark }]}>
  {hasActions ? (
    <div class="sh-main">
      <Heading id={id} class={tag === 'h1' ? 't-h1 sh-title' : 't-h2 sh-title'}>{typograph(title)}</Heading>
      {lead && <p class="t-lead sh-lead">{typograph(lead)}</p>}
    </div>
  ) : (
    <>
      <Heading id={id} class={tag === 'h1' ? 't-h1 sh-title' : 't-h2 sh-title'}>{typograph(title)}</Heading>
      {lead && <p class="t-lead sh-lead">{typograph(lead)}</p>}
    </>
  )}
  {hasActions && <div class="sh-actions"><slot name="actions" /></div>}
</header>

<style>
  .sh {
    display: grid;
    gap: 0.75rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  @media (width >= 64rem) {
    .sh {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      gap: 2rem;
    }
  }
  .sh-title { margin: 0; text-wrap: balance; }
  .sh-lead {
    margin: 0;
    max-width: 30rem;
    color: #475569;  /* slate-600 */
    text-wrap: pretty;
  }
  @media (width >= 64rem) {
    .sh:not(.sh--actions) .sh-lead { justify-self: end; }
  }

  .sh--dark .sh-title { color: #fff; }
  .sh--dark .sh-lead { color: rgb(255 255 255 / 0.6); }

  /* С действиями: заголовок и лид слева столбиком, действия справа */
  .sh--actions .sh-main {
    display: grid;
    gap: 0.75rem;
  }
  .sh--actions .sh-lead { max-width: 36rem; }
  .sh-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  @media (width >= 48rem) {
    .sh--actions {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 2rem;
    }
  }
</style>
