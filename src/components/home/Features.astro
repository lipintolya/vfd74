---
/**
 * «Официальный салон ВФД» на главной — по референсу пользователя: фото
 * и две плитки, три карточки одной высоты в ряд.
 *   1) тёмная фото-карточка выставочного зала: заголовок сверху, крупная
 *      цифра внизу слева, круглая кнопка маршрута внизу справа;
 *   2–3) графитовые плитки (--color-graphite — как у полосы замера и «Как
 *      мы работаем»): заголовок сверху, текст прижат к низу. Без значков.
 * Факты — с сайта: 60+ моделей (выставка), год основания — contacts-data.ts,
 * гарантия на монтаж 1 год — FAQ, расчёт за 30 минут — полоса «Бесплатный
 * замер».
 *
 * Статичный HTML; появление на телефоне и планшете — lib/tile-reveal.ts.
 */
import SectionHeader from './SectionHeader.astro'
import { companyLegalInfo } from '../../lib/contacts-data'
import { typograph } from '../../lib/typograph'

const { activity } = companyLegalInfo

const TILES = [
  {
    title: 'Замер и монтаж своей бригадой',
    text:  `Консультация, замер, доставка и установка — одна команда с ${activity.founded} года. Стоимость рассчитаем в течение 30 минут после замера.`,
  },
  {
    title: 'Гарантия на монтаж 1 год',
    text:  'На двери и перегородки — гарантия производителя. Если что-то потребует внимания, обращайтесь напрямую в салон.',
  },
]
---

<section class="section bg-white" aria-labelledby="features-heading">
  <div class="container">

    <SectionHeader
      id="features-heading"
      title="Официальный салон ВФД в Челябинске"
      lead="Двери прямо с фабрики, без посредников — выбирайте вживую в выставочном зале."
    />

    <div class="fx" data-tile-reveal>

      <!-- 1. Выставочный зал — тёмная фото-карточка -->
      <article class="fx-card fx-card--photo" data-reveal-tile>
        <img
          class="fx-img"
          data-reveal-img
          src="/renders/home/features-showroom-1000.webp"
          srcset="/renders/home/features-showroom-600.webp 600w, /renders/home/features-showroom-1000.webp 1000w"
          sizes="(min-width: 48rem) 34vw, calc(100vw - 2rem)"
          width="1000"
          height="1333"
          alt="Выставочный зал салона ВФД: межкомнатные двери и стенд с фурнитурой"
          loading="lazy"
          decoding="async"
        />
        <div class="fx-photo-body" data-reveal-body>
          <h3 class="fx-photo-title">{typograph('Выставочный зал на Кашириных')}</h3>
          <p class="fx-metric">
            <span class="fx-metric-label">Моделей в зале</span>
            <span class="fx-metric-value">60+</span>
          </p>
          <a
            class="fx-route"
            href="https://yandex.ru/maps/-/CPTwZPi-"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Построить маршрут до салона (откроется в новой вкладке)"
          >
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </article>

      <!-- 2–3. Графитовые плитки -->
      {TILES.map((t) => (
        <article class="fx-card fx-card--dark" data-reveal-tile>
          <div class="fx-tile-body" data-reveal-body>
            <h3 class="fx-tile-title">{typograph(t.title)}</h3>
            <p class="fx-tile-text">{typograph(t.text)}</p>
          </div>
        </article>
      ))}

    </div>
  </div>
</section>

<script>
  import { revealTiles } from '../../lib/tile-reveal'
  revealTiles()
</script>

<style>
  /* Три карточки одной высоты: стопкой на телефоне, в ряд с md */
  .fx {
    display: grid;
    gap: 1rem;
  }
  @media (width >= 48rem) {
    .fx {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1rem, 1.6vw, 1.25rem);
    }
  }

  .fx-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 1.5rem;
  }
  @media (width >= 48rem) {
    .fx-card { min-height: clamp(20rem, 30vw, 25rem); }
  }

  /* ── 1. Фото-карточка ── */
  .fx-card--photo {
    aspect-ratio: 4 / 5;
    background: #27272a;  /* zinc-800 — пока грузится фото */
    color: #fff;
  }
  @media (width >= 48rem) {
    .fx-card--photo { aspect-ratio: auto; }
  }
  .fx-img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }
  /* Затемнение сверху и снизу — под заголовок и цифру */
  .fx-card--photo::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, rgb(0 0 0 / 0.55) 0%, rgb(0 0 0 / 0) 38%),
      linear-gradient(to top,    rgb(0 0 0 / 0.65) 0%, rgb(0 0 0 / 0) 42%);
  }
  .fx-photo-body {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto 1fr;
    height: 100%;
    padding: clamp(1.25rem, 2.2vw, 1.75rem);
  }
  .fx-photo-title {
    grid-column: 1 / -1;
    margin: 0;
    max-width: 14ch;
    font-size: var(--text-step-4);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #fff;
    text-wrap: balance;
  }
  .fx-metric {
    align-self: end;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
  }
  .fx-metric-label {
    font-size: var(--text-step-1);
    color: rgb(255 255 255 / 0.8);
  }
  .fx-metric-value {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5vw, 4rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  /* Круглая кнопка маршрута — на месте «датчика» референса; вся карточка
     кликабельна (::after) */
  .fx-route {
    align-self: end;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 999px;
    background: #fff;
    color: var(--color-fg);
    transition: transform var(--duration-base) var(--ease-out);
  }
  .fx-route svg { width: 1.125rem; height: 1.125rem; }
  .fx-route::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .fx-route:focus-visible { outline: none; }
  .fx-card--photo:has(.fx-route:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* ── 2–3. Графитовые плитки — тот же тон, что у тёмных полос сайта ── */
  .fx-card--dark {
    background: var(--color-graphite);
    color: #fff;
  }
  .fx-tile-body {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(1.25rem, 2.2vw, 1.75rem);
  }
  .fx-tile-title {
    margin: 0;
    max-width: 16ch;
    font-size: var(--text-step-4);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  /* Текст прижат к низу плитки */
  .fx-tile-text {
    margin: auto 0 0;
    padding-top: 2rem;
    font-size: var(--text-step-1);
    line-height: 1.55;
    color: rgb(255 255 255 / 0.68);
    text-wrap: pretty;
  }

  /* Планшет: три узкие колонки — заголовки на ступень меньше */
  @media (48rem <= width < 64rem) {
    .fx-photo-title, .fx-tile-title { font-size: var(--text-step-3); max-width: none; }
  }

  @media (hover: hover) {
    .fx-card--photo:hover .fx-img { transform: scale(1.03); }
    .fx-card--photo:hover .fx-route { transform: rotate(45deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .fx-img, .fx-route { transition: none; }
    .fx-card--photo:hover .fx-img, .fx-card--photo:hover .fx-route { transform: none; }
  }
</style>
