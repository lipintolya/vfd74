---
/**
 * «Официальный салон ВФД» на главной — одна цельная сцена вместо мозаики
 * плиток: слева высокое фото выставочного зала, справа крупный заголовок,
 * фраза, четыре факта крупными цифрами на тонкой линейке (язык «Как мы
 * работаем»), адрес с часами и два действия — маршрут и звонок.
 *
 * Факты — только с сайта: 60+ моделей (выставка), год основания, адрес,
 * часы и телефон — contacts-data.ts, гарантия на монтаж 1 год — FAQ и
 * «Как мы работаем», расчёт за 30 минут — полоса «Бесплатный замер».
 *
 * Статичный HTML без JS. Фото — ресайзы 600/1000 из public/media/about_page
 * (scripts/gen-home-images.mjs features-).
 */
import { companyLegalInfo } from '../../lib/contacts-data'
import { typograph } from '../../lib/typograph'

const { activity, address, workingHours, contacts } = companyLegalInfo
const phone = contacts.phone[0]!
/* «г. Челябинск, ул. …» — город уже в заголовке; «Вход со стороны…» —
   продолжение строки, со строчной (только первая буква) */
const street = address.legal.replace(/^г\.\s*Челябинск,\s*/, '')
const entrance = address.entrance.charAt(0).toLowerCase() + address.entrance.slice(1)

const NBSP = '\u00a0'
const FACTS = [
  { value: '60+',                         text: 'моделей дверей в выставочном зале' },
  { value: `с${NBSP}${activity.founded}`, text: 'работаем в Челябинске' },
  { value: `1${NBSP}год`,                 text: 'гарантия на монтаж' },
  { value: `30${NBSP}мин`,                text: 'на расчёт стоимости после замера' },
]
---

<section class="section bg-white" aria-labelledby="features-heading">
  <div class="container fs">

    <figure class="fs-photo">
      <img
        src="/renders/home/features-showroom-1000.webp"
        srcset="/renders/home/features-showroom-600.webp 600w, /renders/home/features-showroom-1000.webp 1000w"
        sizes="(min-width: 64rem) 40vw, calc(100vw - 2rem)"
        width="1000"
        height="1333"
        alt="Выставочный зал салона ВФД: межкомнатные двери и стенд с фурнитурой"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="fs-body">
      <h2 id="features-heading" class="t-h2 fs-title">{typograph('Официальный салон ВФД в Челябинске')}</h2>
      <p class="t-lead fs-lead">
        {typograph('Двери прямо с фабрики, без посредников. Выбирайте вживую в выставочном зале — замер и монтаж сделаем своей бригадой.')}
      </p>

      <dl class="fs-facts">
        {FACTS.map((f) => (
          <div class="fs-fact">
            <dt class="fs-value">{f.value}</dt>
            <dd class="fs-text">{typograph(f.text)}</dd>
          </div>
        ))}
      </dl>

      <p class="fs-visit">
        <span class="fs-street">{typograph(`${street}, ${entrance}`)}</span>
        <span class="fs-hours">{workingHours.shortDisplay}</span>
      </p>

      <div class="fs-actions">
        <a
          href="https://yandex.ru/maps/-/CPTwZPi-"
          class="btn btn-primary fs-btn"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Построить маршрут до салона (откроется в новой вкладке)"
        >
          Построить маршрут
          <svg class="btn-arrow-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href={`tel:${phone.raw}`} class="btn btn-outline fs-btn fs-phone">
          {phone.label}
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  /* Телефон: фото, под ним текст. С lg — фото 5/12 слева, текст 7/12
     по центру высоты */
  .fs {
    display: grid;
    gap: 2rem;
  }
  @media (width >= 64rem) {
    .fs {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: center;
    }
  }

  .fs-photo {
    margin: 0;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 1.25rem;
    background: #f4f4f5;  /* zinc-100 — место под кадр, пока он грузится */
  }
  @media (width >= 40rem) {
    .fs-photo { border-radius: 1.5rem; }
  }
  @media (width >= 40rem) and (width < 64rem) {
    .fs-photo { aspect-ratio: 16 / 10; }  /* планшет: широкий кадр над текстом */
  }
  .fs-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
  }

  /* Заголовок — крупнее обычного .t-h2: главный тезис секции */
  .fs-title {
    margin: 0;
    font-size: var(--text-step-6);
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .fs-lead {
    margin: 1.25rem 0 0;
    max-width: 34rem;
    color: #475569;  /* slate-600 */
    text-wrap: pretty;
  }

  /* Факты 2×2: цифра крупно, подпись под ней; тонкая линия сверху */
  .fs-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem clamp(1.25rem, 3vw, 2.5rem);
    margin: clamp(2rem, 4vw, 2.75rem) 0 0;
  }
  .fs-fact {
    padding-top: 1rem;
    border-top: 1px solid #e4e4e7;  /* zinc-200 */
  }
  .fs-value {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.2vw, 3.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.035em;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
    white-space: nowrap;
  }
  .fs-text {
    margin: 0.5rem 0 0;
    font-size: var(--text-step-1);
    line-height: 1.45;
    color: #52525b;  /* zinc-600 */
  }

  /* Адрес и часы — две строки над кнопками */
  .fs-visit {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: clamp(2rem, 4vw, 2.75rem) 0 0;
    font-size: var(--text-step-1);
    line-height: 1.5;
  }
  .fs-street { color: var(--color-ink); font-weight: 500; }
  .fs-hours  { color: #52525b; }

  .fs-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  /* Кнопки — системные .btn-primary/.btn-outline, крупнее; на телефоне —
     во всю ширину одна под другой */
  .fs-btn {
    padding: 0.9375rem 1.5rem;
    font-size: var(--text-step-1);
    gap: 0.5rem;
  }
  .fs-phone { font-variant-numeric: tabular-nums; }
  .fs-btn:hover .btn-arrow-icon { transform: translateX(2px); }
  @media (width < 30rem) {
    .fs-btn { width: 100%; }
  }
</style>
