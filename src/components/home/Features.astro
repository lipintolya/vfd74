---
/**
 * «Официальный салон ВФД» на главной — редакционный бенто из трёх плиток
 * разного веса вместо трёх одинаковых карточек:
 *   - большая плитка-фото выставочного зала с текстом поверх: «60+ моделей…»;
 *   - фасад: широкое фото, текст на светлой панели под ним — на самом фото
 *     вывеска и надписи на окнах, текст поверх с ними сливался;
 *   - графитовая плитка: «С 2014 года… своей бригадой».
 * Три разные поверхности (фото / светлая / графит) — плитки не одинаковые.
 * Цифра — начало заголовка («60+ моделей дверей…»), а не надпись над ним.
 * Каждая плитка — одна ссылка на всю площадь (растянутый ::after у <a>).
 *
 * Появление на телефоне и планшете (до lg, где плитки стопкой): каждая
 * плитка проявляется, когда доходит до экрана, — подъём на 1.5rem и
 * opacity, фото внутри «оседает» с scale 1.08, текст следом с шагом.
 * Плитки, вошедшие в экран вместе (две рядом на планшете), — с шагом 90 мс.
 * Только opacity/translate/scale — раскладка не пересчитывается. Без JS,
 * при prefers-reduced-motion, на десктопе (бенто виден целиком) и для
 * плиток, уже видимых при загрузке, — без анимации.
 *
 * Разметка статичная. Фото — ресайзы 600/1000 и 768/1400 из
 * public/media/about_page (scripts/gen-home-images.mjs features-), lazy.
 */
import { typograph } from '../../lib/typograph'
---

<section class="section bg-white" aria-labelledby="features-heading">
  <div class="container">

    <header class="ft-head">
      <h2 id="features-heading" class="t-h2 ft-h2">Официальный салон ВФД в&nbsp;Челябинске</h2>
      <p class="t-lead ft-lead">
        Двери с фабрики, большая выставка и монтаж своей бригадой — в&nbsp;одном месте.
      </p>
    </header>

    <div class="ft-bento" data-ft-reveal>

      <!-- Выставочный зал — главная плитка -->
      <article class="ft-tile ft-tile--hall">
        <img
          class="ft-img"
          src="/renders/home/features-showroom-1000.webp"
          srcset="/renders/home/features-showroom-600.webp 600w, /renders/home/features-showroom-1000.webp 1000w"
          sizes="(min-width: 64rem) 42vw, calc(100vw - 2rem)"
          width="1000"
          height="1333"
          alt="Выставочный зал салона ВФД: межкомнатные двери и стенд с фурнитурой"
          loading="lazy"
          decoding="async"
        />
        <div class="ft-body">
          <h3 class="ft-title">
            <span class="ft-num">60+</span>
            {typograph('моделей дверей в выставочном зале')}
          </h3>
          <p class="ft-text">{typograph('Братьев Кашириных, 131Б — сравните вживую, а не по фото.')}</p>
          <a
            class="ft-link"
            href="https://yandex.ru/maps/-/CPTwZPi-"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Построить маршрут до салона (откроется в новой вкладке)"
          >
            Построить маршрут
            <svg class="btn-arrow-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </article>

      <!-- Фасад — двери с фабрики -->
      <article class="ft-tile ft-tile--facade">
        <img
          class="ft-img"
          src="/renders/home/features-facade-1400.webp"
          srcset="/renders/home/features-facade-768.webp 768w, /renders/home/features-facade-1400.webp 1400w"
          sizes="(min-width: 64rem) 58vw, (min-width: 40rem) 50vw, calc(100vw - 2rem)"
          width="1400"
          height="933"
          alt="Салон ВФД на Братьев Кашириных, 131Б — вывеска «Двери прямо с фабрики»"
          loading="lazy"
          decoding="async"
        />
        <div class="ft-body">
          <h3 class="ft-title ft-title--plain">{typograph('Двери напрямую с фабрики')}</h3>
          <p class="ft-text">{typograph('Официальный дилер Владимирской фабрики дверей — без посредников и переплат.')}</p>
          <a class="ft-link" href="/catalog/">
            Каталог дверей
            <svg class="btn-arrow-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </article>

      <!-- Монтаж — графит, без фото -->
      <article class="ft-tile ft-tile--dark">
        <div class="ft-body">
          <h3 class="ft-title">
            <span class="ft-num">С&nbsp;2014</span>
            {typograph('года замеряем и монтируем своей бригадой')}
          </h3>
          <p class="ft-text">{typograph('Консультация, замер, доставка и установка — одна команда, без субподряда.')}</p>
          <a class="ft-link" href="/portfolio/">
            Фотоотчёты с объектов
            <svg class="btn-arrow-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </article>

    </div>
  </div>
</section>

<style>
  /* Шапка — как у «Как мы работаем»: заголовок слева, лид справа */
  .ft-head {
    display: grid;
    gap: 0.75rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  @media (width >= 64rem) {
    .ft-head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      gap: 2rem;
    }
  }
  .ft-h2 { margin: 0; text-wrap: balance; }
  .ft-lead {
    margin: 0;
    max-width: 30rem;
    color: #475569;  /* slate-600 */
    text-wrap: pretty;
  }
  @media (width >= 64rem) {
    .ft-lead { justify-self: end; }
  }

  /* ── Сетка: телефон — плитки одна под другой; планшет — зал во всю
     ширину, фасад и монтаж рядом; с lg — бенто: зал слева на две строки,
     фасад и монтаж справа друг над другом (высоты — по содержимому) ── */
  .ft-bento {
    display: grid;
    gap: 1rem;
  }
  @media (width >= 40rem) {
    .ft-bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ft-tile--hall { grid-column: 1 / -1; }
  }
  @media (width >= 64rem) {
    .ft-bento {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 1.5rem;
    }
    .ft-tile--hall { grid-column: auto; grid-row: span 2; }
  }

  .ft-tile {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    border-radius: 1.25rem;
  }
  @media (width >= 40rem) {
    .ft-tile { border-radius: 1.5rem; }
  }

  /* Зал: фото на всю плитку, текст поверх на затемнении снизу */
  .ft-tile--hall {
    aspect-ratio: 4 / 5;
    background: #27272a;  /* zinc-800 — пока грузится фото */
    color: #fff;
  }
  @media (width >= 40rem) { .ft-tile--hall { aspect-ratio: 16 / 10; } }
  @media (width >= 64rem) { .ft-tile--hall { aspect-ratio: auto; } }
  .ft-tile--hall .ft-img {
    position: absolute;
    inset: 0;
    z-index: -2;
    height: 100%;
  }
  .ft-tile--hall::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(0 0 0 / 0.78) 0%, rgb(0 0 0 / 0.35) 45%, rgb(0 0 0 / 0) 75%);
  }

  .ft-img {
    display: block;
    width: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }

  /* Фасад: широкое фото (вывеска целиком) и светлая панель с текстом */
  .ft-tile--facade {
    justify-content: flex-start;
    background: #f4f4f5;  /* zinc-100 */
    color: var(--color-ink);
  }
  .ft-tile--facade .ft-img {
    aspect-ratio: 16 / 9;
    object-position: center 30%;
    background: #e4e4e7;  /* zinc-200 — пока грузится фото */
  }
  @media (width >= 64rem) {
    .ft-tile--facade .ft-img { aspect-ratio: 21 / 9; }
  }

  .ft-tile--dark {
    background: var(--color-graphite);
    color: #fff;
  }

  .ft-body {
    padding: clamp(1.25rem, 2.5vw, 2rem);
  }

  /* Заголовок плитки: цифра крупно — начало фразы, дальше обычным h3 */
  .ft-title {
    margin: 0;
    font-size: var(--text-step-4);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: inherit;
    text-wrap: balance;
  }
  .ft-num {
    display: block;
    margin-bottom: 0.25rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 6.5vw, 5rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ft-text {
    margin: 0.625rem 0 0;
    max-width: 30rem;
    font-size: var(--text-step-1);
    line-height: 1.55;
    color: rgb(255 255 255 / 0.78);
    text-wrap: pretty;
  }
  .ft-tile--facade .ft-text { color: #52525b; }  /* zinc-600 — на zinc-100 7:1 */

  /* Ссылка — вся плитка: ::after растянут на неё */
  .ft-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1rem;
    font-size: var(--text-step-1);
    font-weight: 600;
    color: inherit;
    text-decoration: none;
  }
  .ft-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .ft-link:focus-visible { outline: none; }
  .ft-tile:has(.ft-link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* Наведение: фото чуть приближается, стрелка сдвигается — только мышью */
  @media (hover: hover) {
    .ft-tile:hover .ft-img { transform: scale(1.03); }
    .ft-tile:hover .btn-arrow-icon { transform: translateX(3px); }
  }

  /* ── Появление (data-state ставит скрипт, только на телефоне/планшете).
     Масштаб фото — отдельным свойством scale, не transform: не спорит
     с приближением при наведении. ── */
  .ft-bento {
    --ft-ease: cubic-bezier(0.22, 1, 0.36, 1);  /* быстрый старт, мягкая посадка */
  }
  .ft-tile[data-state] {
    transition:
      opacity   600ms var(--ft-ease) var(--ft-delay, 0ms),
      translate 900ms var(--ft-ease) var(--ft-delay, 0ms);
  }
  .ft-tile[data-state] .ft-img {
    transition:
      scale     1400ms var(--ft-ease) var(--ft-delay, 0ms),
      transform 700ms var(--ease-out);
  }
  .ft-tile[data-state] .ft-body > * {
    transition:
      opacity   500ms var(--ft-ease) calc(var(--ft-delay, 0ms) + var(--ft-step)),
      translate 700ms var(--ft-ease) calc(var(--ft-delay, 0ms) + var(--ft-step));
  }
  .ft-body > :nth-child(1) { --ft-step: 160ms; }
  .ft-body > :nth-child(2) { --ft-step: 240ms; }
  .ft-body > :nth-child(3) { --ft-step: 320ms; }

  .ft-tile[data-state='hidden'] { opacity: 0; translate: 0 1.5rem; }
  .ft-tile[data-state='hidden'] .ft-img { scale: 1.08; }
  .ft-tile[data-state='hidden'] .ft-body > * { opacity: 0; }
  /* Ссылку не сдвигаем: transform на ней делает её опорным блоком для
     растянутого ::after (кликабельная плитка) — после анимации ::after
     прыгал к размеру плитки, и Chrome считал это сдвигом раскладки (CLS) */
  .ft-tile[data-state='hidden'] .ft-body > :not(.ft-link) { translate: 0 0.625rem; }

  @media (prefers-reduced-motion: reduce) {
    .ft-img { transition: none; }
    .ft-tile:hover .ft-img { transform: none; }
  }
</style>

<script>
  const bento = document.querySelector<HTMLElement>('[data-ft-reveal]')
  const stacked = matchMedia('(width < 64rem)').matches
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches

  if (bento && stacked && !still && 'IntersectionObserver' in window) {
    // Прячем только плитки ниже экрана — видимые при загрузке не мигают
    const tiles = [...bento.querySelectorAll<HTMLElement>('.ft-tile')]
      .filter((t) => t.getBoundingClientRect().top > innerHeight)
    tiles.forEach((t) => { t.dataset.state = 'hidden' })

    const io = new IntersectionObserver((entries) => {
      // Вошедшие в экран одной пачкой (две плитки рядом) — с шагом 90 мс
      entries
        .filter((e) => e.isIntersecting)
        .map((e) => e.target as HTMLElement)
        .sort((a, b) => tiles.indexOf(a) - tiles.indexOf(b))
        .forEach((tile, i) => {
          tile.style.setProperty('--ft-delay', `${i * 90}ms`)
          tile.dataset.state = 'shown'
          io.unobserve(tile)
        })
    }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' })

    tiles.forEach((t) => io.observe(t))
  }
</script>
