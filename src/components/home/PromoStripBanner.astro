---
/**
 * src/components/home/PromoStripBanner.astro
 *
 * Полоса «Бесплатный замер» на главной — во всю ширину экрана, тот же тёмный
 * тон, что у «Как мы работаем». Слева предложение и условие одной фразой,
 * справа действие: номер телефона кнопкой (на десктопе tel: не набрать —
 * номер виден целиком; клик считается целью phone_click в Метрике) и
 * ссылка на все акции.
 *
 * «Все акции» — не обычный якорь: страница длинная (~9-10к px), а ниже
 * лежат client:visible/client:idle острова — пока плавный скролл едет вниз,
 * их разметка догружается и меняет высоту документа под ногами (замерено:
 * +~440px за первые ~300мс), и скролл приземлялся мимо #promo. Мгновенный
 * прыжок (behavior:'instant') гонки не допускает.
 */
import { companyLegalInfo } from '../../lib/contacts-data'

const phone = companyLegalInfo.contacts.phone[0]!
---

<section class="measure-band" aria-labelledby="measure-band-heading">
  <div class="container measure-band__inner">
    <div>
      <h2 id="measure-band-heading" class="measure-band__title">
        Бесплатный замер по&nbsp;Челябинску
      </h2>
      <p class="measure-band__text">
        При заказе межкомнатных дверей. Замерщик снимет размеры проёма
        и&nbsp;рассчитает стоимость на&nbsp;месте.
      </p>
    </div>

    <div class="measure-band__actions">
      <a href={`tel:${phone.raw}`} class="btn measure-band__call" aria-label={`Записаться на замер: ${phone.label}`}>
        {phone.label}
      </a>
      <a href="#promo" class="measure-band__link" data-promo-jump>
        Все акции
        <svg class="btn-arrow-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-promo-jump]').forEach((el) => {
    el.addEventListener('click', (e) => {
      const target = document.getElementById('promo')
      if (!target) return
      e.preventDefault()
      target.scrollIntoView({ behavior: 'instant', block: 'start' })
      history.pushState(null, '', '#promo')
    })
  })
</script>

<style>
  /* Не .section: соседняя секция ниже сохраняет свой padding-top (общее
     правило зануляет его только после .section), а сверху воздух даёт
     padding-bottom секции «Новинки» */
  .measure-band {
    background: var(--color-graphite);
    color: #fff;
  }
  .measure-band__inner {
    display: grid;
    gap: 1.75rem;
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }
  @media (width >= 64rem) {
    .measure-band__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 3rem;
    }
  }

  .measure-band__title {
    margin: 0;
    font-size: var(--text-step-5);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: #fff;
    text-wrap: balance;
  }
  .measure-band__text {
    margin: 0.75rem 0 0;
    max-width: 36rem;
    font-size: var(--text-step-2);
    line-height: 1.55;
    color: rgb(255 255 255 / 0.62);
    text-wrap: pretty;
  }

  .measure-band__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  /* Белая кнопка на тёмном — главное действие; номер цифрами одинаковой
     ширины, чтобы читался как номер */
  .measure-band__call {
    padding: 0.9375rem 1.625rem;
    border-radius: 999px;
    background: #fff;
    color: var(--color-ink);
    font-size: var(--text-step-2);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .measure-band__call:hover { background: #ccfbf1; }  /* teal-100 */
  .measure-band__call:focus-visible { outline-color: #fff; }

  .measure-band__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding-block: 0.5rem;  /* зона нажатия */
    font-size: var(--text-step-1);
    font-weight: 600;
    color: rgb(255 255 255 / 0.75);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }
  .measure-band__link:hover { color: #fff; }
  .measure-band__link:hover .btn-arrow-icon { transform: translateX(2px); }
  .measure-band__link:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* Телефон: кнопка во всю ширину — под большой палец */
  @media (width < 30rem) {
    .measure-band__call { width: 100%; }
  }
</style>
