---
/**
 * src/components/home/PromoStripBanner.astro
 *
 * Плашка-анонс акций между хиро и остальным контентом главной. Ведёт к
 * блоку #promo (Promo.vue).
 *
 * Переход — не обычный якорь: страница длинная (~9-10к px), а ниже
 * PromoStripBanner ещё лежат несколько client:visible/client:idle
 * островов — пока анимированный scroll-behavior:smooth едет вниз, их
 * картинки и разметка догружаются и меняют высоту документа под ногами
 * (замерено: +~440px за первые ~300мс скролла). Анимация целится в
 * зафиксированную на старте точку, поэтому скролл иногда не долетает и
 * приземляется в блок «Портфолио» прямо перед #promo, а не в сами акции.
 * Мгновенный прыжок (behavior:'instant') снимает саму возможность гонки —
 * он не анимируется, значит нечему "не долетать".
 */

const IMAGE = 'https://storage.yandexcloud.net/vfd74ru/promo_main/F3563280-790C-49CB-A81E-00ED9A0D2A3B.webp'
---

<div class="pt-6 sm:pt-8">
  <div class="container">
    <a
      href="#promo"
      class="promo-strip grid grid-cols-1 overflow-hidden rounded-2xl bg-[#18181b] no-underline sm:grid-cols-[3fr_4fr] sm:items-stretch"
    >
      <div class="order-2 flex flex-col items-start justify-center gap-4 px-5 py-4 sm:order-1 sm:px-8 sm:py-6 lg:px-10 lg:py-8">
        <div>
          <p class="mb-2 text-step-0 font-medium tracking-[0.01em] text-white/60">Спецпредложения</p>
          <h2 class="text-3xl font-medium leading-tight tracking-tight text-white md:text-4xl">Акции</h2>
          <p class="mt-2 text-base text-white/60 sm:text-lg">Скидки на популярные модели дверей — успейте до конца месяца</p>
        </div>
        <span class="btn btn-ghost shrink-0" aria-hidden="true">
          Смотреть акции
          <svg class="btn-arrow-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </div>
      <div class="order-1 h-32 overflow-hidden sm:order-2 sm:h-auto">
        <img
          src={IMAGE}
          alt="Акции и спецпредложения ВФД"
          loading="lazy"
          decoding="async"
          width="900"
          height="500"
          class="promo-strip__image h-full w-full object-cover transition-transform duration-500 ease-out"
        />
      </div>
    </a>
  </div>
</div>

<script>
  document.querySelectorAll('.promo-strip').forEach((el) => {
    el.addEventListener('click', (e) => {
      const target = document.getElementById('promo')
      if (!target) return
      e.preventDefault()
      target.scrollIntoView({ behavior: 'instant', block: 'start' })
      history.pushState(null, '', '#promo')
    })
  })
</script>

<style>
  /* Единственное, что неудобно чистым Tailwind без произвольных
     селекторов, — ховер дочерней картинки от ховера ссылки-обёртки. */
  .promo-strip:hover .promo-strip__image {
    transform: scale(1.04);
  }
</style>
