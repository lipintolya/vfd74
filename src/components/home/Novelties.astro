---
/**
 * New products as a static editorial showcase.
 *
 * Product imagery and buying information live on separate surfaces so the
 * section remains visually distinct from the image-overlay home-page hero.
 * All products, prices and links are visible in the server-rendered document
 * without interaction or client-side JavaScript.
 */
import Action from '../ui/Action.astro'
import { rub } from '../../data/services'
import { typograph } from '../../lib/typograph'
import type { HomePromo, PromoPrice } from '../../lib/home-promos'

interface Props {
  items: HomePromo[]
}

const { items } = Astro.props

const money = (price: PromoPrice) => `${price.from ? 'от\u00a0' : ''}${rub(price.value)}`

const IMAGE_META: Record<string, { width: number; height: number }> = {
  '/renders/home/tehno-1.webp': { width: 1254, height: 1254 },
  '/renders/home/shtrih-2a-1.webp': { width: 1145, height: 1374 },
  '/renders/home/reflex-1.webp': { width: 1300, height: 732 },
}

const imageMeta = (src: string) => IMAGE_META[src] ?? { width: 1300, height: 1300 }
const imageSrcset = (src: string) => {
  if (!src.startsWith('/renders/home/')) return undefined
  const base = src.replace(/\.webp$/, '')
  const { width } = imageMeta(src)
  return `${base}-640.webp 640w, ${base}-960.webp 960w, ${src} ${width}w`
}
---

{items.length > 0 && (
  <section class="section bg-white" aria-labelledby="novelties-heading">
    <div class="container">
      <header class="nv-head">
        <h2 id="novelties-heading" class="t-h2 nv-heading">Новинки</h2>
        <p class="nv-intro">
          Все новые модели — сразу: особенности, актуальные цены и переход к подробностям.
        </p>
      </header>

      <div class="nv-bento">
        {items.map((item) => {
          const meta = imageMeta(item.image)

          return (
            <article class="nv-tile">
              <div class="nv-media">
                <img
                  class="nv-image"
                  src={item.image}
                  srcset={imageSrcset(item.image)}
                  sizes="(max-width: 1023px) calc(100vw - 2rem), min(50vw, 46rem)"
                  alt={item.alt}
                  width={meta.width}
                  height={meta.height}
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div class="nv-content">
                <h3 class="t-h3 nv-title">{typograph(item.title)}</h3>
                <p class="nv-text">{typograph(item.text)}</p>

                {item.offer && <p class="nv-offer">{typograph(item.offer)}</p>}

                {(item.price || item.kit) && (
                  <div class="nv-buy">
                    {item.price && (
                      <p class="nv-price">
                        <span class="t-price">{money(item.price)}</span>
                        {item.price.old && <s class="nv-old">{rub(item.price.old)}</s>}
                        <span class="nv-per">за полотно</span>
                      </p>
                    )}
                    {item.kit && (
                      <p class="nv-kit">
                        Комплект {item.kit.includes}&nbsp;— <b>{money(item.kit)}</b>
                        {item.kit.old && <s class="nv-old">{rub(item.kit.old)}</s>}
                      </p>
                    )}
                  </div>
                )}

                <Action
                  href={item.cta.href}
                  variant="primary"
                  class="nv-cta"
                >
                  {item.cta.label}
                </Action>
              </div>
            </article>
          )
        })}
      </div>
    </div>
  </section>
)}

<style>
  .nv-head {
    display: grid;
    gap: 0.75rem 3rem;
    width: 100%;
    margin: 0 0 clamp(1.75rem, 3vw, 2.5rem);
  }
  .nv-heading,
  .nv-intro {
    margin: 0;
  }
  .nv-intro {
    max-width: 39rem;
    font-size: var(--text-step-2);
    line-height: 1.5;
    color: var(--color-body);
    text-wrap: pretty;
  }

  .nv-bento {
    display: grid;
    gap: 1rem;
    width: 100%;
  }
  .nv-tile {
    display: grid;
    grid-template-rows: minmax(18rem, 1fr) auto;
    min-width: 0;
    overflow: hidden;
    border-radius: 1rem;
    background: #ebe8e2;
  }
  .nv-media {
    min-width: 0;
    min-height: 18rem;
    overflow: hidden;
    background: #e8e5df;
  }
  .nv-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease-out);
  }
  .nv-tile:nth-child(2) .nv-image {
    object-position: center 42%;
  }
  .nv-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.25rem;
  }
  .nv-title,
  .nv-text,
  .nv-offer,
  .nv-price,
  .nv-kit {
    margin: 0;
  }
  .nv-title {
    max-width: 18ch;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .nv-text {
    max-width: 36rem;
    margin-top: 0.625rem;
    font-size: var(--text-step-0);
    line-height: 1.5;
    color: var(--color-body);
    text-wrap: pretty;
  }
  .nv-offer {
    margin-top: 0.875rem;
    font-size: var(--text-step-0);
    font-weight: 600;
    color: var(--color-ink);
  }
  .nv-buy {
    margin-top: 0.875rem;
  }
  .nv-offer + .nv-buy {
    margin-top: 0.375rem;
  }
  .nv-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5rem;
  }
  .nv-price .t-price {
    color: var(--color-ink);
  }
  .nv-per,
  .nv-kit,
  .nv-old {
    font-size: var(--text-step-0);
  }
  .nv-per,
  .nv-kit {
    color: var(--color-body);
  }
  .nv-kit {
    margin-top: 0.25rem;
    line-height: 1.45;
  }
  .nv-kit b {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
    white-space: nowrap;
  }
  .nv-old {
    margin-inline-start: 0.25rem;
    font-variant-numeric: tabular-nums;
    color: color-mix(in srgb, var(--color-body) 65%, transparent);
  }
  .nv-cta {
    margin-top: 1rem;
  }

  @media (width >= 40rem) {
    .nv-bento {
      gap: 1.25rem;
    }
    .nv-tile {
      border-radius: 1.5rem;
    }
    .nv-content {
      padding: 1.75rem;
    }
  }

  @media (width >= 48rem) {
    .nv-head {
      grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.8fr);
      align-items: end;
    }
  }

  @media (width >= 64rem) {
    .nv-bento {
      grid-auto-rows: 1fr;
      gap: clamp(1.25rem, 2vw, 1.5rem);
    }
    .nv-tile {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr);
      min-height: 24rem;
    }
    .nv-tile:nth-child(even) .nv-media {
      order: 2;
    }
    .nv-tile .nv-media {
      min-height: 0;
    }
    .nv-tile .nv-content {
      justify-content: center;
      padding: clamp(1.5rem, 3vw, 2.5rem);
    }
    .nv-tile .nv-text {
      max-width: 34rem;
    }
    .nv-tile .nv-price .t-price {
      font-size: var(--text-step-3);
    }
  }

  @media (width >= 75rem) {
    .nv-tile {
      height: 24rem;
      min-height: 0;
    }
  }

  @media (hover: hover) {
    .nv-tile:hover .nv-image,
    .nv-tile:focus-within .nv-image {
      transform: scale(1.025);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nv-image {
      transition: none;
    }
    .nv-tile:hover .nv-image,
    .nv-tile:focus-within .nv-image {
      transform: none;
    }
  }
</style>
