---
/**
 * «Новинки» на главной — один блок с вкладками вместо промо подряд (те
 * растягивали главную одним и тем же приёмом). Данные — lib/home-promos.ts,
 * панель товара — общий ProductFeature.astro.
 *
 * Вкладки — сегментный переключатель: серая дорожка, выбранная вкладка —
 * тёмная «таблетка», которая переезжает между вкладками.
 *
 * Скорость: все панели — в серверном HTML (тексты и ссылки видят
 * поисковики), неактивные — с атрибутом hidden: их фото не грузятся
 * (lazy-картинки в display:none браузер не запрашивает), а остров
 * слайдера (client:visible) не гидрируется, пока панель не откроют.
 * Переключение — скрипт ниже, по образцу ARIA Tabs: стрелки ←/→,
 * Home/End, фокус ходит по вкладкам.
 */
import ProductFeature from './ProductFeature.astro'
import type { HomePromo } from '../../lib/home-promos'

interface Props {
  items: HomePromo[]
}
const { items } = Astro.props
---

{items.length > 0 && (
  <section class="section bg-white" aria-labelledby="novelties-heading">
    <div class="container">

      <header class="nv-head">
        <h2 id="novelties-heading" class="t-h2 nv-h2">Новинки</h2>
        <div
          class="nv-tabs"
          role="tablist"
          aria-label="Новинки"
          style={`--nv-n:${items.length}`}
          data-nv-tabs
        >
          <span class="nv-thumb" aria-hidden="true" />
          {items.map((p, i) => (
            <button
              type="button"
              role="tab"
              class="nv-tab"
              id={`nv-tab-${p.id}`}
              aria-controls={`nv-panel-${p.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {p.tab ?? p.title}
            </button>
          ))}
        </div>
      </header>

      {items.map((p, i) => (
        <div
          class="nv-panel"
          role="tabpanel"
          id={`nv-panel-${p.id}`}
          aria-labelledby={`nv-tab-${p.id}`}
          hidden={i !== 0}
        >
          <ProductFeature item={p} />
        </div>
      ))}

    </div>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-nv-tabs]').forEach((list) => {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')]
    const current = () => tabs.find((t) => t.getAttribute('aria-selected') === 'true') ?? tabs[0]!

    /* «Таблетка» под выбранной вкладкой — позиция и ширина из раскладки;
       пересчёт при изменении ширины (поворот телефона, загрузка шрифта) */
    const place = () => {
      const tab = current()
      list.style.setProperty('--nv-x', `${tab.offsetLeft}px`)
      list.style.setProperty('--nv-w', `${tab.offsetWidth}px`)
    }

    const select = (next: HTMLButtonElement, focus = false) => {
      for (const tab of tabs) {
        const on = tab === next
        tab.setAttribute('aria-selected', String(on))
        tab.tabIndex = on ? 0 : -1
        const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '')
        if (panel) panel.hidden = !on
      }
      place()
      if (focus) next.focus()
    }

    list.addEventListener('click', (e) => {
      const tab = (e.target as Element).closest<HTMLButtonElement>('[role="tab"]')
      if (tab) select(tab)
    })

    list.addEventListener('keydown', (e) => {
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement)
      if (i < 0) return
      const n = tabs.length
      const to =
        e.key === 'ArrowRight' ? (i + 1) % n :
        e.key === 'ArrowLeft'  ? (i - 1 + n) % n :
        e.key === 'Home'       ? 0 :
        e.key === 'End'        ? n - 1 : -1
      if (to < 0) return
      e.preventDefault()
      select(tabs[to]!, true)
    })

    place()
    new ResizeObserver(place).observe(list)
    // Переезд «таблетки» анимируем только после первой расстановки
    requestAnimationFrame(() => list.classList.add('is-ready'))
  })
</script>

<style>
  /* Шапка: заголовок слева, переключатель справа; на телефоне
     переключатель — под заголовком во всю ширину */
  .nv-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2.5rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .nv-h2 { margin: 0; }

  /* Сегментный переключатель: равные сегменты на серой дорожке.
     Выбранная — тёмная «таблетка» (.nv-thumb), до запуска скрипта —
     фон самой вкладки (без JS выбранная тоже видна). */
  .nv-tabs {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--nv-n), minmax(0, 1fr));
    width: 100%;
    padding: 0.25rem;
    border-radius: 999px;
    background: #f1f5f9;  /* slate-100 */
  }
  @media (width >= 48rem) {
    .nv-tabs {
      display: inline-grid;
      width: auto;
    }
  }
  .nv-thumb {
    position: absolute;
    top: 0.25rem;
    bottom: 0.25rem;
    left: 0;
    width: var(--nv-w, 0);
    transform: translateX(var(--nv-x, 0));
    border-radius: 999px;
    background: var(--color-ink);
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.2);
    opacity: 0;
  }
  .nv-tabs.is-ready .nv-thumb {
    opacity: 1;
    transition: transform 300ms var(--ease-out), width 300ms var(--ease-out);
  }

  .nv-tab {
    position: relative;
    z-index: 1;
    min-height: 2.75rem;  /* 44px — палец */
    margin: 0;
    padding: 0 0.5rem;
    border: 0;
    border-radius: 999px;
    background: none;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    color: #475569;  /* slate-600 */
    white-space: nowrap;
    cursor: pointer;
    transition: color 200ms var(--ease-out);
  }
  @media (width >= 48rem) {
    .nv-tab { padding: 0 1.375rem; font-size: var(--text-step-1); }
  }
  .nv-tab:hover { color: var(--color-ink); }
  .nv-tab[aria-selected='true'] { color: #fff; }
  .nv-tabs:not(.is-ready) .nv-tab[aria-selected='true'] { background: var(--color-ink); }
  .nv-tab:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Панель — общий ProductFeature; здесь только показ/скрытие и
     мягкое появление при переключении */
  .nv-panel { animation: nv-in 350ms var(--ease-out); }
  .nv-panel[hidden] { display: none; }
  @keyframes nv-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nv-panel { animation: none; }
    .nv-tab, .nv-tabs.is-ready .nv-thumb { transition: none; }
  }
</style>
