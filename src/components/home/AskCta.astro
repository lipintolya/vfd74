---
/**
 * «Остались вопросы?» — графитовая панель с каналами связи под FAQ на
 * главной (слот `aside` у FaqAccordion). Телефон, часы и мессенджеры — из
 * contacts-data, ссылки те же, что ловит YandexMetrika (tel:, t.me, vk.com,
 * max.ru → цели phone_click, telegram_click, vk_click, max_click).
 *
 * Раскладка зависит от ширины самой панели. Широкая (контейнер страницы) —
 * одна невысокая строка из трёх частей: вопрос, телефон с часами, кнопки.
 * Средняя (планшет) — части столбиком, кнопки в одну строку слева. Узкая
 * (телефон) — столбиком, Telegram тянется, значки рядом. Главное действие —
 * Telegram, белой кнопкой; номер крупно, потому что с компьютера по tel: не
 * позвонить и номер нужен на виду.
 */
import { companyLegalInfo } from '../../lib/contacts-data'

const { contacts, workingHours } = companyLegalInfo
const main = contacts.phone[0]!
const hours = [workingHours.weekdays.label, `Сб–Вс: ${workingHours.saturday.opens}–${workingHours.saturday.closes}`]
const social = (name: string) => companyLegalInfo.socialMedia.find((s) => s.name === name)!
const telegram = social('Telegram')
const vk = social('VK')
const max = social('MAX')
---

<div class="ask-wrap">
<div class="ask">
  <div class="ask-text">
    <h3 class="ask-title">Остались вопросы?</h3>
    <p class="ask-lead">Поможем с выбором и проконсультируем.</p>
  </div>

  <div class="ask-info">
    <a href={`tel:${main.raw}`} class="ask-phone">{main.label}</a>
    <p class="ask-hours">
      {hours.map((h) => <span>{h}</span>)}
    </p>
  </div>

  <div class="ask-actions">
    <a href={telegram.url} target="_blank" rel="noopener" class="ask-btn ask-btn--main">Написать в Telegram</a>
    <a href={vk.url} target="_blank" rel="noopener" class="ask-btn ask-btn--ghost ask-ic" aria-label="Написать в VK">
      <img src="/icons/w_vk.webp" alt="" width="18" height="18" loading="lazy" decoding="async" />
    </a>
    <a href={max.url} target="_blank" rel="noopener" class="ask-btn ask-btn--ghost ask-ic" aria-label="Написать в MAX">
      <img src="/icons/w_max.webp" alt="" width="18" height="18" loading="lazy" decoding="async" />
    </a>
  </div>
</div>
</div>

<style>
  /* Контейнер для @container — стили самого контейнера им не меняются,
     поэтому панель .ask вложена в обёртку */
  .ask-wrap { container: ask / inline-size; }
  .ask {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.5rem;
    border-radius: 1.5rem;
    background: var(--color-graphite);
    color: #fff;
  }
  .ask-title {
    margin: 0;
    font-size: var(--text-step-4);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .ask-lead {
    margin: 0.5rem 0 0;
    font-size: var(--text-step-2);
    line-height: 1.5;
    color: rgb(255 255 255 / 0.7);
  }

  /* Телефон крупно, как цифры в других блоках главной; часы — двумя
     строками под ним, светлее, чем раньше (серый на графите не читался) */
  .ask-phone {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-step-4);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--duration-base) var(--ease-out);
  }
  .ask-phone:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
    border-radius: 0.25rem;
  }
  @media (hover: hover) {
    .ask-phone:hover { color: var(--color-accent); }
  }
  .ask-hours {
    display: grid;
    gap: 0.25rem;
    margin: 0.75rem 0 0;
    font-size: var(--text-step-2);
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
    color: rgb(255 255 255 / 0.85);
  }
  .ask-hours span { display: block; }

  /* Кнопки: Telegram тянется, значки справа от него */
  .ask-actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0.5rem;
  }
  .ask-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.875rem;
    padding: 0.5rem 1.5rem;
    border-radius: 999px;
    font-size: var(--text-step-1);
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    transition:
      background-color var(--duration-base) var(--ease-out),
      box-shadow       var(--duration-base) var(--ease-out),
      transform        var(--duration-base) var(--ease-out);
  }
  .ask-btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  .ask-btn--main { background: #fff; color: var(--color-ink); }
  .ask-btn--ghost {
    color: #fff;
    box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.4);
  }
  .ask-ic { width: 2.875rem; padding: 0; }
  .ask-ic img { display: block; }
  @media (hover: hover) {
    .ask-btn--main:hover { background: #f4f4f5; transform: translateY(-1px); }  /* zinc-100 */
    .ask-btn--ghost:hover {
      background: rgb(255 255 255 / 0.12);
      box-shadow: inset 0 0 0 1.5px #fff;
    }
  }

  /* Средняя панель (планшет): кнопки в строку слева, Telegram не растянут */
  @container ask (min-width: 32rem) {
    .ask-actions {
      display: flex;
      flex-wrap: wrap;
    }
  }

  /* Широкая панель: одна строка из трёх частей, средняя отделена линией */
  @container ask (min-width: 56rem) {
    .ask {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) auto;
      align-items: center;
      gap: 2rem 3rem;
      padding: 2rem 2.5rem;
    }
    .ask-info {
      padding-left: 3rem;
      border-left: 1px solid rgb(255 255 255 / 0.12);
    }
    .ask-actions { flex-wrap: nowrap; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ask-btn, .ask-phone { transition: none; }
    .ask-btn--main:hover { transform: none; }
  }
</style>
