---
/**
 * «Остались вопросы?» — графитовая плашка с каналами связи под FAQ на
 * главной (слот `aside` у FaqAccordion). Телефон и мессенджеры — из
 * contacts-data, ссылки те же, что ловит YandexMetrika (tel:, t.me, vk.com,
 * max.ru → цели phone_click, telegram_click, vk_click, max_click).
 *
 * Раскладка зависит от ширины плашки: в узкой (колонка рядом со списком,
 * телефон) — текст, под ним кнопки столбиком; в средней (планшет) — кнопки
 * строкой под текстом; в широкой — текст слева, кнопки справа. Главное действие — Telegram, белой кнопкой;
 * телефон выписан цифрами: с компьютера по tel: не позвонить, номер нужен
 * на виду.
 */
import { companyLegalInfo } from '../../lib/contacts-data'

const main = companyLegalInfo.contacts.phone[0]!
const social = (name: string) => companyLegalInfo.socialMedia.find((s) => s.name === name)!
const telegram = social('Telegram')
const vk = social('VK')
const max = social('MAX')
---

<div class="ask-wrap">
<div class="ask">
  <div class="ask-text">
    <h3 class="ask-title">Остались вопросы?</h3>
    <p class="ask-lead">Поможем с выбором и проконсультируем.</p>
  </div>

  <div class="ask-actions">
    <a href={telegram.url} target="_blank" rel="noopener" class="ask-btn ask-btn--main">Написать в Telegram</a>
    <a href={`tel:${main.raw}`} class="ask-btn ask-btn--ghost ask-tel">{main.label}</a>
    <a href={vk.url} target="_blank" rel="noopener" class="ask-btn ask-btn--ghost ask-ic" aria-label="Написать в VK">
      <img src="/icons/w_vk.webp" alt="" width="18" height="18" loading="lazy" decoding="async" />
    </a>
    <a href={max.url} target="_blank" rel="noopener" class="ask-btn ask-btn--ghost ask-ic" aria-label="Написать в MAX">
      <img src="/icons/w_max.webp" alt="" width="18" height="18" loading="lazy" decoding="async" />
    </a>
  </div>
</div>
</div>

<style>
  /* Контейнер для @container — стили самого контейнера им не меняются,
     поэтому плашка .ask вложена в обёртку */
  .ask-wrap { container: ask / inline-size; }
  .ask {
    display: grid;
    gap: 1.5rem;
    padding: 1.5rem;
    border-radius: 1.5rem;
    background: var(--color-graphite);
    color: #fff;
  }
  .ask-title {
    margin: 0;
    font-size: var(--text-step-4);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .ask-lead {
    margin: 0.5rem 0 0;
    font-size: var(--text-step-1);
    line-height: 1.5;
    color: rgb(255 255 255 / 0.65);
  }

  /* Узкая плашка: Telegram на всю ширину, ниже телефон и два значка */
  .ask-actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 0.5rem;
  }
  .ask-btn--main { grid-column: 1 / -1; }

  .ask-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.875rem;
    padding: 0.5rem 1.25rem;
    border-radius: 999px;
    font-size: var(--text-step-1);
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    transition:
      background-color var(--duration-base) var(--ease-out),
      box-shadow       var(--duration-base) var(--ease-out),
      transform        var(--duration-base) var(--ease-out);
  }
  .ask-btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  .ask-btn--main { background: #fff; color: var(--color-ink); }
  .ask-btn--ghost {
    color: #fff;
    box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.4);
  }
  .ask-ic { width: 2.875rem; padding: 0; }
  .ask-ic img { display: block; }
  @media (hover: hover) {
    .ask-btn--main:hover { background: #f4f4f5; transform: translateY(-1px); }  /* zinc-100 */
    .ask-btn--ghost:hover {
      background: rgb(255 255 255 / 0.12);
      box-shadow: inset 0 0 0 1.5px #fff;
    }
  }

  /* Средняя плашка (планшет): кнопки в строку под текстом, Telegram — не на всю ширину */
  @container ask (min-width: 32rem) {
    .ask-actions { display: flex; flex-wrap: wrap; }
  }
  /* Широкая плашка: текст слева, кнопки справа в строку */
  @container ask (min-width: 56rem) {
    .ask {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 1.5rem 2.5rem;
      padding: 2.5rem 3rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ask-btn { transition: none; }
    .ask-btn--main:hover { transform: none; }
  }
</style>
