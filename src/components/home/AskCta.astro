---
/**
 * «Остались вопросы?» — графитовая панель с каналами связи под FAQ на
 * главной (слот `aside` у FaqAccordion). Телефон, часы и мессенджеры — из
 * contacts-data, ссылки те же, что ловит YandexMetrika (tel:, t.me, vk.com,
 * max.ru → цели phone_click, telegram_click, vk_click, max_click).
 *
 * Рядом со списком вопросов панель стоит на всю его высоту: сверху вопрос,
 * в середине номер телефона крупно (с компьютера по tel: не позвонить —
 * номер нужен на виду) и часы, снизу кнопки; главное действие — Telegram,
 * белой кнопкой. Раскладка зависит от ширины панели: узкая — столбиком;
 * средняя (планшет) — кнопки строкой; широкая — текст и телефон слева,
 * кнопки справа.
 */
import { companyLegalInfo } from '../../lib/contacts-data'

const { contacts, workingHours } = companyLegalInfo
const main = contacts.phone[0]!
const hours = [workingHours.weekdays.label, `Сб–Вс: ${workingHours.saturday.opens}–${workingHours.saturday.closes}`]
const social = (name: string) => companyLegalInfo.socialMedia.find((s) => s.name === name)!
const telegram = social('Telegram')
const vk = social('VK')
const max = social('MAX')
---

<div class="ask-wrap">
<div class="ask">
  <div class="ask-text">
    <h3 class="ask-title">Остались вопросы?</h3>
    <p class="ask-lead">Поможем с выбором и проконсультируем.</p>
  </div>

  <div class="ask-info">
    <a href={`tel:${main.raw}`} class="ask-phone">{main.label}</a>
    <p class="ask-hours">
      {hours.map((h) => <span>{h}</span>)}
    </p>
  </div>

  <div class="ask-actions">
    <a href={telegram.url} target="_blank" rel="noopener" class="ask-btn ask-btn--main">Написать в Telegram</a>
    <a href={vk.url} target="_blank" rel="noopener" class="ask-btn ask-btn--ghost ask-ic" aria-label="Написать в VK">
      <img src="/icons/w_vk.webp" alt="" width="18" height="18" loading="lazy" decoding="async" />
    </a>
    <a href={max.url} target="_blank" rel="noopener" class="ask-btn ask-btn--ghost ask-ic" aria-label="Написать в MAX">
      <img src="/icons/w_max.webp" alt="" width="18" height="18" loading="lazy" decoding="async" />
    </a>
  </div>
</div>
</div>

<style>
  /* Контейнер для @container — стили самого контейнера им не меняются,
     поэтому панель .ask вложена в обёртку. Обёртка — grid: панель
     растягивается на высоту, которую ей даёт соседний список. */
  .ask-wrap { container: ask / inline-size; display: grid; }
  .ask {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem;
    border-radius: 1.5rem;
    background: var(--color-graphite);
    color: #fff;
  }
  .ask-title {
    margin: 0;
    font-size: var(--text-step-4);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .ask-lead {
    margin: 0.5rem 0 0;
    font-size: var(--text-step-1);
    line-height: 1.5;
    color: rgb(255 255 255 / 0.65);
  }

  /* Телефон крупно, как цифры в других блоках главной */
  .ask-phone {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-step-4);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--duration-base) var(--ease-out);
  }
  .ask-phone:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
    border-radius: 0.25rem;
  }
  @media (hover: hover) {
    .ask-phone:hover { color: var(--color-accent); }
  }
  .ask-hours {
    display: grid;
    gap: 0.125rem;
    margin: 0.75rem 0 0;
    font-size: var(--text-step-1);
    line-height: 1.45;
    font-variant-numeric: tabular-nums;
    color: rgb(255 255 255 / 0.65);
  }

  /* Кнопки: Telegram тянется, значки — по 2.875rem */
  .ask-actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 0.5rem;
  }
  .ask-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.875rem;
    padding: 0.5rem 1.25rem;
    border-radius: 999px;
    font-size: var(--text-step-1);
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    transition:
      background-color var(--duration-base) var(--ease-out),
      box-shadow       var(--duration-base) var(--ease-out),
      transform        var(--duration-base) var(--ease-out);
  }
  .ask-btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  .ask-btn--main { background: #fff; color: var(--color-ink); }
  .ask-btn--ghost {
    color: #fff;
    box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.4);
  }
  .ask-ic { width: 2.875rem; padding: 0; }
  .ask-ic img { display: block; }
  @media (hover: hover) {
    .ask-btn--main:hover { background: #f4f4f5; transform: translateY(-1px); }  /* zinc-100 */
    .ask-btn--ghost:hover {
      background: rgb(255 255 255 / 0.12);
      box-shadow: inset 0 0 0 1.5px #fff;
    }
  }

  /* Широкая панель (планшет и шире, FAQ столбиком): текст и телефон слева,
     кнопки справа */
  @container ask (min-width: 56rem) {
    .ask {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'text actions'
        'info actions';
      align-items: center;
      gap: 1.5rem 2.5rem;
      padding: 2.5rem 3rem;
    }
    .ask-text    { grid-area: text; }
    .ask-info    { grid-area: info; }
    .ask-actions { grid-area: actions; display: flex; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ask-btn, .ask-phone { transition: none; }
    .ask-btn--main:hover { transform: none; }
  }
</style>
