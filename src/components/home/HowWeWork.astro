---
import ProcessSteps from '../partitions/ProcessSteps.astro'
import { howItWorksSteps } from '../../data/how-it-works'
---

<!-- Графитовая панель внутри контейнера, а не тёмная секция во всю ширину:
     продолжает бенто hero выше (те же скругления и тон --color-graphite) и
     не ломает общее правило отступов соседних .section. -->
<section class="section bg-white" aria-labelledby="how-we-work-heading">
  <div class="container">
    <div class="rounded-2xl bg-graphite px-5 py-9 sm:rounded-3xl sm:px-8 sm:py-12 lg:px-12 lg:py-14">

      <header class="mb-10 grid gap-4 md:mb-14 lg:grid-cols-12 lg:items-end lg:gap-8">
        <div class="lg:col-span-7">
          <p class="t-eyebrow mb-3 text-white/55">Процесс</p>
          <h2 id="how-we-work-heading" class="t-h2 text-white">Как мы работаем</h2>
        </div>
        <p class="t-lead max-w-md text-white/60 lg:col-span-5 lg:justify-self-end">
          От выбора модели до готовой установки — 4&nbsp;понятных шага, без скрытых доплат
        </p>
      </header>

      <ProcessSteps items={howItWorksSteps} dark />

    </div>
  </div>
</section>
