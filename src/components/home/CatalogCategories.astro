---
/**
 * «Каталог» на главной — три направления: межкомнатные, входные двери,
 * перегородки. Три вертикальные фото-плитки в ряд (другой ритм, чем
 * у бенто «Официальный салон ВФД» прямо над ним), на телефоне — стопкой.
 * На плитке: название, цена «от» (живая: межкомнатные — минимум по
 * каталогу, входные — по entrance-doors.ts) или срок, ссылка. Плитка —
 * одна ссылка на всю площадь.
 *
 * Плитки — общий ui/PhotoTiles.astro (тот же ряд — «Другие разделы» на /catalog/).
 *
 * Фото — ресайзы 640/960 (scripts/gen-responsive.mjs cat-) + оригинал.
 */
import SectionHeader from './SectionHeader.astro'
import PhotoTiles, { type PhotoTile } from '../ui/PhotoTiles.astro'
import { ENTRANCE_DOOR_MODELS, minPriceOf } from '../../data/entrance-doors'
import { rub } from '../../data/services'

interface Props {
  /** Минимальная цена полотна по каталогу (getHomePromos) */
  interiorMinPrice: number | null
}
const { interiorMinPrice } = Astro.props

const entranceMinPrice = Math.min(...ENTRANCE_DOOR_MODELS.map(minPriceOf))

const CATEGORIES: PhotoTile[] = [
  {
    title: 'Межкомнатные двери',
    fact:  interiorMinPrice ? `от ${rub(interiorMinPrice)} за полотно` : null,
    href:  '/catalog/',
    cta:   'Выбрать модель',
    img: {
      src:    '/renders/home/cat-interior-960.webp',
      srcset: '/renders/home/cat-interior-640.webp 640w, /renders/home/cat-interior-960.webp 960w, /media/Main_page/left_bento/cover_doors.webp 1280w',
      alt:    'Белая межкомнатная дверь в светлом интерьере',
      width: 960, height: 960,
      sizes: '(min-width: 64rem) 33vw, (min-width: 48rem) calc(100vw - 4rem), calc(100vw - 2rem)',
    },
  },
  {
    title: 'Входные двери',
    fact:  `от ${rub(entranceMinPrice)} с накладкой изнутри`,
    href:  '/vhodnye-dveri/',
    cta:   'Выбрать входную дверь',
    img: {
      src:    '/renders/home/cat-entrance-960.webp',
      srcset: '/renders/home/cat-entrance-640.webp 640w, /renders/home/cat-entrance-960.webp 960w, /media/metal_doors/Optima/render_optima.webp 1122w',
      alt:    'Стальная входная дверь «Оптима» в тёмно-сером цвете',
      width: 960, height: 1200,
      sizes: '(min-width: 64rem) 33vw, (min-width: 48rem) 50vw, calc(100vw - 2rem)',
    },
  },
  {
    title: 'Алюминиевые перегородки',
    fact:  'Изготовление до 45 рабочих дней',
    href:  '/partitions/',
    cta:   'Смотреть перегородки',
    img: {
      src:    '/renders/home/cat-partitions-960.webp',
      srcset: '/renders/home/cat-partitions-640.webp 640w, /renders/home/cat-partitions-960.webp 960w, /media/alum/saint_p_alum/tg4.webp 1080w',
      alt:    'Реечная перегородка из чёрного алюминиевого профиля в гостиной',
      width: 960, height: 1196,
      sizes: '(min-width: 64rem) 33vw, (min-width: 48rem) 50vw, calc(100vw - 2rem)',
    },
  },
]
---

<section class="section bg-white catalog-home" aria-labelledby="cat-heading">
  <div class="container">

    <SectionHeader
      id="cat-heading"
      title="Купить двери в Челябинске"
      lead="Межкомнатные и входные двери, алюминиевые перегородки — от официального дилера фабрики, с ценами в каталоге."
    />

    <PhotoTiles items={CATEGORIES} />

  </div>
</section>

<style>
  /* Mobile-first: карточки остаются достаточно низкими для быстрого
     просмотра, но текст и действие не конкурируют с изображением. */
  .catalog-home :global(.pt-grid) {
    gap: 1rem;
  }
  .catalog-home :global(.pt-tile) {
    aspect-ratio: 16 / 11;
    min-height: 19rem;
  }
  .catalog-home :global(.pt-tile::before) {
    background:
      linear-gradient(to top, rgb(0 0 0 / 0.9) 0%, rgb(0 0 0 / 0.54) 42%, rgb(0 0 0 / 0.08) 78%),
      linear-gradient(to right, rgb(0 0 0 / 0.12), transparent 45%);
  }
  .catalog-home :global(.pt-body) {
    padding: clamp(1.25rem, 4vw, 2rem);
  }
  .catalog-home :global(.pt-title) {
    max-width: 18ch;
  }
  .catalog-home :global(.pt-fact) {
    max-width: 32rem;
  }

  /* Не отдельная «кнопка поверх фото», а нижняя навигационная строка:
     вся карточка остаётся одной ссылкой и одним tab-stop. */
  .catalog-home :global(.pt-link) {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    min-height: 3rem;
    margin-top: 1.125rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgb(255 255 255 / 0.38);
  }
  .catalog-home :global(.pt-link .btn-arrow-icon) {
    box-sizing: border-box;
    flex: 0 0 2.5rem;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0.75rem;
    border-radius: 50%;
    background: #fff;
    color: var(--color-graphite);
    transform: rotate(-45deg);
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Планшет: главная категория получает целую строку, две остальные —
     равные колонки. Так текст не зажимается в три узких столбца. */
  @media (width >= 48rem) {
    .catalog-home :global(.pt-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
    .catalog-home :global(.pt-tile) {
      min-height: 22rem;
      aspect-ratio: 4 / 3;
    }
    .catalog-home :global(.pt-tile:first-child) {
      grid-column: 1 / -1;
      min-height: 25rem;
      aspect-ratio: 2 / 1;
    }
  }

  /* Десктоп: спокойный равный триптих в полную ширину контейнера. */
  @media (width >= 64rem) {
    .catalog-home :global(.pt-grid) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1rem, 1.6vw, 1.5rem);
    }
    .catalog-home :global(.pt-tile),
    .catalog-home :global(.pt-tile:first-child) {
      grid-column: auto;
      min-height: 31rem;
      aspect-ratio: 4 / 5;
    }
    .catalog-home :global(.pt-title) {
      font-size: var(--text-step-4);
    }
  }

  @media (hover: hover) {
    .catalog-home :global(.pt-tile:hover .pt-link .btn-arrow-icon) {
      transform: rotate(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .catalog-home :global(.pt-link .btn-arrow-icon) {
      transition: none;
    }
    .catalog-home :global(.pt-tile:hover .pt-link .btn-arrow-icon) {
      transform: rotate(-45deg);
    }
  }
</style>
