---
/**
 * «Частые вопросы» — аккордеон на нативных <details> (работает без JS,
 * ответы в HTML для FAQPage-разметки страницы). Общий для главной, каталога,
 * лендингов и статей.
 *
 * Раскладка зависит от ширины самого блока (container query), а не экрана.
 * В узкой колонке (статья, планшет, телефон) — столбиком, слот `aside` после
 * списка. В широком:
 *  - без `aside` — слева заголовок (липкий: едет за прокруткой вдоль списка,
 *    пустая колонка под ним не «висит»), справа список;
 *  - с `aside` (на главной — «Остались вопросы?») — заголовок сверху, под ним
 *    список слева и панель справа на всю высоту списка: колонка с одним
 *    заголовком и пустотой под ним (было) выглядела недоделанной.
 * Строка вопроса на тысячу пикселей с шевроном на другом краю тоже не годилась —
 * взгляду не за что зацепиться.
 *
 * Открытие плавное там, где браузер умеет ::details-content и
 * interpolate-size (Chrome 131+); в остальных — мгновенное, как раньше.
 */
export interface FaqItem {
  q: string
  a: string
}

interface Props {
  items: readonly FaqItem[]
  title?: string
}

const { items, title = 'Частые вопросы' } = Astro.props
const hasAside = Astro.slots.has('aside')
---

<div class="faq-wrap">
<div class="faq" class:list={{ 'faq--aside': hasAside }}>
  <h2 class="t-h2 faq-h2">{title}</h2>

  <div class="faq-list">
    {items.map(f => (
      <details class="faq-item">
        <summary class="faq-q">
          <span class="faq-qt">{f.q}</span>
          <span class="faq-ico" aria-hidden="true"></span>
        </summary>
        <p class="faq-a">{f.a}</p>
      </details>
    ))}
  </div>

  {hasAside && <div class="faq-aside"><slot name="aside" /></div>}
</div>
</div>

<style>
  /* Контейнер для @container — стили самого контейнера им не меняются,
     поэтому сетка .faq вложена в обёртку */
  .faq-wrap { container: faq / inline-size; }
  .faq-h2 { margin: 0 0 1.5rem; text-wrap: balance; }
  .faq-aside { margin-top: 2.5rem; }

  /* ── Широкий блок ── */
  @container faq (min-width: 62rem) {
    .faq {
      display: grid;
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      grid-template-areas: 'head list';
      align-items: start;
      column-gap: clamp(2.5rem, 5vw, 5rem);
    }
    /* Липкий заголовок: прилипает под плавающей шапкой */
    .faq-h2 {
      grid-area: head;
      margin: 0;
      position: sticky;
      top: calc(var(--header-height) + 1.5rem);
    }
    .faq-list { grid-area: list; }

    /* С панелью: заголовок сверху, список слева, панель справа на всю высоту */
    .faq--aside {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      grid-template-areas:
        'head head'
        'list aside';
      align-items: stretch;
      column-gap: clamp(2rem, 4vw, 3.5rem);
      row-gap: 2rem;
    }
    .faq--aside .faq-h2 { position: static; }
    .faq-aside { grid-area: aside; display: grid; margin-top: 0; }
  }

  /* ── Список ── */
  .faq-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border);
  }
  .faq-item {
    border-bottom: 1px solid var(--color-border);
    interpolate-size: allow-keywords;
  }
  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--text-step-2);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    transition: color var(--duration-base) var(--ease-out);
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-qt { text-wrap: pretty; }
  @container faq (min-width: 40rem) {
    .faq-q { padding-block: 1.5rem; font-size: var(--text-step-3); }
  }
  .faq-q:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 0.375rem;
  }
  @media (hover: hover) {
    .faq-q:hover { color: #0f766e; }  /* teal-700, как у заголовков карточек при наведении */
    .faq-q:hover .faq-ico { color: #0f766e; }
  }

  /* Плюс из двух полос: вертикальная схлопывается, остаётся минус */
  .faq-ico {
    position: relative;
    flex-shrink: 0;
    width: 1.125rem;
    height: 1.125rem;
    color: #64748b;  /* slate-500 */
    transition: color var(--duration-base) var(--ease-out);
  }
  .faq-ico::before,
  .faq-ico::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 2px;
    margin-top: -1px;
    border-radius: 1px;
    background: currentColor;
    transition: transform 220ms var(--ease-out);
  }
  .faq-ico::after { transform: rotate(90deg); }
  .faq-item[open] .faq-ico { color: var(--color-ink); }
  .faq-item[open] .faq-ico::after { transform: rotate(0deg); }

  .faq-a {
    margin: 0;
    padding: 0 2.75rem 1.5rem 0;  /* справа — мимо значка, чтобы строки не упирались в него */
    max-width: 42rem;
    font-size: var(--text-step-2);
    line-height: 1.65;
    color: #475569;  /* slate-600 */
    text-wrap: pretty;
  }

  /* Плавное раскрытие (прогрессивное улучшение) */
  @supports selector(::details-content) {
    .faq-item::details-content {
      block-size: 0;
      overflow: hidden;
      transition: block-size 260ms var(--ease-out), content-visibility 260ms allow-discrete;
    }
    .faq-item[open]::details-content { block-size: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-item::details-content,
    .faq-q,
    .faq-ico,
    .faq-ico::before,
    .faq-ico::after { transition: none; }
  }
</style>
