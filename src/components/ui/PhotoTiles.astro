---
/**
 * Ряд фото-плиток разделов: фото на всю плитку, внизу на затемнении —
 * название, факт (цена «от» или срок) и «Смотреть». Плитка — одна ссылка
 * на всю площадь. «Каталог» на главной (CatalogCategories.astro) и
 * «Другие разделы» под сеткой /catalog/.
 *
 * Три плитки в ряд с md; на телефоне — стопкой. Появление на телефоне и
 * планшете — общий lib/tile-reveal.ts.
 */
import { typograph } from '../../lib/typograph'

export interface PhotoTile {
  title: string
  /** Цена «от» или срок — одной строкой под названием */
  fact:  string | null
  href:  string
  img:   { src: string; srcset: string; alt: string; width: number; height: number }
}

interface Props {
  items: PhotoTile[]
  /** h3 под H2 секции; h2 — если у блока нет своего заголовка */
  headingTag?: 'h2' | 'h3'
}

const { items, headingTag = 'h3' } = Astro.props
const Heading = headingTag
---

<ul class="pt-grid" role="list" data-tile-reveal>
  {items.map((c) => (
    <li class="pt-tile" data-reveal-tile>
      <img
        class="pt-img"
        data-reveal-img
        src={c.img.src}
        srcset={c.img.srcset}
        sizes="(min-width: 48rem) 33vw, calc(100vw - 2rem)"
        width={c.img.width}
        height={c.img.height}
        alt={c.img.alt}
        loading="lazy"
        decoding="async"
      />
      <div class="pt-body" data-reveal-body>
        <Heading class="pt-title">{typograph(c.title)}</Heading>
        {c.fact && <p class="pt-fact">{typograph(c.fact)}</p>}
        <!-- Название уже на плитке — ссылка коротко «Смотреть»;
             для скринридера её имя — название раздела -->
        <a class="pt-link" href={c.href} aria-label={c.title}>
          Смотреть
          <svg class="btn-arrow-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </li>
  ))}
</ul>

<script>
  import { revealTiles } from '../../lib/tile-reveal'
  revealTiles()
</script>

<style>
  /* Три колонки с md; на телефоне — стопкой */
  .pt-grid {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (width >= 48rem) {
    .pt-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1rem, 1.6vw, 1.5rem);
    }
  }

  /* Плитка: фото на всю площадь, текст снизу на затемнении — тот же язык,
     что у плитки зала в «Официальном салоне ВФД» */
  .pt-tile {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    border-radius: 1.25rem;
    background: #27272a;  /* zinc-800 — пока грузится фото */
    color: #fff;
  }
  @media (width >= 40rem) {
    .pt-tile { border-radius: 1.5rem; }
  }
  @media (width >= 48rem) {
    .pt-tile { aspect-ratio: 4 / 5; }
  }
  .pt-tile::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(0 0 0 / 0.78) 0%, rgb(0 0 0 / 0.32) 42%, rgb(0 0 0 / 0) 70%);
  }
  .pt-img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }

  .pt-body {
    padding: clamp(1.25rem, 2.2vw, 1.75rem);
  }
  .pt-title {
    margin: 0;
    font-size: var(--text-step-4);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #fff;
    text-wrap: balance;
  }
  /* на планшете три узкие колонки — на ступень меньше */
  @media (48rem <= width < 64rem) {
    .pt-title { font-size: var(--text-step-3); }
  }
  .pt-fact {
    margin: 0.5rem 0 0;
    font-size: var(--text-step-1);
    line-height: 1.45;
    font-variant-numeric: tabular-nums;
    color: rgb(255 255 255 / 0.82);
  }

  /* Ссылка — вся плитка: ::after растянут на неё */
  .pt-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1rem;
    font-size: var(--text-step-1);
    font-weight: 600;
    color: #fff;
    text-decoration: none;
  }
  .pt-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .pt-link:focus-visible { outline: none; }
  .pt-tile:has(.pt-link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .pt-tile:hover .pt-img { transform: scale(1.03); }
    .pt-tile:hover .btn-arrow-icon { transform: translateX(3px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pt-img { transition: none; }
    .pt-tile:hover .pt-img { transform: none; }
  }
</style>
