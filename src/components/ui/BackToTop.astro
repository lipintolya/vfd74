---
/**
 * «Наверх» — плавающая кнопка справа внизу. Появляется, когда пролистан
 * экран; кольцо вокруг стрелки показывает, сколько страницы пройдено (на
 * длинных страницах заодно ориентир). Светлая матовая подложка с тенью и
 * рамкой видна и на белом, и на графитовых блоках; при наведении мышью
 * инвертируется в --color-fg.
 *
 * Спрятанная кнопка недоступна и для клавиатуры (visibility, а не только
 * opacity). Отступы учитывают чёлку и жесты iOS (safe-area). Баннер
 * cookie на узком экране перекрывал бы кнопку — скрипт поднимает её над ним.
 */
---

<button type="button" id="btt-btn" class="btt" aria-label="Наверх — прокрутить страницу в начало" title="Наверх">
  <!-- Кольцо прогресса: pathLength=1 — длина штриха в долях круга, сдвиг
       считается напрямую из доли прокрутки (--p) -->
  <svg class="btt-ring" viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <circle class="btt-track" cx="24" cy="24" r="22" pathLength="1" />
    <circle class="btt-bar" cx="24" cy="24" r="22" pathLength="1" />
  </svg>
  <svg class="btt-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>

<style>
  .btt {
    position: fixed;
    z-index: 48;
    right: calc(1.25rem + env(safe-area-inset-right, 0px));
    bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px) + var(--btt-lift, 0px));
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.92);
    -webkit-backdrop-filter: blur(0.5rem);
    backdrop-filter: blur(0.5rem);
    box-shadow: 0 0 0 1px rgb(15 23 42 / 0.08), 0 0.5rem 1.5rem rgb(15 23 42 / 0.16);
    color: var(--color-fg);
    cursor: pointer;
    touch-action: manipulation;
    /* спрятана: невидима, не кликабельна и не берёт фокус */
    visibility: hidden;
    opacity: 0;
    translate: 0 0.75rem;
    scale: 0.9;
    transition:
      opacity 220ms var(--ease-out),
      translate 220ms var(--ease-out),
      scale 220ms var(--ease-out),
      bottom 250ms var(--ease-out),
      background-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out),
      visibility 0s linear 220ms;
  }
  .btt[data-visible] {
    visibility: visible;
    opacity: 1;
    translate: 0 0;
    scale: 1;
    transition-delay: 0s;
  }

  .btt-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    rotate: -90deg;  /* прогресс идёт от верха по часовой */
  }
  .btt-ring circle { stroke-width: 2.5; }
  .btt-track { stroke: rgb(15 23 42 / 0.1); }
  .btt-bar {
    stroke: var(--color-accent);
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--p, 0));
    transition: stroke-dashoffset 120ms linear, stroke var(--duration-base) var(--ease-out);
  }
  .btt-arrow {
    position: relative;
    width: 1.125rem;
    height: 1.125rem;
    transition: translate var(--duration-base) var(--ease-out);
  }

  @media (hover: hover) {
    .btt:hover { background: var(--color-fg); color: #fff; }
    .btt:hover .btt-track { stroke: rgb(255 255 255 / 0.2); }
    .btt:hover .btt-bar { stroke: #2dd4bf; }  /* teal-400 на тёмном */
    .btt:hover .btt-arrow { translate: 0 -0.125rem; }
  }
  .btt:active { scale: 0.94; }
  .btt:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .btt,
    .btt-bar,
    .btt-arrow { transition: none; }
  }
</style>

<script>
  const btn = document.getElementById('btt-btn') as HTMLButtonElement | null

  if (btn) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)')
    let ticking = false

    /* Видимость и доля прокрутки — раз в кадр, не на каждое событие */
    const update = () => {
      ticking = false
      const y = window.scrollY
      const max = document.documentElement.scrollHeight - window.innerHeight
      btn.toggleAttribute('data-visible', y > window.innerHeight)
      btn.style.setProperty('--p', max > 0 ? Math.min(1, y / max).toFixed(3) : '0')
    }
    const onScroll = () => {
      if (ticking) return
      ticking = true
      requestAnimationFrame(update)
    }
    window.addEventListener('scroll', onScroll, { passive: true })
    window.addEventListener('resize', onScroll, { passive: true })
    update()

    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: reduce.matches ? 'auto' : 'smooth' })
    })

    /* Баннер согласия с cookie (BaseLayout) стоит внизу по центру и на узком
       экране накрывает кнопку: пока он виден и пересекается с ней по ширине,
       поднимаем кнопку над ним */
    const banner = document.getElementById('cookie-banner')
    if (banner) {
      const avoid = () => {
        const shown = getComputedStyle(banner).display !== 'none'
        const b = banner.getBoundingClientRect()
        const r = btn.getBoundingClientRect()
        const overlapsX = shown && b.right > r.left - 8
        btn.style.setProperty('--btt-lift', overlapsX ? `${Math.ceil(b.height + 12)}px` : '0px')
      }
      new MutationObserver(avoid).observe(banner, { attributes: true, attributeFilter: ['style'] })
      window.addEventListener('resize', avoid, { passive: true })
      avoid()
    }
  }
</script>
