---
/**
 * Последняя карточка ленты (.rail) — графитовая, крупное число и подпись:
 * «33 фотоотчёта в портфолио», «16 отзывов на Яндекс Картах и 2ГИС».
 *
 * С href — вся карточка ссылка (cta — подпись со стрелкой); без href —
 * обычная плашка, ссылки передаются в слот (несколько внешних площадок).
 * fit: 'photo' — пропорции 4:5, вровень с фото соседних карточек;
 * 'row' — во всю высоту ряда ленты (карточки без фото).
 */
import { typograph } from '../../lib/typograph'

interface Props {
  value: string | number
  text:  string
  href?: string
  cta?:  string
  fit?:  'photo' | 'row'
}
const { value, text, href, cta, fit = 'photo' } = Astro.props
const Tag = href ? 'a' : 'div'
---

<Tag href={href} class:list={['rec', `rec--${fit}`, { 'rec--link': href }]}>
  <span class="rec-num">{value}</span>
  <span class="rec-text">{typograph(text)}</span>
  {href && cta ? (
    <span class="rec-cta">
      {cta}
      <svg class="btn-arrow-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  ) : (
    <span class="rec-links"><slot /></span>
  )}
</Tag>

<style>
  .rec {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.25rem, 2.2vw, 1.75rem);
    border-radius: 1.5rem;
    background: var(--color-graphite);
    color: #fff;
    text-decoration: none;
  }
  .rec--photo { aspect-ratio: 4 / 5; }
  .rec--row   { height: 100%; min-height: 16rem; }
  /* На десктопе карточка занимает клетку сетки целиком */
  @media (width >= 64rem) {
    .rec--photo { aspect-ratio: auto; height: 100%; min-height: 16rem; }
  }

  .rec-num {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 7vw, 5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .rec-text {
    margin-top: 0.5rem;
    max-width: 17rem;
    font-size: var(--text-step-2);
    line-height: 1.4;
    color: rgb(255 255 255 / 0.75);
  }
  .rec-cta,
  .rec-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1.5rem;
    font-size: var(--text-step-1);
    font-weight: 600;
  }
  .rec-cta { display: inline-flex; align-items: center; gap: 0.375rem; }
  .rec-links :global(a) {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding-block: 0.25rem;
    color: #fff;
    text-decoration: none;
  }
  .rec-links :global(a:hover .btn-arrow-icon) { transform: translateX(3px); }
  .rec-links :global(a:focus-visible),
  .rec--link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }
  .rec--link:focus-visible { border-radius: 1.5rem; }
  @media (hover: hover) {
    .rec--link:hover .btn-arrow-icon { transform: translateX(3px); }
  }
</style>
