---
/**
 * Страница «Контакты».
 *
 * 1. Первый экран: заголовок, телефоны крупно (сами по себе — кнопка звонка),
 *    мессенджеры текстовыми кнопками, почта; справа — фото фасада, чтобы
 *    здание узнавали с улицы.
 * 2. «Как добраться»: адрес, вход, часы, маршрут + карта.
 * 3. «Оплата и реквизиты» — открыто, на линейках, без карточек.
 *
 * Статичный Astro, интерактивна только карта (SalonMap, client:visible).
 * Все контакты — из contacts-data.ts (единый источник для футера, шапки,
 * /about/ и структурированных данных), не хардкодом.
 */
import { companyLegalInfo, getFormattedHours } from '../../lib/contacts-data'
import { SOCIAL_NETWORKS } from '../../lib/header-nav'
import { paymentMethods } from '../about/about-data'
import SalonMap from '../ui/SalonMap.vue'
import { FACADE_IMAGE } from '../../lib/facade-image'

const phones   = companyLegalInfo.contacts.phone
const email    = companyLegalInfo.contacts.email
const address  = companyLegalInfo.address
const director = companyLegalInfo.director
const req      = companyLegalInfo.requisites
const ROUTE    = address.routeUrl

/* Telegram — главный канал (отвечаем быстрее всего), остальные рядом */
const telegram   = SOCIAL_NETWORKS.find((s) => s.name === 'Telegram')!
const messengers = SOCIAL_NETWORKS.filter((s) => s.name !== 'Telegram')

/* Улица и дом без «г. Челябинск,» — крупная строка адреса и карточка на карте */
const street = address.legal.replace(/^г\.\s*[^,]+,\s*/, '')

/* Сб и Вс сейчас по одному графику — одна строка «Сб–Вс», без дубля времени. */
const [weekdays, saturday, sunday] = getFormattedHours()
const hours = saturday!.time === sunday!.time
  ? [weekdays!, { day: 'Сб–Вс', time: saturday!.time }]
  : [weekdays!, saturday!, sunday!]

---

<section class="section ct">
  <div class="container">

    <!-- ── Первый экран ── -->
    <div class="ct-hero">
      <div class="ct-hero__text">
        <h1 class="t-h1 m-0">Контакты салона ВФД в Челябинске</h1>
        <p class="t-lead ct-lead">
          Двери и перегородки — вживую, приезжайте без записи. Или напишите: ответим в течение рабочего дня.
        </p>

        <ul class="ct-phones" role="list">
          {phones.map((p) => (
            <li>
              <a href={`tel:${p.raw}`} class="ct-phone">{p.label}</a>
              <span class="ct-phone__note">{p.title}</span>
            </li>
          ))}
        </ul>

        <div class="ct-actions">
          <a href={telegram.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary ct-btn">
            Написать в Telegram
          </a>
          {messengers.map((s) => (
            <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-outline ct-btn">
              {s.name === 'MAX' ? 'MAX' : s.label}
            </a>
          ))}
        </div>

        <p class="ct-email">
          Сметы, проекты и документы — <a href={`mailto:${email}`}>{email}</a>
        </p>
      </div>

      <figure class="ct-facade">
        <img
          src={FACADE_IMAGE.src}
          srcset={FACADE_IMAGE.srcset}
          sizes={FACADE_IMAGE.sizes}
          width={FACADE_IMAGE.width}
          height={FACADE_IMAGE.height}
          alt="Фасад салона ВФД на Братьев Кашириных, 131Б: вывеска «Двери прямо с фабрики» и лестница ко входу"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </div>

    <!-- ── Как добраться ── -->
    <div class="ct-block ct-visit">
      <div class="ct-visit__text">
        <h2 class="t-h2 m-0">Как добраться</h2>

        <p class="ct-address">{street}</p>
        <p class="ct-muted">Челябинск. {address.entrance}, парковка у здания.</p>

        <dl class="ct-hours">
          {hours.map((h) => (
            <div class="ct-hours__row">
              <dt>{h.day}</dt>
              <dd>{h.time}</dd>
            </div>
          ))}
        </dl>
        <p class="ct-muted">Без выходных.</p>

        <a href={ROUTE} target="_blank" rel="noopener noreferrer" class="btn btn-primary ct-btn ct-route">
          Построить маршрут
        </a>
      </div>

      <SalonMap
        client:visible
        variant="light"
        href={ROUTE}
        label="Открыть карту с расположением салона в Яндекс Картах (открывается в новой вкладке)"
        title="ВФД на Кашириных"
        subtitle={street}
        class="min-h-88 overflow-hidden rounded-2xl border border-slate-200 lg:min-h-120"
      />
    </div>

    <!-- ── Оплата и реквизиты ── -->
    <div class="ct-block">
      <h2 class="t-h2 m-0">Оплата и реквизиты</h2>

      <div class="ct-legal">
        <div>
          <h3 class="ct-subhead">Способы оплаты</h3>
          <ul class="ct-list" role="list">
            {paymentMethods.map((m) => (
              <li>
                <span class="ct-list__title">{m.title}</span>
                <span class="ct-list__text">{m.description}</span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="ct-subhead">Реквизиты</h3>
          <dl class="ct-req">
            <div class="ct-req__wide">
              <dt>Индивидуальный предприниматель</dt>
              <dd>{director.fullName}</dd>
            </div>
            <div>
              <dt>ИНН</dt>
              <dd class="tabular-nums">{req.inn}</dd>
            </div>
            <div>
              <dt>ОГРНИП</dt>
              <dd class="tabular-nums">{req.ogrnip}</dd>
            </div>
            <div>
              <dt>Дата регистрации</dt>
              <dd>{companyLegalInfo.activity.registered}</dd>
            </div>
            <div>
              <dt>Регистрирующий орган</dt>
              <dd>{companyLegalInfo.taxation.tax_office}</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
/* ── Первый экран: текст | фасад ── */
.ct-hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 2.5rem;
  align-items: center;
}
@media (min-width: 1024px) {
  .ct-hero {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }
}

.ct-lead {
  margin: 1.25rem 0 0;
  max-width: 34rem;
}

.ct-phones {
  display: flex;
  flex-wrap: wrap;
  gap: 1.25rem 2.5rem;
  margin: 2.25rem 0 0;
  padding: 0;
  list-style: none;
}
.ct-phones li {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}
.ct-phone {
  font-family: var(--font-display);
  font-size: var(--text-step-4);
  font-weight: 500;
  line-height: 1.1;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
  color: var(--color-ink);
  text-decoration: none;
  white-space: nowrap;
  transition: color 150ms var(--ease-out);
}
.ct-phone:hover { color: var(--color-accent-hover); }
.ct-phone__note {
  font-size: 0.875rem;
  color: var(--color-fg-muted);
}

.ct-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.625rem;
  margin-top: 2rem;
}
/* Где три кнопки не влезают в строку (телефон, узкая левая колонка на
   1024–1279) — Telegram во всю ширину, ВКонтакте и MAX пополам под ним */
.ct-actions > :first-child { grid-column: 1 / -1; }
@media (min-width: 480px) and (max-width: 1023px), (min-width: 1280px) {
  .ct-actions { display: flex; flex-wrap: wrap; }
}
.ct-btn {
  min-height: 3rem;
  padding-inline: 1.375rem;
  font-size: 0.9375rem;
}

.ct-email {
  margin: 1.5rem 0 0;
  font-size: 0.9375rem;
  color: var(--color-fg-muted);
}
.ct-email a {
  font-weight: 500;
  color: var(--color-ink);
  text-decoration: underline;
  text-decoration-color: var(--color-border);
  text-underline-offset: 0.3em;
  transition: color 150ms var(--ease-out), text-decoration-color 150ms var(--ease-out);
}
.ct-email a:hover {
  color: var(--color-accent-hover);
  text-decoration-color: currentColor;
}

.ct-facade {
  margin: 0;
}
.ct-facade img {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 3 / 2;
  object-fit: cover;
  border-radius: var(--radius-card);
  background: #e4e4e7;
}
/* ── Секции ниже — на линейке, без карточек ── */
.ct-block {
  margin-top: clamp(3.5rem, 7vw, 6rem);
  padding-top: clamp(2.5rem, 4vw, 3.5rem);
  border-top: 1px solid var(--color-border);
}

/* Как добраться: текст | карта */
.ct-visit {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 2rem;
}
@media (min-width: 1024px) {
  .ct-visit {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }
}

.ct-address {
  margin: 1.75rem 0 0;
  font-size: var(--text-step-4);
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: -0.02em;
  color: var(--color-ink);
}
.ct-muted {
  margin: 0.5rem 0 0;
  font-size: 0.9375rem;
  line-height: 1.5;
  color: var(--color-fg-muted);
}

.ct-hours {
  margin: 2rem 0 0;
  max-width: 22rem;
  border-top: 1px solid var(--color-border);
}
.ct-hours__row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.875rem 0;
  border-bottom: 1px solid var(--color-border);
}
.ct-hours__row dt {
  font-size: 0.9375rem;
  color: var(--color-fg-muted);
}
.ct-hours__row dd {
  margin: 0;
  font-family: var(--font-display);
  font-size: var(--text-step-3);
  font-weight: 500;
  letter-spacing: -0.01em;
  font-variant-numeric: tabular-nums;
  color: var(--color-ink);
}

.ct-route {
  margin-top: 2rem;
}

/* Оплата и реквизиты */
.ct-legal {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 2.5rem;
  margin-top: 2rem;
}
@media (min-width: 768px) {
  .ct-legal {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }
}
.ct-subhead {
  margin: 0 0 0.5rem;
  font-size: var(--text-step-2);
  font-weight: 600;
  color: var(--color-ink);
}
.ct-list {
  margin: 0;
  padding: 0;
  list-style: none;
}
.ct-list li {
  display: flex;
  flex-direction: column;
  gap: 0.125rem;
  padding: 0.875rem 0;
  border-bottom: 1px solid var(--color-border);
}
.ct-list__title {
  font-size: 0.9375rem;
  font-weight: 500;
  color: var(--color-ink);
}
.ct-list__text {
  font-size: 0.875rem;
  line-height: 1.5;
  color: var(--color-fg-muted);
}

.ct-req {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 0;
  margin: 0;
}
@media (min-width: 480px) {
  .ct-req { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1.5rem; }
  .ct-req__wide { grid-column: 1 / -1; }
}
.ct-req > div {
  padding: 0.875rem 0;
  border-bottom: 1px solid var(--color-border);
}
.ct-req dt {
  font-size: 0.8125rem;
  color: var(--color-fg-muted);
}
.ct-req dd {
  margin: 0.125rem 0 0;
  font-size: 0.9375rem;
  font-weight: 500;
  line-height: 1.45;
  color: var(--color-ink);
}
</style>
