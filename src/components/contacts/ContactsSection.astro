---
/**
 * Страница «Контакты»: шапка с быстрыми действиями, способы связи и часы,
 * карта, оплата и реквизиты, «что вы получаете».
 *
 * Статичный Astro: раньше это был Vue-остров целиком ради текста, который
 * не меняется, — гидрация без пользы. Интерактивна только карта (SalonMap,
 * client:visible: скрипт грузится, когда карта подъезжает к экрану).
 *
 * Все контакты — из contacts-data.ts (единый источник для футера, шапки,
 * /about/ и структурированных данных), а не хардкодом: раньше номера, часы и
 * реквизиты здесь были вписаны руками и успели разойтись с остальным сайтом.
 */
import { companyLegalInfo, getFormattedHours } from '../../lib/contacts-data'
import { SOCIAL_NETWORKS } from '../../lib/header-nav'
import { paymentMethods } from '../about/about-data'
import SalonMap from '../ui/SalonMap.vue'

const phones   = companyLegalInfo.contacts.phone
const email    = companyLegalInfo.contacts.email
const address  = companyLegalInfo.address
const director = companyLegalInfo.director
const req      = companyLegalInfo.requisites

const telegram = SOCIAL_NETWORKS.find((s) => s.name === 'Telegram')!
const messengers = SOCIAL_NETWORKS.filter((s) => s.name !== 'Telegram')
const ROUTE = address.routeUrl
/* Улица и дом без «г. Челябинск,» — вторая строка карточки на карте */
const street = address.legal.replace(/^г\.\s*[^,]+,\s*/, '')

/* Сб и Вс сейчас по одному графику — одна строка «Сб–Вс», без дубля времени. */
const [weekdays, saturday, sunday] = getFormattedHours()
const hours = saturday!.time === sunday!.time
  ? [weekdays!, { day: 'Сб–Вс', time: saturday!.time }]
  : [weekdays!, saturday!, sunday!]

/* «Что вы получаете»: заголовок, ключевые пункты одной строкой и пояснение.
   Гарантия на монтаж — 12 месяцев (contacts-data → additional). */
const benefits = [
  {
    title: 'Бесплатные консультации',
    facts: 'Подбор моделей · образцы покрытий · помощь дизайнера',
    text: 'Специалист салона поможет подобрать модель, покрытие и цвет под ваш интерьер и бюджет — вживую, с образцами материалов на руках. Консультация ни к чему не обязывает.',
  },
  {
    title: 'Бесплатный выезд на замер',
    facts: 'Челябинск и область · точные размеры · без обязательств',
    text: 'Мастер выезжает на объект, снимает точные размеры проёма и учитывает особенности стен — от этого зависят итоговая смета и корректность монтажа. Выезд бесплатный независимо от того, оформите вы заказ или нет.',
  },
  {
    title: 'Гарантия на монтаж и материалы',
    facts: '12 месяцев на работы · гарантия производителя',
    text: 'На монтажные работы даём гарантию 12 месяцев, на сами двери и перегородки — по условиям производителя. Если после установки что-то потребует внимания, обращайтесь напрямую в салон, без посредников.',
  },
]
---

<section class="section">
  <div class="container">

    <!-- ── Шапка + быстрые действия ── -->
    <header class="mb-10 max-w-3xl lg:mb-14">
      <h1 class="t-h1 mb-4">Контакты салона дверей ВФД в Челябинске</h1>
      <p class="m-0 mb-6 t-lead text-slate-600">
        Позвоните, напишите в мессенджер или приезжайте в салон — покажем двери и перегородки
        вживую и выедем на замер — по Челябинску бесплатно при оформлении заказа.
      </p>

      <div class="flex flex-wrap items-center gap-2.5">
        <a href={`tel:${phones[0]!.raw}`} class="btn btn-primary h-11 px-6 text-sm">Позвонить</a>
        <a href={telegram.url} target="_blank" rel="noopener noreferrer" class="btn btn-outline h-11 px-6 text-sm">Написать в Telegram</a>
        {messengers.map((s) => (
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline btn-icon size-11"
            aria-label={`Написать: ${s.label} (открывается в новой вкладке)`}
          >
            <img src={s.icon} alt="" width="28" height="28" class="size-7!" />
          </a>
        ))}
      </div>
    </header>

    <!-- ── Связь + карта ── -->
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-2 lg:gap-6">

      <!-- Левая колонка: как связаться и когда мы на месте -->
      <div class="flex flex-col gap-5 lg:gap-6">

        <!-- Одна карточка с рядами: телефоны и почта. Без значков в плашках —
             номер набран крупно, как цифры в остальных блоках сайта -->
        <ul class="m-0 list-none divide-y divide-slate-200 overflow-hidden rounded-2xl border border-slate-200 p-0">
          {phones.map((p) => (
            <li>
              <a
                href={`tel:${p.raw}`}
                class="group flex items-center justify-between gap-4 px-6 py-5 transition-colors hover:bg-slate-50"
              >
                <span class="min-w-0">
                  <span class="block font-(family-name:--font-display) text-step-4 font-medium leading-tight tracking-tight text-ink tabular-nums">{p.label}</span>
                  <span class="block text-sm text-slate-500">{p.title}</span>
                </span>
                <span class="shrink-0 text-sm font-semibold text-slate-500 transition-colors group-hover:text-ink">Позвонить</span>
              </a>
            </li>
          ))}
          <li>
            <a
              href={`mailto:${email}`}
              class="group flex items-center justify-between gap-4 px-6 py-5 transition-colors hover:bg-slate-50"
            >
              <span class="min-w-0">
                <span class="block truncate text-step-3 font-medium leading-tight text-ink">{email}</span>
                <span class="block text-sm text-slate-500">Для документов, смет и проектов</span>
              </span>
              <span class="shrink-0 text-sm font-semibold text-slate-500 transition-colors group-hover:text-ink">Написать</span>
            </a>
          </li>
        </ul>

        <!-- Часы работы -->
        <div class="flex flex-col justify-between gap-6 rounded-2xl bg-graphite p-6 text-white lg:flex-1">
          <p class="m-0 mb-4 text-sm text-white/70">Часы работы — без выходных</p>
          <div class="flex flex-col gap-3">
            {hours.map((h) => (
              <div class="flex items-baseline justify-between gap-3">
                <span class="text-step-1 text-white/70">{h.day}</span>
                <span class="font-(family-name:--font-display) text-step-4 font-medium tracking-tight tabular-nums">{h.time}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Правая колонка: адрес + карта -->
      <div class="flex flex-col overflow-hidden rounded-2xl border border-slate-200">
        <div class="p-6">
          <p class="m-0 mb-1 text-sm text-slate-500">Адрес салона</p>
          <p class="m-0 mb-1 text-step-3 font-medium leading-snug text-ink">{address.legal}</p>
          <p class="m-0 mb-5 text-sm text-slate-600">{address.entrance} · парковка у здания</p>
          <a href={ROUTE} target="_blank" rel="noopener noreferrer" class="btn btn-outline h-11 px-6 text-sm">Построить маршрут</a>
        </div>

        <SalonMap
          client:visible
          variant="light"
          href={ROUTE}
          label="Открыть карту с расположением салона в Яндекс Картах (открывается в новой вкладке)"
          title="ВФД на Кашириных"
          subtitle={street}
          class="min-h-80 flex-1"
        />
      </div>
    </div>

    <!-- ── Оплата + реквизиты ── -->
    <div class="mt-5 grid grid-cols-1 gap-5 lg:mt-6 lg:grid-cols-2 lg:gap-6">
      <div class="rounded-2xl border border-slate-200 p-6">
        <h2 class="m-0 mb-4 text-step-3 font-medium text-ink">Способы оплаты</h2>
        <ul class="m-0 flex list-none flex-col divide-y divide-slate-200 p-0">
          {paymentMethods.map((m) => (
            <li class="py-3 first:pt-0 last:pb-0">
              <span class="block text-step-1 font-medium text-ink">{m.title}</span>
              <span class="block text-sm text-slate-500">{m.description}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl border border-slate-200 p-6">
        <h2 class="m-0 mb-4 text-step-3 font-medium text-ink">Реквизиты</h2>
        <dl class="m-0 grid grid-cols-1 gap-x-6 gap-y-4 text-sm sm:grid-cols-2">
          <div class="sm:col-span-2">
            <dt class="text-slate-500">Индивидуальный предприниматель</dt>
            <dd class="m-0 font-medium text-ink">{director.fullName}</dd>
          </div>
          <div>
            <dt class="text-slate-500">ИНН</dt>
            <dd class="m-0 font-medium text-ink tabular-nums">{req.inn}</dd>
          </div>
          <div>
            <dt class="text-slate-500">ОГРНИП</dt>
            <dd class="m-0 font-medium text-ink tabular-nums">{req.ogrnip}</dd>
          </div>
          <div>
            <dt class="text-slate-500">Дата регистрации</dt>
            <dd class="m-0 font-medium text-ink">{companyLegalInfo.activity.registered}</dd>
          </div>
          <div>
            <dt class="text-slate-500">Регистрирующий орган</dt>
            <dd class="m-0 font-medium text-ink">{companyLegalInfo.taxation.tax_office}</dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- ── Что вы получаете: три колонки на линейке, без плиток и пилюль ── -->
    <div class="mt-14 border-t border-slate-200 pt-12 lg:mt-20 lg:pt-16">
      <h2 class="t-h2 mb-8 lg:mb-12">Что вы получаете</h2>
      <div class="grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-8 lg:gap-12">
        {benefits.map((b) => (
          <article class="border-t-2 border-ink pt-5">
            <h3 class="t-h3 m-0 mb-3 text-step-3">{b.title}</h3>
            <p class="m-0 mb-4 text-sm font-medium leading-snug text-teal-700">{b.facts}</p>
            <p class="m-0 text-step-1 leading-relaxed text-slate-600">{b.text}</p>
          </article>
        ))}
      </div>
    </div>

  </div>
</section>
