---
interface Props {
  title:     string
  /** HTML допускается (&nbsp;, <strong>) */
  subtitle?: string
  class?:    string
}
const { title, subtitle, class: cls = '' } = Astro.props
---
<header class:list={['mb-[clamp(2rem,4vw,3rem)]', cls]}>
  <h2 class="t-h2 mb-4">{title}</h2>
  {subtitle && (
    <p class="t-lead max-w-160" set:html={subtitle} />
  )}
</header>
