---
/**
 * Шаги процесса («Как мы работаем», «Как купить», «Как проходит
 * сотрудничество») — колонки на общей линейке, а не плитки: тонкая
 * линия сверху, короткий бирюзовый отрезок — начало шага, номер того же
 * цвета (нумерация — реальная последовательность). Ниже заголовок и абзац;
 * опционально — спек-лист (язык BenefitList, без иконок), цена/условие
 * крупно и ссылка-действие.
 *
 * Колонки: 1 на телефоне (номер — узкой колонкой слева), 2 от sm, от lg —
 * 4 (или 3, если шагов 3/6/9: без висящего хвоста во втором ряду). Внутри
 * шага — subgrid: заголовки, абзацы, списки и цены соседних колонок стоят
 * на одних линиях, как бы ни переносился текст.
 *
 * Анимация одна: когда список доходит до экрана, отрезки прорисовываются
 * по очереди слева направо, содержимое проявляется следом (только
 * transform/opacity — раскладка не пересчитывается, CLS нет). Без JS,
 * при prefers-reduced-motion и если список уже на экране — всё видно сразу.
 */
import type { Step } from '../../data/partitions'

interface Props {
  items: Step[]
  /** Светлый текст для тёмной подложки (графит). Фон задаёт родитель. */
  dark?: boolean
  /** id сноски о ценах — звёздочка у цены с `mark` ведёт на неё */
  noteId?: string
}
const { items, dark = false, noteId } = Astro.props
const cols = items.length % 4 !== 0 && items.length % 3 === 0 ? 3 : 4
/* В узкой колонке «500 ₽» рвалось на «500» и «₽» — склеиваем знак с числом */
const nbspRub = (t: string) => t.replace(/ ₽/g, ' ₽')
---

<ol
  class:list={['ps', { 'ps--dark': dark }]}
  style={`--ps-cols:${cols}`}
  role="list"
  data-ps
>
  {items.map((s, i) => (
    <li class="ps-step" style={`--i:${i}`}>
      <span class="ps-num" aria-hidden="true">{s.num}</span>
      <h3 class="ps-title">{s.title}</h3>
      <p class="ps-text">{s.text}</p>
      {s.details?.length ? (
        <ul class="ps-list" role="list">
          {s.details.map((d) => <li class="ps-item">{nbspRub(d)}</li>)}
        </ul>
      ) : <span class="ps-slot" aria-hidden="true" />}
      {s.price ? (
        <p class="ps-price">
          <span class="ps-value">
            {s.price.value}
            {s.price.mark && noteId && (
              <a href={`#${noteId}`} class="ps-mark" aria-label="Примечание о ценах">*</a>
            )}
          </span>
          <span class="ps-note">{nbspRub(s.price.note)}</span>
        </p>
      ) : <span class="ps-slot" aria-hidden="true" />}
      {s.cta && (
        <a
          href={s.cta.href}
          class="ps-cta"
          {...(s.cta.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {s.cta.label}
          <svg viewBox="0 0 16 16" fill="none" class="ps-cta-arrow" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      )}
    </li>
  ))}
</ol>

<style>
  .ps {
    /* Палитра — переменными, тёмный вариант переопределяет только их */
    --ps-rule:   #e2e8f0;  /* slate-200 */
    --ps-signal: #14b8a6;  /* teal-500 — отрезок */
    --ps-num:    #0f766e;  /* teal-700 — 13px на белом/slate-50 ≥ 4.5:1 */
    --ps-title:  var(--color-ink);
    --ps-text:   #475569;  /* slate-600 */
    --ps-item:   #1e293b;  /* slate-800 */
    --ps-note:   #64748b;  /* slate-500 */
    --ps-cta:    #0f766e;
    --ps-cta-hover: #115e59;

    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.25rem clamp(1.5rem, 3vw, 2.5rem);
  }
  .ps--dark {
    --ps-rule:   rgba(255, 255, 255, 0.14);
    --ps-signal: #2dd4bf;  /* teal-400 */
    --ps-num:    #2dd4bf;
    --ps-title:  #fff;
    --ps-text:   rgba(255, 255, 255, 0.66);
    --ps-item:   rgba(255, 255, 255, 0.8);
    --ps-note:   rgba(255, 255, 255, 0.55);
    --ps-cta:    #2dd4bf;
    --ps-cta-hover: #5eead4;
  }

  .ps-step {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ps-rule);
  }
  /* Отрезок поверх линейки — начало шага */
  .ps-step::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 2rem;
    height: 2px;
    background: var(--ps-signal);
    transform-origin: left;
  }

  .ps-num {
    font-size: var(--text-step-0);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--ps-num);
  }
  .ps-title {
    margin: 2rem 0 0;
    font-size: var(--text-step-3);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--ps-title);
    text-wrap: balance;
  }
  /* На главной заголовки шагов в одно-два слова — крупнее и с большим
     воздухом; на внутренних страницах они длинные («Проект и коммерческое
     предложение») и в 4 колонки ушли бы в три строки. */
  .ps--dark .ps-title {
    margin-top: 2.5rem;
    font-size: var(--text-step-4);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .ps-text {
    margin: 0.75rem 0 0;
    max-width: 26rem;
    font-size: var(--text-step-1);
    line-height: 1.6;
    color: var(--ps-text);
    text-wrap: pretty;
  }

  /* Пустая ячейка вместо отсутствующего списка/цены — держит строки
     subgrid одинаковыми у всех шагов (без неё элементы съехали бы
     в чужие строки). Высоты не имеет. */
  .ps-slot { display: none; }

  /* Спек-лист — тот же язык, что BenefitList: тонкие разделители и
     короткий штрих вместо иконки */
  .ps-list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    border-top: 1px solid var(--ps-rule);
  }
  .ps-item {
    display: flex;
    gap: 0.75rem;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--ps-rule);
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--ps-item);
  }
  .ps-item::before {
    content: '';
    flex-shrink: 0;
    width: 0.75rem;
    height: 1px;
    margin-top: 0.68em;
    background: var(--ps-signal);
  }

  /* Цена — внизу колонки: у соседних шагов цены стоят на одной линии */
  .ps-price {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: auto 0 0;
    padding-top: 1.75rem;
  }
  /* Manrope, как .t-price по сайту: в Rubik нет глифа ₽ — знак
     подставлялся из запасного шрифта и выбивался из цифр */
  .ps-value {
    font-size: clamp(1.625rem, 2.6vw, 2rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--ps-title);
    white-space: nowrap;
  }
  .ps-mark {
    margin-left: 0.125em;
    color: var(--ps-signal);
    text-decoration: none;
  }
  .ps-mark:focus-visible { outline: 2px solid var(--ps-signal); outline-offset: 2px; border-radius: 2px; }
  .ps-note {
    font-size: var(--text-step-0);
    line-height: 1.45;
    color: var(--ps-note);
  }

  .ps-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    width: fit-content;
    margin-top: 1.25rem;
    padding-block: 0.25rem;  /* зона нажатия ≥ 24px */
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ps-cta);
    text-decoration: none;
    transition: color 200ms var(--ease-out);
  }
  .ps-cta:hover { color: var(--ps-cta-hover); }
  .ps-cta:focus-visible { outline: 2px solid var(--ps-signal); outline-offset: 3px; border-radius: 2px; }
  .ps-cta-arrow {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
    transition: transform 200ms var(--ease-out);
  }
  .ps-cta:hover .ps-cta-arrow { transform: translateX(2px); }

  /* Телефон: номер — узкой колонкой слева на линии заголовка, всё
     остальное — одной колонкой справа; цена сразу под абзацем. */
  @media (width < 40rem) {
    .ps { gap: 2rem; }
    .ps-step {
      display: grid;
      grid-template-columns: 2.25rem minmax(0, 1fr);
      align-items: baseline;
      padding-top: 1rem;
    }
    .ps-num { grid-row: 1; }
    .ps-title, .ps-text, .ps-list, .ps-price, .ps-cta { grid-column: 2; }
    .ps-title { margin-top: 0; }
    .ps-text { margin-top: 0.5rem; }
    .ps-list { margin-top: 1rem; }
    .ps-price { padding-top: 1rem; gap: 0.25rem; }
    .ps-value { font-size: 1.5rem; }
    .ps-cta { margin-top: 0.75rem; }
  }

  /* От sm — колонки; subgrid выравнивает строки шагов между колонками
     (6 строк: номер, заголовок, абзац, список, цена, ссылка). Пустые
     строки схлопываются в 0 — отступы на элементах, не gap: row-gap
     родителя просачивается в каждую строку subgrid (row-gap: 0 у шага
     его не отменяет), поэтому ряды шагов разносит margin-bottom, а
     отрицательный margin у списка гасит его под последним рядом. */
  @media (width >= 40rem) {
    .ps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 0;
      margin-bottom: -3rem;
    }
    .ps-step { margin-bottom: 3rem; }
    @supports (grid-template-rows: subgrid) {
      .ps-step {
        display: grid;
        grid-row: span 6;
        grid-template-rows: subgrid;
        row-gap: 0;
        align-content: start;
      }
      .ps-num  { align-self: start; }
      .ps-slot { display: block; }
      .ps-list  { align-self: start; }
      .ps-price { align-self: start; margin-top: 0; }
      .ps-cta   { align-self: end; }
    }
  }
  @media (width >= 64rem) {
    .ps { grid-template-columns: repeat(var(--ps-cols), minmax(0, 1fr)); }
  }

  /* Наведение на шаг — отрезок дотягивается, единственный отклик колонки */
  @media (hover: hover) {
    .ps-step::before { transition: width 300ms var(--ease-out); }
    .ps-step:hover::before { width: 3.5rem; }
  }

  /* ── Появление ── */
  [data-ps='hidden'] .ps-step::before { transform: scaleX(0); }
  [data-ps='hidden'] .ps-step > * { opacity: 0; translate: 0 0.75rem; }
  [data-ps='shown'] .ps-step::before {
    transition: transform 600ms var(--ease-out) calc(var(--i) * 140ms), width 300ms var(--ease-out);
  }
  [data-ps='shown'] .ps-step > * {
    transition:
      opacity   600ms var(--ease-out) calc(var(--i) * 140ms + 150ms),
      translate 600ms var(--ease-out) calc(var(--i) * 140ms + 150ms),
      color     200ms var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .ps-step::before, .ps-step > *, .ps-cta, .ps-cta-arrow { transition: none !important; }
  }
</style>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches
  if (!still && 'IntersectionObserver' in window) {
    document.querySelectorAll<HTMLElement>('[data-ps]').forEach((list) => {
      // Уже на экране (якорь, возврат назад) — не прячем
      if (list.getBoundingClientRect().top < innerHeight) return
      list.dataset.ps = 'hidden'
      const io = new IntersectionObserver(([e]) => {
        if (!e?.isIntersecting) return
        list.dataset.ps = 'shown'
        io.disconnect()
      }, { rootMargin: '0px 0px -15% 0px' })
      io.observe(list)
    })
  }
</script>
