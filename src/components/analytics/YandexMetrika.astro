---
/**
 * Яндекс Метрика — загружается только в production.
 * Счётчик: 106993554
 *
 * Почему такая установка:
 * - is:inline — Astro/Vite не трогает и не бандлит скрипт
 * - import.meta.env.PROD — в dev счётчик молчит (статистика чистая, консоль не шумит)
 * - dataLayer инициализируется до ym() — ecommerce события не потеряются
 * - ssr:true убран — нужен только для Next.js/Nuxt SSR, не для Astro SSG
 * - referrer/url убраны из init — Метрика детектит их автоматически
 * - инициализация отложена до window 'load': вебвизор (webvisor: true) сканирует
 *   и трогает DOM сразу после старта, и если это происходит одновременно
 *   с гидратацией client:load Vue-островов (каталог, галереи), Vue видит DOM,
 *   отличающийся от отрендеренного на сервере → "Hydration completed but
 *   contains mismatches" в проде. К моменту window.load гидратация уже
 *   гарантированно завершена.
 *
 * Цели (JS-события): делегированный обработчик кликов по контактным ссылкам.
 * Он стоит на странице, а не в компонентах, поэтому ловит ссылки везде —
 * в Vue-островах (шапка, подвал, модалки), на статических страницах и в
 * статьях. Названия целей — идентификаторы JS-событий; в интерфейсе
 * Метрики (Цели → Добавить цель → «JavaScript-событие») их нужно завести
 * с теми же идентификаторами. Список — в CLAUDE.md, раздел «Analytics».
 * До загрузки tag.js (событие window.load) `ym` ещё не функция — клик
 * молча пропускается, на работу страницы это не влияет.
 */
const isProd = import.meta.env.PROD
---

{isProd && (
  <script is:inline>
    window.addEventListener('load', function () {
      window.dataLayer = window.dataLayer || [];

      (function(m,e,t,r,i,k,a){
        m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return;}}
        k=e.createElement(t);a=e.getElementsByTagName(t)[0];
        k.async=1;k.src=r;a.parentNode.insertBefore(k,a)
      })(window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');

      ym(106993554,'init',{
        clickmap:            true,
        trackLinks:          true,
        accurateTrackBounce: true,
        webvisor:            true,
        ecommerce:           'dataLayer',
      });
    });
  </script>
)}
{isProd && (
  <script is:inline>
    (function () {
      var COUNTER = 106993554;
      /* Первое совпадение выигрывает. Короткая ссылка yandex.ru/maps/-/… ведёт на
         карточку салона (маршрут), поиск yandex.ru/maps/?text=… и 2gis.ru — на
         страницы отзывов. */
      var GOALS = [
        ['phone_click',    /^tel:/i],
        ['email_click',    /^mailto:/i],
        ['telegram_click', /^https?:\/\/(t|telegram)\.me\//i],
        ['vk_click',       /^https?:\/\/(www\.)?vk\.com\//i],
        ['max_click',      /^https?:\/\/(www\.)?max\.ru\//i],
        ['whatsapp_click', /^https?:\/\/(wa\.me|api\.whatsapp\.com)\//i],
        ['route_click',    /^https?:\/\/yandex\.ru\/maps\/-\//i],
        ['review_platform_click', /^https?:\/\/(yandex\.ru\/maps\/\?|(go\.)?2gis\.(ru|com)\/)/i]
      ];
      document.addEventListener('click', function (e) {
        if (typeof window.ym !== 'function') return;
        var el = e.target && e.target.closest ? e.target.closest('a[href]') : null;
        if (!el) return;
        var href = el.getAttribute('href') || '';
        for (var i = 0; i < GOALS.length; i++) {
          if (GOALS[i][1].test(href)) {
            window.ym(COUNTER, 'reachGoal', GOALS[i][0], { page: location.pathname });
            return;
          }
        }
      }, true);
    })();
  </script>
)}
{isProd && (
  <noscript>
    <div>
      <img src="https://mc.yandex.ru/watch/106993554" style="position:absolute;left:-9999px;" alt="" />
    </div>
  </noscript>
)}
