---
/**
 * «Фотоотчёты с объектов» на главной — лента последних работ портфолио.
 *
 * Горизонтальная лента с прокруткой по карточкам (scroll-snap): крупное
 * фото, под ним название и место — категория и ЖК/посёлок (реальные
 * адреса — главное доверие к живым фото). На телефоне — свайп, следующая
 * карточка выглядывает из-за края; на десктопе — стрелки в шапке
 * и прокрутка тачпадом. Последняя карточка — графитовая «N фотоотчётов»
 * со ссылкой на всё портфолио. Лид собирается из данных: число работ
 * и дата последнего монтажа.
 *
 * Лента, стрелки и последняя карточка — общие с «Отзывами»: .rail
 * (global.css), RailControls, RailEndCard. Без JS лента листается сама.
 * Фото — превью 640/1080 (scripts/gen-portfolio-thumbs.mjs), lazy.
 */
import SectionHeader from '../home/SectionHeader.astro'
import RailControls from '../ui/RailControls.astro'
import RailEndCard from '../ui/RailEndCard.astro'
import { PORTFOLIO_WORKS, CATEGORY_LABELS } from '../../data/portfolio-works'
import { pluralRu } from '../../lib/product-text'
import { typograph } from '../../lib/typograph'

const RAIL_SIZE = 8

const byDate = [...PORTFOLIO_WORKS].sort((a, b) => b.date.localeCompare(a.date))
const preview = byDate.slice(0, RAIL_SIZE)
const total = PORTFOLIO_WORKS.length
const totalWord = pluralRu(total, ['фотоотчёт', 'фотоотчёта', 'фотоотчётов'])
const objectsWord = pluralRu(total, ['объект', 'объекта', 'объектов'])

const latest = byDate[0]
const latestLabel = latest
  ? new Date(latest.date).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', timeZone: 'UTC' })
  : null

/* Место одной короткой строкой: город/область и так понятны, из
   «ЖК НИКС Сити, Университетская набережная» — только ЖК */
const place = (location: string) =>
  location.replace(/^Челябинск(ая область)?,\s*/, '').split(',')[0]!.trim()

const lead = `${total} ${objectsWord} по Челябинску и области — живые фото с монтажей, не рендеры.`
  + (latestLabel ? ` Последний — ${latestLabel}.` : '')
---

{preview.length > 0 && (
  <section class="section bg-white rail-scope" aria-labelledby="portfolio-preview-heading" data-rail-scope>
    <div class="container">

      <SectionHeader id="portfolio-preview-heading" title="Фотоотчёты с объектов" lead={lead}>
        <Fragment slot="actions">
          <RailControls
            prevLabel="Предыдущие работы"
            nextLabel="Следующие работы"
            allHref="/portfolio/"
            allLabel="Все работы"
          />
        </Fragment>
      </SectionHeader>

      <ul class="rail pr-rail" role="list" data-rail aria-label="Последние работы">
        {preview.map((work) => (
          <li>
            <a href={`/portfolio/${work.id}/`} class="pr-card">
              <span class="pr-photo">
                <img
                  src={`/renders/portfolio/${work.id}-640.webp`}
                  srcset={`/renders/portfolio/${work.id}-640.webp 640w, /renders/portfolio/${work.id}.webp 1080w`}
                  sizes="(min-width: 64rem) 25vw, (min-width: 40rem) 42vw, 78vw"
                  alt={work.title}
                  width="640"
                  height="800"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="pr-title">{typograph(work.title)}</span>
              <span class="pr-meta">
                {CATEGORY_LABELS[work.category]}<span class="pr-dot" aria-hidden="true">·</span>{place(work.location)}
              </span>
            </a>
          </li>
        ))}

        <li>
          <RailEndCard
            value={total}
            text={`${totalWord} в портфолио — двери, перегородки, входные группы`}
            href="/portfolio/"
            cta="Смотреть все"
          />
        </li>
      </ul>

    </div>
  </section>
)}

<style>
  /* Колонки ленты .rail (global.css): на телефоне — карточка и край
     следующей, на десктопе — три с небольшим запасом */
  .pr-rail {
    --rail-col: 78%;
    --rail-col-md: 42%;
    --rail-col-lg: min(21.5rem, 26vw);
  }

  /* ── Карточка работы ── */
  .pr-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
  .pr-photo {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 1.25rem;
    background: #f4f4f5;  /* zinc-100 — место под кадр, пока он грузится */
  }
  @media (width >= 40rem) {
    .pr-photo { border-radius: 1.5rem; }
  }
  .pr-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }
  .pr-title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin-top: 1rem;
    font-size: var(--text-step-2);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    transition: color var(--duration-base) var(--ease-out);
  }
  .pr-meta {
    overflow: hidden;
    margin-top: 0.375rem;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: var(--text-step-1);
    color: #71717a;  /* zinc-500 */
  }
  .pr-dot { margin: 0 0.4em; color: #a1a1aa; }

  .pr-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 1.5rem;
  }

  @media (hover: hover) {
    .pr-card:hover .pr-photo img { transform: scale(1.03); }
    .pr-card:hover .pr-title { color: #0f766e; }  /* teal-700 */
  }
  @media (prefers-reduced-motion: reduce) {
    .pr-photo img, .pr-title { transition: none; }
    .pr-card:hover .pr-photo img { transform: none; }
  }
</style>
