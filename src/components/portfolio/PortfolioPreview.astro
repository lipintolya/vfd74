---
import { PORTFOLIO_WORKS, CATEGORY_LABELS, CATEGORY_BADGE_COLORS } from '../../data/portfolio-works'

const preview = [...PORTFOLIO_WORKS]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 4)

const total = PORTFOLIO_WORKS.length
const totalWord = total === 1 ? 'фотоотчёт' : total < 5 ? 'фотоотчёта' : 'фотоотчётов'
---

{preview.length > 0 && (
  <section class="section" aria-labelledby="portfolio-preview-heading">
    <div class="container">

      <header class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8 md:mb-10">
        <div>
          <p class="t-eyebrow mb-2">
            Наши работы
          </p>
          <h2 id="portfolio-preview-heading" class="text-3xl font-medium leading-tight tracking-tight text-slate-900 md:text-4xl">
            Фотоотчёты с объектов
          </h2>
          <p class="mt-2 text-base text-slate-600">
            Реальные объекты наших клиентов — по Челябинску и области · {total} {totalWord} в портфолио
          </p>
        </div>
        <a
          href="/portfolio/"
          class="flex-none inline-flex items-center gap-2 rounded-full border-[1.5px] border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-900 hover:border-teal-500 hover:bg-teal-500 hover:text-white transition-colors duration-200"
        >
          Все работы
          <svg viewBox="0 0 16 16" fill="none" class="w-3.5 h-3.5" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </header>

      <!-- Архивная лента — фото без затемнения, подпись под кадром (как в
           печатном портфолио), портретный кадр 3:4: ряд дверных полотен, а
           не постеры с текстом поверх снимка. -->
      <ul class="pp-strip" role="list">
        {preview.map((work, i) => (
          <li>
            <a href={`/portfolio/${work.id}/`} class="pp-card group">
              <span class="pp-card__frame">
                <img
                  src={`/renders/portfolio/${work.id}.webp`}
                  alt={work.title}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="pp-card__img"
                />
              </span>
              <span class="pp-card__caption">
                <span class="pp-card__title">{work.title}</span>
                <span class="pp-card__meta">
                  <span class="pp-card__cat">
                    <span class={`pp-dot ${CATEGORY_BADGE_COLORS[work.category]}`} aria-hidden="true" />
                    {CATEGORY_LABELS[work.category]}
                  </span>
                  <span class="pp-card__date">{work.label}</span>
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>

    </div>
  </section>
)}

<style>
  .pp-strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem 1.25rem;
    padding: 0;
    list-style: none;
    margin: 0;
  }
  @media (min-width: 640px) { .pp-strip { grid-template-columns: repeat(4, 1fr); } }

  .pp-card { display: block; min-width: 0; text-decoration: none; }

  .pp-card__frame {
    display: block;
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 0.5rem;
    background: #f1f0ec;
  }
  .pp-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pp-card:hover .pp-card__img { transform: scale(1.045); }

  .pp-card__caption { display: block; padding-top: 0.75rem; }
  .pp-card__title {
    display: block;
    overflow-wrap: break-word;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-ink);
    transition: color 150ms ease;
  }
  .pp-card:hover .pp-card__title { color: var(--color-accent-hover); }

  .pp-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.375rem;
  }
  .pp-card__cat {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-fg-subtle);
  }
  .pp-dot { flex-shrink: 0; width: 0.4375rem; height: 0.4375rem; border-radius: 9999px; }
  .pp-card__date {
    flex-shrink: 0;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-fg-subtle);
  }
</style>
