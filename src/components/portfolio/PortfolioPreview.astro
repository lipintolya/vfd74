---
/**
 * «Готовые объекты» на главной — три последние работы портфолио.
 *
 * Редакционная композиция: слева заголовок, лид и кнопка-уход в портфолио,
 * справа — три вертикальных кадра, которые занимают всю высоту блока.
 * Подписи лежат на самом кадре, на затемнении (тот же язык, что у
 * фото-плиток каталога: фото на всю площадь, белый текст на скриме, вся
 * плитка — одна ссылка). Так блок читается как подборка работ, а не как
 * список карточек с текстом рядом.
 *
 * Раскладка: на телефоне — шапка, кадры стопкой и только потом кнопка в
 * портфолио; с 80rem шапка и кнопка встают узкой колонкой слева, кадры —
 * справа во всю высоту колонки. Канонический title остаётся в данных,
 * H1 проекта и alt изображения; в подписи идёт короткий previewTitle.
 */
import Action from '../ui/Action.astro'
import { PORTFOLIO_WORKS, CATEGORY_LABELS } from '../../data/portfolio-works'
import { pluralRu } from '../../lib/product-text'
import { typograph } from '../../lib/typograph'

const SHOWN = 3

const preview = [...PORTFOLIO_WORKS]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, SHOWN)
const total = PORTFOLIO_WORKS.length
const totalWord = pluralRu(total, ['объект', 'объекта', 'объектов'])

/* Лид — одна мысль: кадры сделаны после установки, а не взяты из каталога.
   «Монтаж» в тексте блока не повторяем: выше уже сказано, что объекты
   готовые, и слово «объекты» второй раз подряд в заголовке и лиде не нужно. */
const lead = 'Двери и перегородки после установки — в квартирах и домах Челябинска и области.'

/* 'Челябинск, ЖК «Ньютон»' → 'ЖК «Ньютон»': в подписи на кадре город уже
   подразумевается, а строка должна оставаться короткой. Регистр первой
   буквы — потому что подпись стоит отдельной строкой, а не внутри фразы. */
const place = (location: string) => {
  const short = location
    .replace(/^Челябинск(ая область)?,\s*/, '')
    .split(',')[0]!
    .replace(/\s*\([^)]*\)/, '')
    .trim()
  return short.charAt(0).toUpperCase() + short.slice(1)
}

/* Ресайзы 640/1080 — те же, что у сетки портфолио на /portfolio/ */
const cover = (id: string) => ({
  src: `/renders/portfolio/${id}-640.webp`,
  srcset: `/renders/portfolio/${id}-640.webp 640w, /renders/portfolio/${id}.webp 1080w`,
})
---

{preview.length > 0 && (
  <section
    class="section pp-band pt-[clamp(2.5rem,4vw,3.5rem)]!"
    aria-labelledby="portfolio-preview-heading"
  >
    <div class="container pp">

      <header class="pp-intro">
        <h2 id="portfolio-preview-heading" class="t-h2 pp-title">Готовые объекты</h2>
        <p class="t-lead pp-lead">{typograph(lead)}</p>
      </header>

      <ul class="pp-grid" role="list" aria-label="Последние работы">
        {preview.map((work) => (
          <li class="pp-item">
            <a href={`/portfolio/${work.id}/`} class="pp-card" aria-label={work.title}>
              <img
                class="pp-img"
                {...cover(work.id)}
                sizes="(min-width: 80rem) 24vw, (min-width: 48rem) 30vw, 82vw"
                alt={work.title}
                width="640"
                height="800"
                loading="lazy"
                decoding="async"
              />
              <div class="pp-body">
                <div class="pp-text">
                  <h3 class="t-h3 pp-name">
                    {typograph(work.previewTitle ?? work.model ?? work.title)}
                  </h3>
                  <span class="pp-meta">
                    {CATEGORY_LABELS[work.category]}{'\u00a0'}
                    <span class="pp-dot" aria-hidden="true">·</span>{' '}
                    <span class="pp-place">{place(work.location)}</span>
                  </span>
                </div>
                <span class="pp-badge" aria-hidden="true">
                  <svg viewBox="0 0 16 16" fill="none">
                    <path
                      d="M3 8h10M9 4l4 4-4 4"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>

      {/* На мобильном карточки уже являются крупными ссылками. Переход ко
          всему портфолио оставляем спокойным текстовым действием, чтобы не
          повторять ещё одну акцентную кнопку сразу после ленты. */}
      <div class="pp-cta">
        <p class="pp-count">
          <strong>{total}</strong> {totalWord} в&nbsp;портфолио
        </p>
        <Action href="/portfolio/" variant="text">Смотреть все работы</Action>
      </div>

    </div>
  </section>
)}

<style>
  /* Белый фон совпадает с основной поверхностью сайта. */
  .pp-band {
    background: var(--color-surface);
  }

  .pp {
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.5rem);
  }
  .pp-intro {
    display: grid;
    align-content: start;
    gap: 0.875rem;
  }
  .pp-title {
    margin: 0;
    text-wrap: balance;
  }
  .pp-lead {
    max-width: 32rem;
    margin: 0;
    color: #475569; /* slate-600 — как у лида в SectionHeader */
    text-wrap: pretty;
  }

  /* ── Лента кадров ─────────────────────────────────────────────── */
  .pp-grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(82vw, 20rem);
    gap: 0.875rem;
    margin: 0 calc(-1 * clamp(1rem, 4vw, 2rem));
    padding: 0 clamp(1rem, 4vw, 2rem) 0.25rem;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: clamp(1rem, 4vw, 2rem);
    scrollbar-width: none;
  }
  .pp-grid::-webkit-scrollbar { display: none; }
  .pp-item {
    min-width: 0;
    scroll-snap-align: start;
  }
  @media (width >= 40rem) {
    .pp-grid {
      gap: 1rem;
    }
  }
  @media (width >= 48rem) {
    .pp-grid {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1rem, 1.6vw, 1.5rem);
      margin: 0;
      padding: 0;
      overflow: visible;
      scroll-snap-type: none;
    }
  }

  /* Кадр: фото на всю площадь, подписи снизу на затемнении.
     Вся плитка — одна ссылка, поэтому внутри нет отдельного таб-стопа. */
  .pp-card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 1.25rem;
    background: #27272a; /* zinc-800 — пока грузится фото */
    color: #fff;
    text-decoration: none;
  }
  @media (width >= 40rem) {
    .pp-card {
      border-radius: 1.5rem;
    }
  }

  /* Скрим плотнее, чем у плиток каталога: кадры портфолио в основном
     светлые (белые двери, светлые интерьеры), и белая подпись на мягком
     затемнении терялась бы на самом светлом участке фото. */
  .pp-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.88) 0%,
      rgb(0 0 0 / 0.64) 32%,
      rgb(0 0 0 / 0.18) 62%,
      rgb(0 0 0 / 0) 82%
    );
  }
  .pp-img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }

  .pp-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 0.75rem;
    padding: clamp(1rem, 1.5vw, 1.375rem);
  }
  .pp-text {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
  }
  .pp-name {
    margin: 0;
    color: #fff;
    text-wrap: balance;
  }
  /* Категория и адрес — одной строкой, как в списке работ: на кадре
     подпись держим короткой, иначе она съедает половину фотографии. */
  .pp-meta {
    display: block;
    font-size: var(--text-step-0);
    line-height: 1.35;
    color: rgb(255 255 255 / 0.78);
    text-wrap: pretty;
  }
  /* Точка между категорией и адресом — тише текста: она разделяет, а не
     читается как смысл. Неразрывный пробел перед ней не даёт ей начать
     строку, а обычный после — даёт переносить адрес на новую строку. */
  .pp-dot {
    color: rgb(255 255 255 / 0.5);
  }
  /* Адрес — неделимая единица в пределах строки: либо целиком на строке
     с категорией, либо целиком на следующей. Иначе на узких кадрах
     получается «ЖК» в конце строки и ««Ньютон»» в начале следующей. */
  .pp-place {
    display: inline-block;
    max-width: 100%;
  }
  /* Кружок со стрелкой — часть ссылки, а не отдельная кнопка:
     на касании он не нужен отдельно, на десктопе подсказывает переход.
     Диаметр тот же, что у круглой зоны стрелки в кнопках (.btn-arrow-icon). */
  .pp-badge {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.94);
    color: var(--color-ink);
    transition: background-color var(--duration-base) var(--ease-out);
  }
  .pp-badge svg {
    width: 1rem;
    height: 1rem;
    transition: transform var(--duration-base) var(--ease-out);
  }

  /* Планшет: три кадра в ряд получаются узкими (~225px), и в подписи не
     хватает места и заголовку, и адресу. Заголовок ставим ступенью ниже,
     отступы плотнее, а декоративный кружок убираем: вся плитка остаётся
     одной ссылкой, и его ширина уходит тексту. */
  @media (48rem <= width < 64rem) {
    .pp-name {
      font-size: var(--text-step-3);
    }
    .pp-body {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
      padding: 1rem;
    }
    .pp-badge {
      display: none;
    }
  }

  /* ── Уход в портфолио ─────────────────────────────────────────── */
  .pp-cta {
    display: grid;
    justify-items: start;
    gap: 0.25rem;
  }
  .pp-count {
    margin: 0;
    font-size: var(--text-step-0);
    line-height: 1.4;
    color: #475569; /* slate-600: на тёплой полосе даёт 6.9:1, а slate-500 — 4.3:1 (мало для 13px) */
  }
  .pp-count strong {
    font-weight: 600;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  /* ── Десктоп: шапка и ссылка — узкая колонка слева, кадры — справа
     во всю высоту колонки (ссылка встаёт по нижнему краю кадров) ── */
  @media (width >= 80rem) {
    .pp {
      grid-template-columns: minmax(0, 16rem) minmax(0, 1fr);
      grid-template-rows: 1fr auto;
      grid-template-areas:
        'intro cards'
        'cta cards';
      column-gap: clamp(2rem, 3vw, 3.5rem);
      row-gap: 1.5rem;
    }
    .pp-intro {
      grid-area: intro;
    }
    .pp-grid {
      grid-area: cards;
    }
    .pp-cta {
      grid-area: cta;
    }
  }

  .pp-card:focus-visible {
    outline: 2px solid var(--color-accent-hover);
    outline-offset: 3px;
  }
  @media (hover: hover) {
    .pp-card:hover .pp-img {
      transform: scale(1.03);
    }
    .pp-card:hover .pp-badge {
      background: #fff;
    }
    .pp-card:hover .pp-badge svg {
      transform: translateX(2px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pp-img,
    .pp-badge,
    .pp-badge svg {
      transition: none;
    }
    .pp-card:hover .pp-img {
      transform: none;
    }
    .pp-card:hover .pp-badge svg {
      transform: none;
    }
  }
</style>
