---
/**
 * «Фотоотчёты с объектов» на главной — последние работы портфолио.
 *
 * Композиция отличается от соседних «Отзывов» и «Акций» (там шапка сверху
 * и ряд одинаковых карточек): на широком десктопе (от 80rem) слева колонка
 * с заголовком, лидом, кнопкой и крупным числом работ, справа — три фото.
 * Число внизу колонки вровень с подписями — вместо графитовой полосы под
 * рядом, которая повторяла «Отзывы». Остальные работы — по кнопке
 * «Все работы». От 64rem до 80rem колонка отняла бы у фото слишком много
 * места — там шапка сверху и три фото в ряд.
 *
 * На телефоне и планшете — как у остальных лент: шапка сверху, лента из
 * шести работ со свайпом (следующая карточка выглядывает из-за края),
 * стрелки для мыши и последняя графитовая карточка «N фотоотчётов».
 *
 * Под фото — название и место: категория и ЖК/посёлок (реальные адреса —
 * главное доверие к живым фото). Лента, стрелки и последняя карточка —
 * общие с «Отзывами»: .rail (global.css), RailControls, RailEndCard. Без JS
 * лента листается сама. Фото — превью 640/1080
 * (scripts/gen-portfolio-thumbs.mjs), lazy.
 */
import RailControls from '../ui/RailControls.astro'
import RailEndCard from '../ui/RailEndCard.astro'
import { PORTFOLIO_WORKS, CATEGORY_LABELS } from '../../data/portfolio-works'
import { pluralRu } from '../../lib/product-text'
import { typograph } from '../../lib/typograph'

const RAIL_SIZE = 6
/* Сколько работ в ряду на десктопе (остальные скрыты, см. .pr-off) */
const DESKTOP_SIZE = 3

const byDate = [...PORTFOLIO_WORKS].sort((a, b) => b.date.localeCompare(a.date))
const preview = byDate.slice(0, RAIL_SIZE)
const total = PORTFOLIO_WORKS.length
const totalWord = pluralRu(total, ['фотоотчёт', 'фотоотчёта', 'фотоотчётов'])
const objectsWord = pluralRu(total, ['объект', 'объекта', 'объектов'])

/* Место одной короткой строкой: город/область и так понятны, из
   «ЖК НИКС Сити, Университетская набережная» — только ЖК, из
   «посёлок Развязка (Чурилово)» — без уточнения в скобках */
const place = (location: string) =>
  location.replace(/^Челябинск(ая область)?,\s*/, '').split(',')[0]!.replace(/\s*\([^)]*\)/, '').trim()

const lead = 'Живые фото с монтажей по Челябинску и области, не рендеры.'
---

{preview.length > 0 && (
  <section class="section bg-white rail-scope" aria-labelledby="portfolio-preview-heading" data-rail-scope>
    <div class="container pp">

      <header class="pp-head">
        <h2 id="portfolio-preview-heading" class="t-h2 pp-title">Фотоотчёты с объектов</h2>
        <p class="t-lead pp-lead">{typograph(lead)}</p>
        <div class="pp-actions">
          <RailControls
            prevLabel="Предыдущие работы"
            nextLabel="Следующие работы"
            allHref="/portfolio/"
            allLabel="Все работы"
          />
        </div>
        <p class="pp-count">
          <span class="pp-num">{total}</span>
          <span class="pp-count-text">{objectsWord} в портфолио: двери, перегородки, входные группы</span>
        </p>
      </header>

      <ul class="rail pr-rail" role="list" data-rail aria-label="Последние работы">
        {preview.map((work, i) => (
          <li class:list={{ 'pr-off': i >= DESKTOP_SIZE }}>
            <a href={`/portfolio/${work.id}/`} class="pr-card">
              <span class="pr-photo">
                <img
                  src={`/renders/portfolio/${work.id}-640.webp`}
                  srcset={`/renders/portfolio/${work.id}-640.webp 640w, /renders/portfolio/${work.id}.webp 1080w`}
                  sizes="(min-width: 80rem) 22vw, (min-width: 64rem) 30vw, (min-width: 40rem) 42vw, 78vw"
                  alt={work.title}
                  width="640"
                  height="800"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="pr-title">{typograph(work.title)}</span>
              <span class="pr-meta">
                {CATEGORY_LABELS[work.category]}<span class="pr-dot" aria-hidden="true">·</span>{place(work.location)}
              </span>
            </a>
          </li>
        ))}

        <li class="rail-end pr-end">
          <RailEndCard
            value={total}
            text={`${totalWord} в портфолио — двери, перегородки, входные группы`}
            href="/portfolio/"
            cta="Смотреть все"
            fit="row"
          />
        </li>
      </ul>

    </div>
  </section>
)}

<style>
  /* ── Шапка ──
     Телефон/планшет: заголовок, лид, действия столбиком над лентой.
     Стили без слоя перебивают .t-h2/.t-lead из @layer components. */
  .pp-head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .pp-title { margin: 0; text-wrap: balance; }
  .pp-lead {
    margin: 0;
    max-width: 30rem;
    color: #475569;  /* slate-600, как в SectionHeader */
    text-wrap: pretty;
  }
  .pp-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .pp-count { display: none; }
  @media (width >= 48rem) {
    .pp-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 2rem;
      align-items: end;
    }
    .pp-lead { grid-column: 1; }
    .pp-actions { grid-column: 2; grid-row: 1 / span 2; }
  }

  /* ── От 64rem лента — сетка из трёх работ без плашки «N фотоотчётов»
     (остальные работы — по кнопке «Все работы» в шапке) ── */
  @media (width >= 64rem) {
    .pr-end, .pr-off { display: none; }
  }

  /* ── Широкий десктоп: слева колонка с текстом, справа три фото.
     Уже 80rem колонка отнимает у фото слишком много места (заголовки
     обрезаются), там шапка остаётся сверху. ── */
  @media (width >= 80rem) {
    .pp {
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      column-gap: clamp(2rem, 4vw, 3.5rem);
    }
    .pp-head {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      margin-bottom: 0;
    }
    .pp-actions { margin-top: 0.5rem; }
    /* Число вровень с низом подписей: ряд фото задаёт высоту колонки */
    .pp-count {
      display: block;
      margin: auto 0 0;
      padding-top: 2rem;
    }
    .pp-num {
      display: block;
      font-family: var(--font-display);
      font-size: clamp(3.5rem, 7vw, 5rem);
      font-weight: 500;
      line-height: 1;
      letter-spacing: -0.04em;
      font-variant-numeric: tabular-nums;
      color: var(--color-ink);
    }
    .pp-count-text {
      display: block;
      max-width: 15rem;
      margin-top: 0.5rem;
      font-size: var(--text-step-1);
      line-height: 1.45;
      color: #64748b;  /* slate-500 */
    }
  }

  /* Колонки ленты .rail (global.css): на телефоне — карточка и край
     следующей, на десктопе — три в ряд */
  .pr-rail {
    --rail-col: 78%;
    --rail-col-md: 42%;
    --rail-cols-lg: 3;
    align-self: start;
  }

  /* ── Карточка работы ── */
  .pr-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
  .pr-photo {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 1.25rem;
    background: #f4f4f5;  /* zinc-100 — место под кадр, пока он грузится */
  }
  @media (width >= 40rem) {
    .pr-photo { border-radius: 1.5rem; }
  }
  .pr-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }
  .pr-title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin-top: 1rem;
    font-size: var(--text-step-2);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    transition: color var(--duration-base) var(--ease-out);
  }
  @media (width >= 64rem) {
    .pr-title { -webkit-line-clamp: 3; }
  }
  .pr-meta {
    overflow: hidden;
    margin-top: auto;
    padding-top: 0.375rem;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: var(--text-step-1);
    color: #71717a;  /* zinc-500 */
  }
  .pr-dot { margin: 0 0.4em; color: #a1a1aa; }

  .pr-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 1.5rem;
  }

  @media (hover: hover) {
    .pr-card:hover .pr-photo img { transform: scale(1.03); }
    .pr-card:hover .pr-title { color: #0f766e; }  /* teal-700 */
  }
  @media (prefers-reduced-motion: reduce) {
    .pr-photo img, .pr-title { transition: none; }
    .pr-card:hover .pr-photo img { transform: none; }
  }
</style>
