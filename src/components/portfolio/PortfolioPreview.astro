---
/**
 * «Готовые объекты» на главной — три последние работы портфолио.
 *
 * Это статичная редакционная композиция, а не карусель: ведущий проект
 * получает крупный кадр, ещё два поддерживают его компактными строками.
 * На телефоне все три проекта видны без скрытого горизонтального скролла.
 * Канонический title остаётся в данных, H1 проекта и alt изображения;
 * в превью используются короткие previewTitle / previewDetail.
 */
import Action from '../ui/Action.astro'
import { PORTFOLIO_WORKS, CATEGORY_LABELS } from '../../data/portfolio-works'
import { pluralRu } from '../../lib/product-text'
import { typograph } from '../../lib/typograph'

const SHOWN = 3

const preview = [...PORTFOLIO_WORKS]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, SHOWN)
const total = PORTFOLIO_WORKS.length
const totalWord = pluralRu(total, ['объект', 'объекта', 'объектов'])

const place = (location: string) =>
  location.replace(/^Челябинск(ая область)?,\s*/, '').split(',')[0]!.replace(/\s*\([^)]*\)/, '').trim()

const lead = 'Двери и перегородки после монтажа — реальные объекты Челябинска и области.'
---

{preview.length > 0 && (
  <section class="section bg-white" aria-labelledby="portfolio-preview-heading">
    <div class="container pp">

      <header class="pp-head">
        <div class="pp-heading">
          <h2 id="portfolio-preview-heading" class="t-h2 pp-title">Готовые объекты</h2>
          <p class="t-lead pp-lead">{typograph(lead)}</p>
        </div>
        <div class="pp-summary">
          <p class="pp-count" aria-label={`${total} ${totalWord} в портфолио`}>
            <strong>{total}</strong>
            <span>{totalWord}<br />в портфолио</span>
          </p>
          <Action href="/portfolio/" variant="outline" class="pp-action">Все работы</Action>
        </div>
      </header>

      <ul class="pr-grid" role="list" aria-label="Последние работы">
        {preview.map((work, i) => (
          <li class:list={['pr-item', { 'pr-item--feature': i === 0 }]}>
            <a href={`/portfolio/${work.id}/`} class="pr-card" aria-label={work.title}>
              <span class="pr-photo">
                <img
                  src={`/renders/portfolio/${work.id}-640.webp`}
                  srcset={`/renders/portfolio/${work.id}-640.webp 640w, /renders/portfolio/${work.id}.webp 1080w`}
                  sizes={i === 0
                    ? '(min-width: 64rem) 54vw, 100vw'
                    : '(min-width: 40rem) 18vw, 34vw'}
                  alt={work.title}
                  width="640"
                  height="800"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <div class="pr-copy">
                <span class="pr-meta">
                  {CATEGORY_LABELS[work.category]}<span aria-hidden="true">·</span>{place(work.location)}
                </span>
                <h3 class="t-h3 pr-title">{typograph(work.previewTitle ?? work.model ?? work.title)}</h3>
                {(work.previewDetail ?? work.coating ?? work.features?.[0]) && (
                  <p class="pr-detail">{typograph(work.previewDetail ?? work.coating ?? work.features![0]!)}</p>
                )}
                <span class="pr-open" aria-hidden="true">
                  Смотреть проект
                  <svg viewBox="0 0 16 16" fill="none">
                    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>

    </div>
  </section>
)}

<style>
  .pp-head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .pp-heading { display: grid; gap: 0.75rem; }
  .pp-title { margin: 0; text-wrap: balance; }
  .pp-lead {
    max-width: 34rem;
    margin: 0;
    color: #475569;
    text-wrap: pretty;
  }
  .pp-summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
  }
  .pp-count {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    margin: 0;
    color: #64748b;
    font-size: var(--text-step-0);
    line-height: 1.25;
  }
  .pp-count strong {
    font-family: var(--font-display);
    font-size: var(--text-step-5);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  @media (width >= 48rem) {
    .pp-head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 2rem;
    }
    .pp-summary { gap: 1.5rem; }
  }

  .pr-grid {
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pr-card {
    display: grid;
    grid-template-columns: 7.25rem minmax(0, 1fr);
    gap: 1rem;
    min-height: 9rem;
    color: inherit;
    text-decoration: none;
  }
  .pr-item--feature .pr-card {
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }
  .pr-photo {
    display: block;
    overflow: hidden;
    min-width: 0;
    height: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 1.25rem;
    background: #f4f4f5;
  }
  .pr-item--feature .pr-photo { aspect-ratio: 4 / 5; }
  .pr-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }
  .pr-copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding-block: 0.125rem;
  }
  .pr-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.4em;
    font-size: var(--text-step-0);
    line-height: 1.4;
    color: #71717a;
  }
  .pr-title {
    display: block;
    margin-top: 0.5rem;
    color: var(--color-ink);
    text-wrap: balance;
    transition: color var(--duration-base) var(--ease-out);
  }
  .pr-detail {
    display: block;
    margin-top: 0.375rem;
    font-size: var(--text-step-1);
    line-height: 1.45;
    color: #475569;
    text-wrap: pretty;
  }
  .pr-open {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    margin-top: auto;
    padding-top: 0.625rem;
    font-size: var(--text-step-0);
    font-weight: 600;
    color: var(--color-ink);
  }
  .pr-open svg {
    width: 1rem;
    height: 1rem;
    flex: none;
    transition: transform var(--duration-base) var(--ease-out);
  }
  .pr-item--feature .pr-open { margin-top: 0.75rem; }

  @media (width >= 40rem) {
    .pr-photo { border-radius: 1.5rem; }
  }
  @media (width >= 64rem) {
    .pr-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      grid-template-rows: repeat(2, minmax(0, 1fr));
      gap: 1.5rem clamp(1.5rem, 3vw, 3rem);
    }
    .pr-item--feature { grid-row: 1 / 3; }
    .pr-item--feature .pr-card { height: 100%; }
    .pr-item--feature .pr-photo { min-height: 34rem; }
    .pr-item:not(.pr-item--feature) .pr-card {
      grid-template-columns: minmax(8.5rem, 42%) minmax(0, 1fr);
      height: 100%;
    }
    .pr-item:not(.pr-item--feature) .pr-photo {
      aspect-ratio: auto;
      min-height: 0;
    }
  }
  @media (width >= 80rem) {
    .pr-grid { gap: 2rem clamp(2.5rem, 4vw, 4.5rem); }
    .pr-item--feature .pr-photo { min-height: 40rem; }
  }

  .pr-card:focus-visible {
    outline: 2px solid var(--color-accent-hover);
    outline-offset: 5px;
    border-radius: 1.5rem;
  }
  @media (hover: hover) {
    .pr-card:hover .pr-photo img { transform: scale(1.025); }
    .pr-card:hover .pr-open svg { transform: translateX(3px); }
    .pr-card:hover .pr-title { color: var(--color-fg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pr-photo img, .pr-title, .pr-open svg { transition: none; }
    .pr-card:hover .pr-photo img { transform: none; }
  }
</style>
